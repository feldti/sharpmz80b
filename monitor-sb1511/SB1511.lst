0F8B  5E                      LD      E,(HL)
0F8C  23                      INC     HL
0F8D  56                      LD      D,(HL)
0F8E  EB                      EX      DE,HL
0F8F  CD D0 01                CALL    .HL
0F92  C3 D2 0E                JP      KEY_RET1E
0F95  D6 52           KEY_RS: SUB     52h
0F97  87                      ADD     A,A
0F98  C6 05                   ADD     A,05h
0F9A  CB 50                   BIT     2,B
