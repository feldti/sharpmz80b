08F1  D1                      POP     DE
08F2  B7                      OR      A
08F3  ED 52                   SBC     HL,DE
08F5  C9                      RET
                      ; <- aufgerufen von 0669h, 08D4h
                      MAGA_NEXT:
08F6  2A D1 10                LD      HL,(DSPXY)
08F9  5C                      LD      E,H
08FA  1C                      INC     E
                      ;  MAGA – MANG[E]: Fortsetzungsnummer von Zeile E (0 = Anfang einer
                      ;  logischen Zeile), Z wenn 0. MAGA_NEXT: für die Zeile unter dem Cursor.
                      ; <- aufgerufen von 083Eh, 08B0h, 08C6h
08FB  16 00           MAGA:   LD      D,00h
08FD  21 D3 10                LD      HL,MANG
0900  19                      ADD     HL,DE
0901  7E                      LD      A,(HL)
0902  B7                      OR      A
0903  C9                      RET
                      ;  ?PONT / XY2VRAM – VRAM-Adresse der Position HL (L = Spalte, H = Zeile):
                      ;  XY_BASE + (H + 1) * Breite + L; XY_BASE = D000h - Breite (CHR40/CHR80).
                      ; <- aufgerufen von 0659h, 0758h, 0843h, 08EAh, 0CDFh, 0D1Ah, 0D71h
0904  2A D1 10        ?PONT:  LD      HL,(DSPXY)
                      ; <- aufgerufen von 06D5h, 06E0h
                      XY2VRAM:
0907  C5                      PUSH    BC
0908  D5                      PUSH    DE
0909  44                      LD      B,H
090A  4D                      LD      C,L
090B  04                      INC     B
090C  ED 5B A2 07             LD      DE,(CH4080)
                      XY_BASE:
0910  21 D8 CF                LD      HL,0CFD8h
0913  19              XY_LP:  ADD     HL,DE
0914  10 FD                   DJNZ    XY_LP
0916  09                      ADD     HL,BC
0917  D1                      POP     DE
0918  C1                      POP     BC
0919  C9                      RET
                      
                      ; ------------------------------------------------------------------------------
                      ;  DSPRED/DSPW – VRAM lesen/schreiben; CHR80/CHR40 – Zeichenbreite
                      ; ------------------------------------------------------------------------------
                      ;  DSPRED / DSPW / VRAM_LDIR / VRAM_CLR – Text-VRAM über PIO Port A Bit 7
                      ;  einblenden, lesen/schreiben/kopieren/mit Leerzeichen füllen, ausblenden.
                      ;  DSPW_SPC schreibt ein Leerzeichen.
                      ; <- aufgerufen von 0D1Dh
091A  EF              DSPRED: RST     28h
091B  C5                      PUSH    BC
091C  0E E8                   LD      C,0E8h
091E  ED 40                   IN      B,(C)
0920  CB F8                   SET     7,B
0922  ED 41                   OUT     (C),B
0924  7E                      LD      A,(HL)
                      VRAM_OFF:
0925  CB B8                   RES     7,B
0927  ED 41                   OUT     (C),B
0929  C1                      POP     BC
092A  C9                      RET
                      ; <- aufgerufen von 0847h, 085Bh
                      DSPW_SPC:
092B  3E 20                   LD      A,20h                   ; ' '
                      ; <- aufgerufen von 065Ch, 0CE4h
092D  EF              DSPW:   RST     28h
092E  C5                      PUSH    BC
092F  0E E8                   LD      C,0E8h
0931  ED 40                   IN      B,(C)
0933  CB F8                   SET     7,B
0935  ED 41                   OUT     (C),B
0937  77                      LD      (HL),A
0938  18 EB                   JR      VRAM_OFF
                      ; <- aufgerufen von 07A5h, 0857h, 0CA0h
                      VRAM_LDIR:
093A  DB E8                   IN      A,(PIO_AD)
093C  CB FF                   SET     7,A
                      ; <- aufgerufen von 0C9Bh
                      VRAM_LDIRA:
093E  EF                      RST     28h
093F  D3 E8                   OUT     (PIO_AD),A
0941  ED B0                   LDIR
                      VRAM_OFFA:
0943  E6 3F                   AND     3Fh
0945  D3 E8                   OUT     (PIO_AD),A
0947  C9                      RET
                      ; <- aufgerufen von 07ADh, 0983h
                      VRAM_CLR:
0948  EF                      RST     28h
0949  DB E8                   IN      A,(PIO_AD)
094B  CB FF                   SET     7,A
094D  D3 E8                   OUT     (PIO_AD),A
                      VRAM_CLR_LP:
094F  36 20                   LD      (HL),20h
0951  23                      INC     HL
0952  10 FB                   DJNZ    VRAM_CLR_LP
0954  DB E8                   IN      A,(PIO_AD)
0956  18 EB                   JR      VRAM_OFFA
                      ;  CHR80 / CHR40 – 80 bzw. 40 Zeichen: setzt LLINE_MAX (1/3), CMDD_PERLINE
                      ;  (16/8), den Befehl bei CHR_MODE (SET/RES 5,A für PIO Port A Bit 5),
                      ;  CH3979/CH4080 (letzte Spalte/Breite) und XY_BASE; löscht den VRAM
                      ;  (8 x 256 Bytes), SCRSET, Cursor Home.
0958  EF              CHR80:  RST     28h
0959  3E 01                   LD      A,01h
095B  32 72 06                LD      (LLINE_MAX+1),A
095E  3E 10                   LD      A,10h
