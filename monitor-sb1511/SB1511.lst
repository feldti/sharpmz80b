                      ;  KEY_GRFLAG: Bit 6 = letzte Taste mit Grafik-Umschaltung (für GETL).
                      KEY_GRFLAG:
0FA7  00                      DEFB    00h                     ; ?? |.|
                      ;  CTL_09..CTL_0F – Modi in MODE setzen (Bit 5 klein, 6 Grafik, 7 invers)
                      ;  und MODE nach PPI Port A (SETMODE).
0FA8  21 D0 10        CTL_0F: LD      HL,MODE
0FAB  CB BE                   RES     7,(HL)
                      SETMODE:
