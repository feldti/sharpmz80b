0A0A  DB E6                   IN      A,(PIT_C2)
0A0C  4F                      LD      C,A
0A0D  DB E6                   IN      A,(PIT_C2)
0A0F  47                      LD      B,A
0A10  ED 43 2E 0A             LD      (TIM_LAST+1),BC
0A14  C1                      POP     BC
0A15  C9                      RET
0A16  EF              TIMRD:  RST     28h
0A17  C5                      PUSH    BC
0A18  E5                      PUSH    HL
0A19  3E 84                   LD      A,84h
0A1B  D3 E7                   OUT     (PIT_CTL),A
0A1D  3E 44                   LD      A,44h                   ; 'D'
0A1F  D3 E7                   OUT     (PIT_CTL),A
0A21  DB E6                   IN      A,(PIT_C2)
0A23  4F                      LD      C,A
0A24  DB E6                   IN      A,(PIT_C2)
0A26  47                      LD      B,A
0A27  DB E5                   IN      A,(PIT_C1)
0A29  5F                      LD      E,A
0A2A  DB E5                   IN      A,(PIT_C1)
0A2C  57                      LD      D,A
                      TIM_LAST:
0A2D  21 00 00                LD      HL,0000h
0A30  AF                      XOR     A
