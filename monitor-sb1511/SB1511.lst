0AD1  3E 02                   LD      A,02h
0AD3  32 04 0B                LD      (OCTAVE+1),A
0AD6  D8                      RET     C
0AD7  18 D0                   JR      MELDY_LP
                      MELDY_DOWN:
0AD9  3E 03                   LD      A,03h
                      MELDY_OCT:
