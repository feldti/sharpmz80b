09F1  3E C0                   LD      A,0C0h
09F3  B9                      CP      C
09F4  20 EE                   JR      NZ,TIMST_SYNC
09F6  3E C0                   LD      A,0C0h
09F8  D3 E5                   OUT     (PIT_C1),A
09FA  3E A8                   LD      A,0A8h
09FC  D3 E5                   OUT     (PIT_C1),A
09FE  3E 12                   LD      A,12h
0A00  D3 E4                   OUT     (PIT_C0),A
0A02  3E 7A                   LD      A,7Ah                   ; 'z'
0A04  D3 E4                   OUT     (PIT_C0),A
0A06  3E 84                   LD      A,84h
