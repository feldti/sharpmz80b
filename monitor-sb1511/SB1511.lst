                      ;  löschen, 13h alle löschen, 14h CHR40, 15h CHANGE; die übrigen nichts.
                      ;  TAB_FIND: Z, wenn Spalte A in TABDAT steht (HL zeigt darauf).
0D95  58 09           TENTBL: DEFW    CHR80
0D97  56 07                   DEFW    NOP_RET
0D99  56 07                   DEFW    NOP_RET
0D9B  56 07                   DEFW    NOP_RET
0D9D  56 07                   DEFW    NOP_RET
0D9F  56 07                   DEFW    NOP_RET
