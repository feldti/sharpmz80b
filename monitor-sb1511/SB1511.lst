                      ;  setzt den Operanden von TONE_LP für Pausen auf 04h (stumm).
                      ; <- aufgerufen von 0C33h
0A80  E7              BELL:   RST     20h
0A81  01 30 00                LD      BC,0030h
0A84  21 60 00                LD      HL,0060h
                      ; <- aufgerufen von 0BD9h
