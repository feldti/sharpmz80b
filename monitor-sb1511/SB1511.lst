                      ; <- aufgerufen von 0084h
098F  3E 03           CHR40:  LD      A,03h
0991  32 72 06                LD      (LLINE_MAX+1),A
0994  3E 08                   LD      A,08h
0996  32 2A 01                LD      (CMDD_PERLINE+1),A
0999  3E AF                   LD      A,0AFh
099B  32 7A 09                LD      (CHR_MODE+1),A
099E  3E 27                   LD      A,27h                   ; "'"
09A0  21 D8 CF                LD      HL,0CFD8h
09A3  18 C8                   JR      CHR_COMMON
                      
                      ; ------------------------------------------------------------------------------
                      ;  Registeranzeige (RST 08h-38h, NMI) – danach zurück nach ST
                      ; ------------------------------------------------------------------------------
                      ;  REGDUMP – Ziel von RST 08h-38h und NMI: Rücksprungadresse - 1 (= Adresse
                      ;  des RST-Befehls), AF, BC, DE, HL, diese Adresse und SP hexadezimal
                      ;  ausgeben, dann ST.
                      REGDUMP:
09A5  E3                      EX      (SP),HL
09A6  2B                      DEC     HL
09A7  E3                      EX      (SP),HL
