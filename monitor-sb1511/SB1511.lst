                      ;  erhöht, damit die Dauer nicht von der Tonhöhe abhängt.
                      NOTE_TAB:
0B43  43 25 01 44 ..          DEFB    43h,25h,01h,44h,05h,01h,45h,0E9h
0B4B  00 46 DC 00 ..          DEFB    00h,46h,0DCh,00h,47h,0C3h,00h,41h
