0F3F  CB 6E                   BIT     5,(HL)
0F41  28 02                   JR      Z,KEY_SHIFTCHK
0F43  CB C8                   SET     1,B
                      KEY_SHIFTCHK:
0F45  CB 48                   BIT     1,B
0F47  28 02                   JR      Z,KEY_SYMCHK
0F49  CB D0                   SET     2,B
                      KEY_SYMCHK:
0F4B  FE 40                   CP      40h                     ; '@'
0F4D  30 07                   JR      NC,KEY_SHIFTED
