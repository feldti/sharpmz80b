09B2  10 FA                   DJNZ    REGDUMP_LP
09B4  21 00 00                LD      HL,0000h
09B7  39                      ADD     HL,SP
09B8  CD 68 05                CALL    PRTHL
09BB  C3 B1 00                JP      ST
                      
                      ; ------------------------------------------------------------------------------
                      ;  XTEMP, TIMST/TIMRD (Uhr), BELL, MELDY/RYTHM (MUSIC)
                      ; ------------------------------------------------------------------------------
                      ;  XTEMP – Tempo n (1-7) setzen: TEMPO = 8 - n.
09BE  F5              XTEMP:  PUSH    AF
09BF  E6 0F                   AND     0Fh
09C1  ED 44                   NEG
