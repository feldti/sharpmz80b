0E1F  F5              KINT:   PUSH    AF
                      KINT_SET:
0E20  3A FD 10                LD      A,(KINTF)
0E23  B7                      OR      A
0E24  28 0F                   JR      Z,POP_AF_RET
0E26  DB E8                   IN      A,(PIO_AD)
0E28  E6 E0                   AND     0E0h
0E2A  F6 12                   OR      12h
0E2C  D3 E8                   OUT     (PIO_AD),A
0E2E  3E 97                   LD      A,97h
0E30  D3 EB                   OUT     (PIO_BC),A
0E32  AF                      XOR     A
0E33  D3 EB                   OUT     (PIO_BC),A
                      POP_AF_RET:
0E35  F1                      POP     AF
0E36  C9                      RET
                      ; <- aufgerufen von 0611h, 0C04h, 0D7Fh
0E37  21 FD 10        PUSHKI: LD      HL,KINTF
0E3A  7E                      LD      A,(HL)
0E3B  B7                      OR      A
0E3C  C8                      RET     Z
0E3D  36 00                   LD      (HL),00h
0E3F  3E 03                   LD      A,03h
0E41  D3 EB                   OUT     (PIO_BC),A
0E43  E1                      POP     HL
0E44  CD D0 01                CALL    .HL
0E47  F5              KINTON: PUSH    AF
0E48  3E FF                   LD      A,0FFh
0E4A  32 FD 10                LD      (KINTF),A
0E4D  18 D1                   JR      KINT_SET
