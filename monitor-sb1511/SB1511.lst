                      DEL_SHIFT:
084C  2A D1 10                LD      HL,(DSPXY)
084F  E5                      PUSH    HL
0850  CD E8 08                CALL    LLINE_LEN
0853  D5                      PUSH    DE
0854  E3                      EX      (SP),HL
0855  C1                      POP     BC
0856  1B                      DEC     DE
0857  CD 3A 09                CALL    VRAM_LDIR
085A  2B                      DEC     HL
