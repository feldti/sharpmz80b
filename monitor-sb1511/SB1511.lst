0BFD  D9                      EXX
0BFE  F1                      POP     AF
0BFF  C9                      RET
                      ; <- aufgerufen von 0BFAh
                      GETL_MAIN:
0C00  E7                      RST     20h
0C01  D9                      EXX
0C02  D5                      PUSH    DE
0C03  D9                      EXX
0C04  CD 37 0E                CALL    PUSHKI
0C07  CD 1A 0D                CALL    CSR_SAVE
                      GETL_FLUSH:
