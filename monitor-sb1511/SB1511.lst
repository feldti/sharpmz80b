                      ;  CTL_INST (08h) – Einfügemodus ein: Blinktakt 10h statt 40h im Operanden
                      ;  von CSR_BLINKCNT, den ?DSP abfragt. INS_OFF schaltet ihn aus. Anders als
                      ;  beim SB-1510 fügt 08h also kein Leerzeichen ein, sondern schaltet um.
                      CTL_INST:
0864  3E 10                   LD      A,10h
0866  21                      DEFB    21h                     ; Trick: Opcode 21h verschluckt den folgenden Befehl
                      ; <- aufgerufen von 068Fh, 071Eh, 0768h
                      INS_OFF:
0867  3E 40                   LD      A,40h                   ; '@'
0869  32 5E 0D                LD      (CSR_BLINKCNT+1),A
086C  C9                      RET
                      ;  INS_CHAR – Zeichen an der Cursorposition einfügen und den Rest der
                      ;  logischen Zeile verschieben; fällt hinten ein Zeichen heraus, wird eine
                      ;  neue Fortsetzungszeile angelegt (höchstens LLINE_MAX).
                      ; <- aufgerufen von 07CAh
                      INS_CHAR:
086D  EF                      RST     28h
086E  47                      LD      B,A
086F  2A D1 10                LD      HL,(DSPXY)
0872  E5                      PUSH    HL
0873  CD E8 08                CALL    LLINE_LEN
0876  4D                      LD      C,L
0877  EB                      EX      DE,HL
0878  78                      LD      A,B
0879  41                      LD      B,C
087A  0E E8                   LD      C,0E8h
087C  ED 50                   IN      D,(C)
087E  CB FA                   SET     7,D
0880  ED 51                   OUT     (C),D
                      INS_SHIFT:
0882  5E                      LD      E,(HL)
0883  77                      LD      (HL),A
0884  7B                      LD      A,E
0885  23                      INC     HL
0886  10 FA                   DJNZ    INS_SHIFT
0888  CB BA                   RES     7,D
088A  ED 51                   OUT     (C),D
088C  FE 20                   CP      20h                     ; ' '
088E  28 88                   JR      Z,CSR_RESTORE
0890  4F                      LD      C,A
0891  3A D2 10                LD      A,(DSPXY1)
0894  3D                      DEC     A
0895  5F                      LD      E,A
0896  CD 20 06                CALL    ROWCHK
0899  DA 18 08                JP      C,CSR_RESTORE
089C  C2 AC 08                JP      NZ,INS_NEWROW
089F  CD 7D 07                CALL    SCROLL_UP
08A2  1D                      DEC     E
08A3  E1                      POP     HL
08A4  25                      DEC     H
08A5  E5                      PUSH    HL
08A6  24                      INC     H
08A7  2E 00                   LD      L,00h
08A9  22 D1 10                LD      (DSPXY),HL
                      INS_NEWROW:
08AC  3A 72 06                LD      A,(LLINE_MAX+1)
08AF  47                      LD      B,A
08B0  CD FB 08                CALL    MAGA
08B3  B8                      CP      B
08B4  D2 18 08                JP      NC,CSR_RESTORE
08B7  23                      INC     HL
08B8  3C                      INC     A
08B9  77                      LD      (HL),A
08BA  79                      LD      A,C
08BB  CD 42 06                CALL    DSP_CHAR
08BE  C3 15 08                JP      CLRLINE_GO
                      ;  ??TOL – Cursor an den Anfang der logischen Zeile. ??EOL – hinter ihr
                      ;  Ende (C Bit 0: dabei die Fortsetzungsmerker löschen). LLINE_LEN: Länge
                      ;  von der Cursorposition bis zum Ende der logischen Zeile (HL), DE =
                      ;  VRAM-Adresse des Cursors.
                      ; <- aufgerufen von 075Ch, 0C7Eh
08C1  2A D1 10        ??TOL:  LD      HL,(DSPXY)
08C4  E5                      PUSH    HL
08C5  5C                      LD      E,H
08C6  CD FB 08                CALL    MAGA
08C9  E1                      POP     HL
08CA  ED 44                   NEG
08CC  84                      ADD     A,H
08CD  67                      LD      H,A
08CE  AF                      XOR     A
08CF  6F                      LD      L,A
08D0  18 0F                   JR      EOL_SETCSR
                      ; <- aufgerufen von 0765h
08D2  0E 00           ??EOL:  LD      C,00h
                      ; <- aufgerufen von 08EEh
08D4  CD F6 08        EOL_LP: CALL    MAGA_NEXT
08D7  53                      LD      D,E
08D8  EB                      EX      DE,HL
08D9  6F                      LD      L,A
08DA  AF                      XOR     A
08DB  CB 41                   BIT     0,C
08DD  28 01                   JR      Z,EOL_STORE
08DF  12                      LD      (DE),A
                      EOL_STORE:
08E0  B5                      OR      L
                      EOL_SETCSR:
08E1  22 D1 10                LD      (DSPXY),HL
08E4  20 EE                   JR      NZ,EOL_LP
08E6  18 1C                   JR      ?PONT
                      ; <- aufgerufen von 0850h, 0873h, 0C81h
                      LLINE_LEN:
08E8  0E 00                   LD      C,00h
                      ; <- aufgerufen von 0822h
                      LLINE_LENC:
