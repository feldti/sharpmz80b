0EB8  FE 06                   CP      06h
0EBA  28 1F                   JR      Z,KEY_RET0A
0EBC  FE 08                   CP      08h
0EBE  28 1E                   JR      Z,KEY_M08
0EC0  FE 0C                   CP      0Ch
0EC2  20 0E                   JR      NZ,KEY_RET1E
0EC4  3E 0C                   LD      A,0Ch
0EC6  C9                      RET
                      KEY_M01:
0EC7  CB 76                   BIT     6,(HL)
0EC9  28 07                   JR      Z,KEY_RET1E
                      KEY_RET0E:
0ECB  3E 0E                   LD      A,0Eh
0ECD  C9                      RET
                      KEY_M02:
0ECE  CB 6E                   BIT     5,(HL)
0ED0  20 F9                   JR      NZ,KEY_RET0E
                      KEY_RET1E:
0ED2  3E 1E                   LD      A,1Eh
0ED4  C9                      RET
                      KEY_RET7F:
0ED5  3E 7F                   LD      A,7Fh
0ED7  C9                      RET
                      KEY_RET09:
0ED8  3E 09                   LD      A,09h
0EDA  C9                      RET
                      KEY_RET0A:
0EDB  3E 0A                   LD      A,0Ah
0EDD  C9                      RET
                      KEY_M08:
0EDE  CB 7E                   BIT     7,(HL)
0EE0  28 F0                   JR      Z,KEY_RET1E
0EE2  3E 0F                   LD      A,0Fh
0EE4  C9                      RET
                      KEY_PRESSED:
0EE5  CD F4 0E                CALL    KEY_CODE
0EE8  CB 58                   BIT     3,B
0EEA  C8                      RET     Z
0EEB  FE 7F                   CP      7Fh
0EED  D0                      RET     NC
0EEE  FE 20                   CP      20h                     ; ' '
0EF0  D8                      RET     C
