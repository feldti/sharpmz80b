0963  3E EF                   LD      A,0EFh
0965  32 7A 09                LD      (CHR_MODE+1),A
0968  3E 4F                   LD      A,4Fh                   ; 'O'
096A  21 B0 CF                LD      HL,0CFB0h
                      CHR_COMMON:
096D  32 31 06                LD      (CH3979),A
0970  3C                      INC     A
0971  32 A2 07                LD      (CH4080),A
0974  22 11 09                LD      (XY_BASE+1),HL
0977  DB E8                   IN      A,(PIO_AD)
                      CHR_MODE:
0979  CB EF                   SET     5,A
097B  D3 E8                   OUT     (PIO_AD),A
097D  21 00 D0                LD      HL,0D000h
0980  01 08 00                LD      BC,0008h
                      CHR_CLR:
