0E6A  D3 E8                   OUT     (PIO_AD),A
0E6C  DB EA                   IN      A,(PIO_BD)
0E6E  DB EA                   IN      A,(PIO_BD)
0E70  C9                      RET
                      ;  KEYSCAN – Tastaturmatrix abfragen: Zeile 0Bh (Sondertasten) nach B,
                      ;  Zeilen 0Ah-00h prüfen, nur neu gedrückte Tasten zählen (KSTD = letzter
                      ;  Stand je Zeile, KYBDA = Sondertasten). Nur Sondertasten geändert: je
                      ;  nach Kombination und MODE 0Ch, 0Eh, 7Fh, 09h, 0Ah oder 0Fh, sonst 1Eh.
                      ;  Mit Taste: Index Zeile * 8 + Spalte (KEY_CODE); B wird ergänzt aus MODE
                      ;  (Bit 7 -> B3 invers, Bit 6 -> B0 Grafik, Bit 5 -> B1 klein, B1 -> B2).
                      ;  Umsetzung über KEYTAB (normal), KEYTAB+1Eh (B2) bzw. KEYTAB+3Ch (Grafik,
                      ;  Index unter 40h); Buchstaben werden bei KEY_CASE1/2 berechnet. Index
                      ;  0Ah-17h mit B2: TENTBL; 18h: 1Bh/1Fh; 52h/53h: 05h/06h bzw. 07h/08h.
                      ;  Mit B3 bekommen Zeichen 20h-7Eh Bit 7 (invers).
                      ; <- aufgerufen von 0614h, 0D82h
                      KEYSCAN:
0E71  EF                      RST     28h
0E72  21 00 00                LD      HL,0000h
0E75  22 13 00                LD      (KEYPOS),HL
0E78  21 FC 10                LD      HL,KSTD_LAST
0E7B  16 1B                   LD      D,1Bh
0E7D  CD 65 0E                CALL    KEY_ROW
0E80  2F                      CPL
0E81  47                      LD      B,A
                      KEY_ROWLP:
0E82  15                      DEC     D
0E83  CD 65 0E                CALL    KEY_ROW
0E86  5F                      LD      E,A
0E87  2F                      CPL
0E88  A6                      AND     (HL)
0E89  73              ..KEY:  LD      (HL),E
0E8A  2B                      DEC     HL
0E8B  5F                      LD      E,A
0E8C  B7                      OR      A
0E8D  28 04                   JR      Z,KEY_ROWNEXT
0E8F  ED 53 13 00             LD      (KEYPOS),DE
                      KEY_ROWNEXT:
0E93  7A                      LD      A,D
0E94  E6 0F                   AND     0Fh
0E96  20 EA                   JR      NZ,KEY_ROWLP
0E98  ED 5B 13 00             LD      DE,(KEYPOS)
0E9C  7B                      LD      A,E
0E9D  B7                      OR      A
0E9E  20 45                   JR      NZ,KEY_PRESSED
0EA0  78                      LD      A,B
0EA1  BE                      CP      (HL)
0EA2  28 2E                   JR      Z,KEY_RET1E
0EA4  77                      LD      (HL),A
0EA5  21 D0 10                LD      HL,MODE
0EA8  FE 01                   CP      01h
0EAA  28 1B                   JR      Z,KEY_M01
0EAC  FE 02                   CP      02h
0EAE  28 1E                   JR      Z,KEY_M02
