                      ; ------------------------------------------------------------------------------
                      ;  DI_ – Interrupts sperren und Restroutine aufrufen (Ziel von RST 28h)
                      ; ------------------------------------------------------------------------------
0E0E  F5              DI_:    PUSH    AF
0E0F  ED 57                   LD      A,I                     ; IFF2 -> Paritätsflag (PE = Interrupts waren frei)
0E11  F3                      DI
0E12  E2 35 0E                JP      PO,POP_AF_RET
0E15  F1                      POP     AF
0E16  E3                      EX      (SP),HL
0E17  22 1C 0E                LD      (DI_CALL+1),HL            ; Rücksprungadresse = Fortsetzung der Routine
0E1A  E1                      POP     HL
                      DI_CALL:
0E1B  CD 00 00                CALL    RESET                   ; Rest der aufrufenden Routine ausführen
0E1E  FB                      EI                              ; danach Interrupts wieder frei
                      
                      ; ------------------------------------------------------------------------------
                      ;  KINT/PUSHKI/KINTON – Tastatur-Interrupt über PIO Port B
                      ;  KINTF <> 0: Interrupt bei Tastendruck freigeschaltet (vermutlich als
                      ;  Abbruchmöglichkeit; der Interrupt landet über IM 1 bei 0038h).
