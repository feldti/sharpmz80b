0F6B  C9                      RET
                      KEY_SHIFT:
0F6C  21 F5 0F                LD      HL,KEYTAB+1Eh
0F6F  FE 21                   CP      21h                     ; '!'
0F71  38 F6                   JR      C,KEY_LOOKUP
                      KEY_CASE2:
0F73  C6 40                   ADD     A,40h
0F75  FE 7B                   CP      7Bh                     ; '{'
0F77  D8                      RET     C
0F78  D6 5A                   SUB     5Ah
0F7A  5F                      LD      E,A
0F7B  18 EC                   JR      KEY_LOOKUP
                      KEY_CTRL:
0F7D  CB 50                   BIT     2,B
0F7F  28 D9                   JR      Z,KEY_NORMAL
0F81  D6 0A                   SUB     0Ah
0F83  87                      ADD     A,A
0F84  21 95 0D                LD      HL,TENTBL
0F87  5F                      LD      E,A
0F88  16 00                   LD      D,00h
