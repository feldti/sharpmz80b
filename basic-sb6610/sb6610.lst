58F0  CD 83 1A                CALL    GETSTR
58F3  F1                      POP     AF
58F4  E5                      PUSH    HL
58F5  21 BA 58                LD      HL,PAT_NEXT
58F8  E5                      PUSH    HL
58F9  21 0D 60                LD      HL,INBUF
58FC  E5                      PUSH    HL
