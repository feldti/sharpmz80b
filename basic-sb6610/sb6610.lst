589F  52              D589F:  DEFB    52h                     ; Inline-Parameter 'R'
58A0  AF 58           D58A0:  DEFW    CONS_NORM
58A2  3A 50 11                LD      A,(PPI_A_COPY)
58A5  CB A7                   RES     4,A
                      CONS_SETPPI:
