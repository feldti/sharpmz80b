1591  D1                      POP     DE
1592  3E 81                   LD      A,81h
                      ; <- aufgerufen von 157Bh
                      CR_PUT2:
1594  12                      LD      (DE),A
1595  13                      INC     DE
                      CR_PUT1:
1596  78                      LD      A,B
1597  12                      LD      (DE),A
