02B2  F3              RDDATA: DI
02B3  16 08                   LD      D,08h
02B5  ED 4B D2 10             LD      BC,(CMT_HSIZE)
02B9  2A D4 10                LD      HL,(CMT_HLOAD)
02BC  18 D9                   JR      CMT_READ
                      ; <- aufgerufen von 0220h, 4BE7h
02BE  F3              VFDATA: DI
02BF  16 08                   LD      D,08h
02C1  ED 4B D2 10             LD      BC,(CMT_HSIZE)
02C5  2A D4 10                LD      HL,(CMT_HLOAD)
02C8  CD 23 04                CALL    CKSUM
02CB  CD 57 04                CALL    CMT_READY
