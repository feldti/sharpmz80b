2CF7  44                      LD      B,H
2CF8  4D                      LD      C,L
2CF9  22 6B 2D                LD      (DEFKEY_REST),HL
2CFC  E1                      POP     HL
2CFD  EB                      EX      DE,HL
2CFE  ED B0                   LDIR
2D00  EB                      EX      DE,HL
2D01  22 70 11                LD      (FKEY_END),HL
2D04  E3                      EX      (SP),HL
2D05  CD 6D 2D                CALL    DEFKEY_SYNCHK
2D08  29              D2D08:  DEFB    29h                     ; Inline-Parameter ')'
2D09  CD 6D 2D                CALL    DEFKEY_SYNCHK
2D0C  3D              D2D0C:  DEFB    3Dh                     ; Inline-Parameter '='
2D0D  E5                      PUSH    HL
2D0E  CD 7A 2D                CALL    DEFKEY_EOL
2D11  22 D1 68                LD      (TXTPTR),HL
2D14  D1                      POP     DE
2D15  AF                      XOR     A
2D16  ED 52                   SBC     HL,DE
