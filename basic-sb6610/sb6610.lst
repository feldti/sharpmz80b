2CE1  E5                      PUSH    HL
2CE2  11 80 11                LD      DE,FKEY_TAB
2CE5  47                      LD      B,A
                      DEFKEY_SRCH:
2CE6  62                      LD      H,D
2CE7  6B                      LD      L,E
