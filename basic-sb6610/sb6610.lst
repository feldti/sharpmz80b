                      ; ==============================================================================
                      ;  BASIC-INTERPRETER SB-6610
                      ; ==============================================================================
                      ;  BAS_COLD: Laufwerksnummer des IPL in den Autostart-Befehl
                      ;  "RUN FDn"AUTO RUN"" eintragen, RAM-Ende suchen, Bildschirm,
                      ;  Uhr, Einschaltmeldung, I/O-Init, Autostart.
                      ; <- aufgerufen von 00AEh
                      BAS_COLD:
1222  3E 01                   LD      A,01h                   ; JP BAS_COLD bei 00AEh zu LD BC,nn entschärfen ...
1224  32 AE 00                LD      (MON_GOBASIC),A
1227  32 D5 13                LD      (AUTORUN_FLAG),A        ; ... und Autostart-Flag setzen
122A  3A EC 7F                LD      A,(IPL_DRIVE)           ; Laufwerksnummer vom IPL (0-3)
122D  C6 31                   ADD     A,31h                   ; -> "1".."4"
122F  32 F8 12                LD      (AUTORUN_CMD+6),A       ; in "RUN FDn"AUTO RUN"" eintragen
1232  21 FF 5F                LD      HL,RAM_START-1          ; RAM-Test ab 6000h [SB-6511: LD HL,6AFFh]
1235  16 FF                   LD      D,0FFh
                      BC_RAMTEST:
1237  23                      INC     HL
1238  7C                      LD      A,H
1239  BA                      CP      D
123A  28 0A                   JR      Z,BC_RAMEND
123C  3E FF                   LD      A,0FFh                  ; FFh schreiben und prüfen ...
123E  77                      LD      (HL),A
123F  96                      SUB     (HL)
1240  20 04                   JR      NZ,BC_RAMEND
1242  77                      LD      (HL),A                  ; ... 00h schreiben und prüfen
1243  BE                      CP      (HL)
1244  28 F1                   JR      Z,BC_RAMTEST
                      BC_RAMEND:
1246  22 08 60                LD      (MEMTOP),HL             ; erstes nicht beschreibbares Byte (bzw. FF00h)
1249  22 0A 60                LD      (STKTOP),HL
