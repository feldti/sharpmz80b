2D29  E1                      POP     HL
2D2A  22 70 11                LD      (FKEY_END),HL
2D2D  D1                      POP     DE
2D2E  EB                      EX      DE,HL
2D2F  C5                      PUSH    BC
2D30  ED 4B 6B 2D             LD      BC,(DEFKEY_REST)
2D34  2B                      DEC     HL
2D35  1B                      DEC     DE
2D36  ED B8                   LDDR
2D38  C1                      POP     BC
2D39  EB                      EX      DE,HL
2D3A  AF                      XOR     A
2D3B  ED 42                   SBC     HL,BC
2D3D  EB                      EX      DE,HL
2D3E  E1                      POP     HL
2D3F  13                      INC     DE
2D40  41                      LD      B,C
                      DEFKEY_COPY:
