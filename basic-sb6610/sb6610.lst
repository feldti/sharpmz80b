                      LENTAB:  ; Notenlänge 0-9 (Vielfache der Grundlänge)
0FC4  01 02 03 04 ..          DEFB    01h,02h,03h,04h,06h,08h,0Ch,10h,18h,20h
                      NOTE_CYC        EQU     LENTAB+9        ; Schwingungen je Längeneinheit, Index = MUS_NOTEIDX (+7 bei #)
0FCE  08 0F 0D 0C ..          DEFB    08h,0Fh,0Dh,0Ch,0Bh,0Ah,09h; Index 1-7: R B A G F E D
