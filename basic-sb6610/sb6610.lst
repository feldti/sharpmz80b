070E  32 35 00                LD      (0035h),A
0711  28 11                   JR      Z,GL_REPRESET
0713  F1                      POP     AF
0714  CD 50 09                CALL    GETKEY
0717  FE 01                   CP      01h
0719  38 04                   JR      C,GL_REPEAT
071B  FE 05                   CP      05h
