02D3  38 D8                   JR      C,CMT_ABORT
02D5  CD 58 03                CALL    VFBLK
02D8  18 CA                   JR      CMT_RDDONE
                      ; <- aufgerufen von 0274h
02DA  1E 02           WRBLK:  LD      E,02h
                      WRBLK_COPY:
02DC  C5                      PUSH    BC
02DD  E5                      PUSH    HL
                      WRBLK_BYTE:
02DE  7E                      LD      A,(HL)
02DF  CD 8F 03                CALL    WRBYTE
02E2  CD 6C 05                CALL    BRKKEY
02E5  38 18                   JR      C,BLK_RET
02E7  23                      INC     HL
02E8  0B                      DEC     BC
02E9  78                      LD      A,B
02EA  B1                      OR      C
02EB  20 F1                   JR      NZ,WRBLK_BYTE
02ED  2A 2B 00                LD      HL,(002Bh)
02F0  7C                      LD      A,H
02F1  CD 8F 03                CALL    WRBYTE
02F4  7D                      LD      A,L
02F5  CD 8F 03                CALL    WRBYTE
02F8  CD 39 05                CALL    WR1BIT
02FB  1D                      DEC     E
02FC  20 04                   JR      NZ,WRBLK_GAP
02FE  AF                      XOR     A
                      ; <- aufgerufen von 0388h
                      BLK_RET:
02FF  E1                      POP     HL
0300  C1                      POP     BC
0301  C9                      RET
                      WRBLK_GAP:
0302  CD 1D 05                CALL    WR0BIT
0305  10 FB                   DJNZ    WRBLK_GAP
0307  E1                      POP     HL
0308  C1                      POP     BC
0309  18 D1                   JR      WRBLK_COPY
                      ;  RDBLK – Block lesen, bei Prüfsummenfehler die zweite Kopie versuchen;
                      ;  beide falsch: "CHECK SUM ERROR", A = FFh, C.
                      ; <- aufgerufen von 02A1h
030B  1E 02           RDBLK:  LD      E,02h
030D  C5                      PUSH    BC
030E  E5                      PUSH    HL
                      RDBLK_SYNC:
030F  CD 46 04                CALL    EDGE
0312  38 EB                   JR      C,BLK_RET
0314  CD 54 05                CALL    DLY_BIT
0317  DB E1                   IN      A,(PPI_B)
0319  E6 40                   AND     40h
031B  28 F2                   JR      Z,RDBLK_SYNC
031D  21 00 00                LD      HL,0000h
0320  22 2B 00                LD      (002Bh),HL
0323  E1                      POP     HL
0324  C1                      POP     BC
0325  C5                      PUSH    BC
0326  E5                      PUSH    HL
                      RDBLK_BYTE:
0327  CD A0 03                CALL    RDBYTE
032A  38 D3                   JR      C,BLK_RET
032C  77                      LD      (HL),A
032D  23                      INC     HL
032E  0B                      DEC     BC
032F  78                      LD      A,B
0330  B1                      OR      C
0331  20 F4                   JR      NZ,RDBLK_BYTE
0333  2A 2B 00                LD      HL,(002Bh)
0336  CD A0 03                CALL    RDBYTE
0339  38 C4                   JR      C,BLK_RET
033B  4F                      LD      C,A
033C  CD A0 03                CALL    RDBYTE
033F  38 BE                   JR      C,BLK_RET
0341  BD                      CP      L
0342  20 06                   JR      NZ,RDBLK_RETRY
0344  79                      LD      A,C
0345  BC                      CP      H
0346  3E 00                   LD      A,00h
0348  28 B5                   JR      Z,BLK_RET
                      RDBLK_RETRY:
034A  1D                      DEC     E
034B  20 C2                   JR      NZ,RDBLK_SYNC
                      CMT_CKERR:
034D  11 92 06                LD      DE,MSG_CKSUM
0350  CD B6 05                CALL    MSGX
0353  3E FF                   LD      A,0FFh
0355  37                      SCF
0356  18 A7                   JR      BLK_RET
                      ; <- aufgerufen von 02D5h
0358  1E 02           VFBLK:  LD      E,02h
                      VFBLK_COPY:
035A  C5                      PUSH    BC
035B  E5                      PUSH    HL
                      VFBLK_SYNC:
035C  CD 46 04                CALL    EDGE
035F  38 9E                   JR      C,BLK_RET
0361  CD 54 05                CALL    DLY_BIT
0364  DB E1                   IN      A,(PPI_B)
0366  E6 40                   AND     40h
0368  28 F2                   JR      Z,VFBLK_SYNC
                      VFBLK_BYTE:
036A  CD A0 03                CALL    RDBYTE
036D  38 90                   JR      C,BLK_RET
036F  BE                      CP      (HL)
0370  20 DB                   JR      NZ,CMT_CKERR
0372  23                      INC     HL
0373  0B                      DEC     BC
0374  78                      LD      A,B
0375  B1                      OR      C
0376  20 F2                   JR      NZ,VFBLK_BYTE
0378  2A 33 00                LD      HL,(0033h)
037B  CD A0 03                CALL    RDBYTE
037E  BC                      CP      H
037F  20 CC                   JR      NZ,CMT_CKERR
0381  CD A0 03                CALL    RDBYTE
0384  BD                      CP      L
0385  20 C6                   JR      NZ,CMT_CKERR
0387  1D                      DEC     E
0388  CA FF 02                JP      Z,BLK_RET
038B  E1                      POP     HL
038C  C1                      POP     BC
038D  18 CB                   JR      VFBLK_COPY
                      ; <- aufgerufen von 02DFh, 02F1h, 02F5h
038F  C5              WRBYTE: PUSH    BC
0390  06 08                   LD      B,08h
0392  CD 39 05                CALL    WR1BIT
                      WRBYTE_BIT:
0395  07                      RLCA
0396  DC 39 05                CALL    C,WR1BIT
0399  D4 1D 05                CALL    NC,WR0BIT
039C  10 F7                   DJNZ    WRBYTE_BIT
039E  C1                      POP     BC
039F  C9                      RET
                      ;  RDBYTE – ein Byte lesen: je Bit Flanke abwarten, nach DLY_BIT den Pegel
                      ;  prüfen (1 = langer Puls), 1-Bits für die Prüfsumme zählen (002Bh).
                      ; <- aufgerufen von 0327h, 0336h, 033Ch, 036Ah, 037Bh, 0381h
03A0  E5              RDBYTE: PUSH    HL
03A1  21 00 08                LD      HL,0800h
                      RDBYTE_BIT:
03A4  CD 46 04                CALL    EDGE
03A7  38 1C                   JR      C,RDBYTE_RET
03A9  CD 54 05                CALL    DLY_BIT
03AC  DB E1                   IN      A,(PPI_B)
03AE  E6 40                   AND     40h
03B0  28 0A                   JR      Z,RDBYTE_SHIFT
03B2  E5                      PUSH    HL
03B3  2A 2B 00                LD      HL,(002Bh)
03B6  23                      INC     HL
03B7  22 2B 00                LD      (002Bh),HL
03BA  E1                      POP     HL
03BB  37                      SCF
                      RDBYTE_SHIFT:
03BC  CB 15                   RL      L
03BE  25                      DEC     H
03BF  20 E3                   JR      NZ,RDBYTE_BIT
03C1  CD 46 04                CALL    EDGE
03C4  7D                      LD      A,L
                      RDBYTE_RET:
03C5  E1                      POP     HL
03C6  C9                      RET
                      ; <- aufgerufen von 0271h
                      WRGAP_TM:
03C7  C5                      PUSH    BC
03C8  E5                      PUSH    HL
03C9  01 F8 2A                LD      BC,2AF8h
03CC  21 14 14                LD      HL,1414h
03CF  CB 4A                   BIT     1,D
03D1  20 04                   JR      NZ,GAP_ZEROS
03D3  01 10 27                LD      BC,2710h
03D6  29                      ADD     HL,HL
                      GAP_ZEROS:
03D7  CD 1D 05                CALL    WR0BIT
03DA  0B                      DEC     BC
03DB  78                      LD      A,B
03DC  B1                      OR      C
03DD  20 F8                   JR      NZ,GAP_ZEROS
                      GAP_ONES:
03DF  CD 39 05                CALL    WR1BIT
03E2  25                      DEC     H
03E3  20 FA                   JR      NZ,GAP_ONES
                      GAP_ZEROS2:
03E5  CD 1D 05                CALL    WR0BIT
                      GAP_ZEROS2N:
03E8  2D                      DEC     L
03E9  20 FA                   JR      NZ,GAP_ZEROS2
03EB  CD 39 05                CALL    WR1BIT
                      POP_HL_BC_RET:
03EE  E1                      POP     HL
03EF  C1                      POP     BC
                      GAP_RET:
03F0  C9                      RET
                      ;  RDTMARK – Bandmarke suchen: 40 (Kopf) bzw. 20 (Daten) Einsen in Folge,
                      ;  dann ebenso viele Nullen.
                      ; <- aufgerufen von 029Ch, 02D0h
                      RDTMARK:
03F1  E5                      PUSH    HL
03F2  2E 14                   LD      L,14h
03F4  CB 5A                   BIT     3,D
03F6  20 02                   JR      NZ,TMARK_ONES
03F8  CB 05                   RLC     L
                      TMARK_ONES:
03FA  65                      LD      H,L
                      TMARK_ONES_LP:
03FB  CD 46 04                CALL    EDGE
03FE  38 21                   JR      C,TMARK_RET
                      TMARK_ONESBIT:
0400  CD 54 05                CALL    DLY_BIT
0403  DB E1                   IN      A,(PPI_B)
0405  E6 40                   AND     40h
0407  28 F1                   JR      Z,TMARK_ONES
0409  25                      DEC     H
040A  20 EF                   JR      NZ,TMARK_ONES_LP
040C  65                      LD      H,L
                      TMARK_ZEROS:
040D  CD 46 04                CALL    EDGE
0410  38 0F                   JR      C,TMARK_RET
0412  CD 54 05                CALL    DLY_BIT
0415  DB E1                   IN      A,(PPI_B)
0417  E6 40                   AND     40h
0419  20 DF                   JR      NZ,TMARK_ONES
041B  25                      DEC     H
041C  20 EF                   JR      NZ,TMARK_ZEROS
041E  CD 46 04                CALL    EDGE
                      TMARK_RET:
0421  E1                      POP     HL
0422  C9                      RET
                      ;  CKSUM – Anzahl der 1-Bits von BC Bytes ab HL nach 002Bh und 0033h.
                      ; <- aufgerufen von 025Ah, 02C8h
0423  C5              CKSUM:  PUSH    BC
0424  E5                      PUSH    HL
0425  D5                      PUSH    DE
0426  11 00 00                LD      DE,0000h
                      CKSUM_LP:
0429  78                      LD      A,B
042A  B1                      OR      C
042B  20 0A                   JR      NZ,CKSUM_BYTE
042D  EB                      EX      DE,HL
042E  22 2B 00                LD      (002Bh),HL
0431  22 33 00                LD      (0033h),HL
0434  D1                      POP     DE
0435  18 B7                   JR      POP_HL_BC_RET
                      CKSUM_BYTE:
0437  7E                      LD      A,(HL)
0438  C5                      PUSH    BC
0439  06 08                   LD      B,08h
                      CKSUM_BIT:
043B  07                      RLCA
043C  30 01                   JR      NC,CKSUM_NEXT
043E  13                      INC     DE
                      CKSUM_NEXT:
043F  10 FA                   DJNZ    CKSUM_BIT
0441  C1                      POP     BC
0442  23                      INC     HL
0443  0B                      DEC     BC
0444  18 E3                   JR      CKSUM_LP
                      ; ------------------------------------------------------------------------------
                      ;  EDGE – auf steigende Flanke des Bandsignals warten, CY = BREAK
                      ; ------------------------------------------------------------------------------
                      ;  EDGE – auf eine Flanke des Lesesignals (PPI Port B Bit 6) warten;
                      ;  C = BREAK gedrückt.
                      ; <- aufgerufen von 030Fh, 035Ch, 03A4h, 03C1h, 03FBh, 040Dh, 041Eh
0446  DB E1           EDGE:   IN      A,(PPI_B)
0448  2F                      CPL
0449  07                      RLCA
044A  D8                      RET     C
044B  07                      RLCA
044C  30 F8                   JR      NC,EDGE
                      EDGE_LOW:
044E  DB E1                   IN      A,(PPI_B)
0450  2F                      CPL
0451  07                      RLCA
0452  D8                      RET     C
0453  07                      RLCA
0454  38 F8                   JR      C,EDGE_LOW
0456  C9                      RET
                      ; ------------------------------------------------------------------------------
                      ;  CMT_READY – Kassette bereit? Sonst "SET TAPE" und Fach öffnen;
                      ;  beim Schreiben Schreibschutz prüfen ("WRITE PROTECT"), dann PLAY.
                      ; ------------------------------------------------------------------------------
                      ;  Laufwerk: PPI Port A Bit 0 REW, 1 FF, 2 PLAY, 3 STOP (Flanke 0->1 über
                      ;  PPIA_OUT mit PPI_A_COPY), Port C über Bit-Set/Reset: Bit 4 Fach
                      ;  öffnen (CMT_EJECT), Bit 5 wird vor PLAY/REW gepulst (CMT_PREPULSE),
                      ;  Bit 6 Aufnahme. Port B Bit 4: Schreibschutz, Bit 5: keine Kassette.
                      ; <- aufgerufen von 025Dh, 0297h, 02CBh
                      CMT_READY:
0457  CD 71 05                CALL    KEYROW3
045A  DB E1                   IN      A,(PPI_B)
045C  E6 20                   AND     20h
045E  28 18                   JR      Z,CMTR_WPCHK
0460  D5                      PUSH    DE
0461  11 72 06                LD      DE,MSG_SETTAPE
0464  CD B6 05                CALL    MSGX
0467  D1                      POP     DE
0468  CD 8C 04                CALL    CMT_EJECT
                      CMTR_WAIT:
046B  CD 6C 05                CALL    BRKKEY
046E  D8                      RET     C
046F  DB E1                   IN      A,(PPI_B)
0471  E6 20                   AND     20h
0473  20 F6                   JR      NZ,CMTR_WAIT
0475  CD 17 05                CALL    DLY_MID
                      CMTR_WPCHK:
0478  3E 03                   LD      A,03h
047A  A2                      AND     D
047B  28 1E                   JR      Z,CMTR_PLAY
047D  DB E1                   IN      A,(PPI_B)
047F  E6 10                   AND     10h
0481  28 14                   JR      Z,CMTR_REC
0483  D5                      PUSH    DE
0484  11 84 06                LD      DE,MSG_WPROT
0487  CD B6 05                CALL    MSGX
