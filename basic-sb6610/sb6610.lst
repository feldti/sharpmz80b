0E2C  3E C0                   LD      A,0C0h
0E2E  B9                      CP      C
0E2F  20 EE                   JR      NZ,TIMER_SYNC
0E31  3E C0                   LD      A,0C0h
0E33  D3 E5                   OUT     (PIT_C1),A
0E35  3E A8                   LD      A,0A8h
0E37  D3 E5                   OUT     (PIT_C1),A
0E39  3E 12                   LD      A,12h
0E3B  D3 E4                   OUT     (PIT_C0),A
0E3D  3E 7A                   LD      A,7Ah                   ; 'z'
0E3F  D3 E4                   OUT     (PIT_C0),A
0E41  3E 84                   LD      A,84h
0E43  D3 E7                   OUT     (PIT_CTL),A
0E45  DB E6                   IN      A,(PIT_C2)
