                      ;  FD_READ / FD_WRITE – Einsprünge des Floppy-Treibers für DISK_RW.
                      ;  FD_READ / FD_WRITE – Sektoren lesen/schreiben, Einsprung aus DISK_RW
                      ;  mit IX = DISK_PAR:
                      ;    +0 Laufwerk (0-3)       +1/+2 logischer Startsektor   +3/+4 Bytes
                      ;    +5/+6 Speicheradresse   +7/+8 Spur/Sektor in Arbeit   +9/+10 Startspur/-sektor
                      ;  16 Sektoren zu 256 Bytes je Spur; logische Spur / 2 = Zylinder, Bit 0 =
                      ;  Seite. Der MB8876 hat einen invertierten Datenbus: alle Werte werden
                      ;  vor OUT und nach IN mit CPL umgedreht. Fehler gehen über (IY-1)/JP (IY)
                      ;  an den mit SET_IOERR gesetzten Behandler.
                      FD_READ:
5D00  C3 B8 5D                JP      FDR_START
                      FD_WRITE:
5D03  C3 0B 5E                JP      FDW_START
                      ; ==============================================================================
                      ;  FLOPPY-TREIBER (MB8876, Ports D8h-DDh)
                      ; ==============================================================================
                      ;  FD_MOTOR_OFF – Laufwerke abwählen, Motor aus, "zurückgesetzt"-Flags
                      ;  löschen (FD_RESET).
                      ; <- aufgerufen von 4869h
                      FD_MOTOR_OFF:
5D06  C3 5D 5D                JP      FD_RESET
                      ;  FD_SELECT – Motor einschalten (beim ersten Mal mit Anlaufzeit,
                      ;  FD_MOTORON), Laufwerk (IX+0) wählen (Port DCh: Bit 7 Motor, Bit 2
                      ;  Auswahl, Bit 0-1 Laufwerk), auf "bereit" warten (sonst Fehler 50);
                      ;  beim ersten Zugriff auf das Laufwerk RESTORE (Spur 0).
                      ; <- aufgerufen von 5E73h, 5EF9h
                      FD_SELECT:
5D09  3A E1 5F                LD      A,(FD_MOTOR)
5D0C  0F                      RRCA
5D0D  D4 44 5D                CALL    NC,FD_MOTORON
5D10  DD 7E 00                LD      A,(IX+0)
5D13  F6 84                   OR      84h
5D15  D3 DC                   OUT     (FDD_SEL),A
5D17  AF                      XOR     A
5D18  32 E0 5F                LD      (FD_LASTCMD),A
5D1B  CD D5 5F                CALL    FD_DLY_L
5D1E  21 00 00                LD      HL,0000h
                      FD_WAITRDY:
5D21  2B                      DEC     HL
5D22  7C                      LD      A,H
5D23  B5                      OR      L
5D24  28 19                   JR      Z,FD_NOTRDY
5D26  DB D8                   IN      A,(FDC_CMD)
5D28  2F                      CPL
5D29  07                      RLCA
5D2A  38 F5                   JR      C,FD_WAITRDY
5D2C  DD 4E 00                LD      C,(IX+0)
5D2F  21 E2 5F                LD      HL,FD_RESTORED
5D32  06 00                   LD      B,00h
5D34  09                      ADD     HL,BC
5D35  CB 46                   BIT     0,(HL)
5D37  20 05                   JR      NZ,FD_SEL_RET
5D39  CD 73 5D                CALL    FD_RESTORE
5D3C  CB C6                   SET     0,(HL)
                      FD_SEL_RET:
5D3E  C9                      RET
                      FD_NOTRDY:
5D3F  3E 32                   LD      A,32h                   ; '2'
5D41  C3 A2 5F                JP      FD_ERRA
                      ; <- aufgerufen von 5D0Dh
                      FD_MOTORON:
5D44  3E 80                   LD      A,80h
5D46  D3 DC                   OUT     (FDD_SEL),A
5D48  06 10                   LD      B,10h
                      FD_MOTOR_DLY:
5D4A  CD D5 5F                CALL    FD_DLY_L
5D4D  10 FB                   DJNZ    FD_MOTOR_DLY
5D4F  3E 01                   LD      A,01h
5D51  32 E1 5F                LD      (FD_MOTOR),A
5D54  C9                      RET
                      ;  FD_SEEK – SEEK (1Bh) zur Spur im Datenregister. NZ bei Fehlerbits.
                      ; <- aufgerufen von 5DC1h, 5E14h, 5F11h
                      FD_SEEK:
5D55  3E 1B                   LD      A,1Bh
5D57  CD 80 5D                CALL    FD_CMDWAIT
5D5A  E6 99                   AND     99h
5D5C  C9                      RET
                      ; <- aufgerufen von 5D06h, 5FA5h
                      FD_RESET:
5D5D  CD CE 5F                CALL    FD_DLY_M
5D60  AF                      XOR     A
5D61  D3 DC                   OUT     (FDD_SEL),A
5D63  32 E2 5F                LD      (FD_RESTORED),A
5D66  32 E3 5F                LD      (FD_RESTORED1),A
5D69  32 E4 5F                LD      (FD_RESTORED2),A
5D6C  32 E5 5F                LD      (FD_RESTORED3),A
5D6F  32 E1 5F                LD      (FD_MOTOR),A
5D72  C9                      RET
                      ;  FD_RESTORE – RESTORE (0Bh), Kopf auf Spur 0; Fehler: FD_ERROR.
                      ; <- aufgerufen von 5D39h, 5EBEh, 5F6Ch
                      FD_RESTORE:
5D73  3E 0B                   LD      A,0Bh
5D75  CD 80 5D                CALL    FD_CMDWAIT
5D78  E6 85                   AND     85h
5D7A  EE 04                   XOR     04h
5D7C  C8                      RET     Z
5D7D  C3 73 5F                JP      FD_ERROR
                      ;  FD_CMDWAIT – Kommando A ausgeben (FD_LASTCMD), auf "nicht beschäftigt"
                      ;  warten, Status nach FD_STATUS.
                      ; <- aufgerufen von 5D57h, 5D75h
                      FD_CMDWAIT:
5D80  32 E0 5F                LD      (FD_LASTCMD),A
5D83  2F                      CPL
5D84  D3 D8                   OUT     (FDC_CMD),A
5D86  3E 38                   LD      A,38h                   ; '8'
5D88  32 AB 5D                LD      (FD_WB_JR),A
5D8B  CD 98 5D                CALL    FD_WAITBUSY
5D8E  CD D5 5F                CALL    FD_DLY_L
5D91  DB D8                   IN      A,(FDC_CMD)
5D93  2F                      CPL
5D94  32 72 5F                LD      (FD_STATUS),A
5D97  C9                      RET
                      ;  FD_WAITBUSY – warten, bis Bit 0 des Status wechselt; die Richtung (JR C
                      ;  bzw. JR NC) wird in FD_WB_JR eingesetzt. Zeitüberschreitung: Fehler 41.
                      ; <- aufgerufen von 5D8Bh, 5EDFh, 5EEDh
                      FD_WAITBUSY:
5D98  D5                      PUSH    DE
5D99  E5                      PUSH    HL
5D9A  CD C7 5F                CALL    FD_DLY_S
5D9D  1E 07                   LD      E,07h
                      FD_WB_OUTER:
5D9F  21 00 00                LD      HL,0000h
                      FD_WB_LP:
5DA2  2B                      DEC     HL
5DA3  7C                      LD      A,H
5DA4  B5                      OR      L
5DA5  28 09                   JR      Z,FD_WB_TIMEOUT
5DA7  DB D8                   IN      A,(FDC_CMD)
5DA9  2F                      CPL
5DAA  0F                      RRCA
                      FD_WB_JR:
5DAB  38 F5                   JR      C,FD_WB_LP
5DAD  E1                      POP     HL
5DAE  D1                      POP     DE
5DAF  C9                      RET
                      FD_WB_TIMEOUT:
5DB0  1D                      DEC     E
5DB1  20 EC                   JR      NZ,FD_WB_OUTER
5DB3  3E 29                   LD      A,29h                   ; ')'
5DB5  C3 A2 5F                JP      FD_ERRA
                      ;  FDR_START – Lesen: Spur/Sektor aus dem logischen Sektor (FD_PREP),
                      ;  je Spur SEEK, Spur- und Sektorregister setzen, READ SECTOR mit
                      ;  Mehrfachsektoren (94h) und die Bytes mit INI holen (Datenport DBh).
                      ;  Nach Sektor 16 Abbruch mit FORCE INTERRUPT und weiter auf der nächsten
                      ;  Spur. Fehler: bis zu 10 Versuche (FD_RETRY) mit RESTORE dazwischen.
                      ; <- aufgerufen von 5D00h
                      FDR_START:
5DB8  CD 6A 5E                CALL    FD_PREP
                      FDR_RETRY:
5DBB  CD 73 5E                CALL    FD_SETUP
                      FDR_TRACK:
5DBE  CD 93 5E                CALL    FD_SIDE
5DC1  CD 55 5D                CALL    FD_SEEK
5DC4  20 40                   JR      NZ,FDR_ERR
5DC6  CD A3 5E                CALL    FD_SETTS
5DC9  F3                      DI
5DCA  3E 94                   LD      A,94h
5DCC  CD D4 5E                CALL    FD_CMDRW
                      FDR_SECTOR:
5DCF  06 00                   LD      B,00h
                      FDR_BYTE:
5DD1  DB D8                   IN      A,(FDC_CMD)
5DD3  0F                      RRCA
5DD4  38 1A                   JR      C,FDR_STATUS
5DD6  0F                      RRCA
5DD7  38 F8                   JR      C,FDR_BYTE
5DD9  ED A2                   INI
5DDB  20 F4                   JR      NZ,FDR_BYTE
5DDD  DD 34 08                INC     (IX+8)
5DE0  DD 7E 08                LD      A,(IX+8)
5DE3  FE 11                   CP      11h
5DE5  28 05                   JR      Z,FDR_LAST
5DE7  15                      DEC     D
5DE8  20 E5                   JR      NZ,FDR_SECTOR
5DEA  18 01                   JR      FDR_STOP
                      FDR_LAST:
5DEC  15                      DEC     D
                      FDR_STOP:
5DED  CD E3 5E                CALL    FD_FORCEINT
                      FDR_STATUS:
5DF0  FB                      EI
5DF1  DB D8                   IN      A,(FDC_CMD)
5DF3  2F                      CPL
5DF4  32 72 5F                LD      (FD_STATUS),A
5DF7  E6 FF                   AND     0FFh
5DF9  20 0B                   JR      NZ,FDR_ERR
5DFB  CD C2 5E                CALL    FD_NEXTSEC
5DFE  CA 65 5E                JP      Z,FD_DONE
5E01  DD 7E 07                LD      A,(IX+7)
5E04  18 B8                   JR      FDR_TRACK
                      FDR_ERR:
5E06  CD B4 5E                CALL    FD_RETRY
5E09  18 B0                   JR      FDR_RETRY
                      ;  FDW_START – Schreiben wie FDR_START mit WRITE SECTOR (B4h) und OUTI;
                      ;  danach Kontrolllesen (FD_VERIFY). Schreibschutz: Fehler 41.
                      ; <- aufgerufen von 5D03h
                      FDW_START:
5E0B  CD 6A 5E                CALL    FD_PREP
                      ; <- aufgerufen von 5E5Ch
                      FDW_RETRY:
5E0E  CD 73 5E                CALL    FD_SETUP
                      ; <- aufgerufen von 5E62h
                      FDW_TRACK:
5E11  CD 93 5E                CALL    FD_SIDE
5E14  CD 55 5D                CALL    FD_SEEK
5E17  C2 59 5E                JP      NZ,FDW_ERR
5E1A  CD A3 5E                CALL    FD_SETTS
5E1D  F3                      DI
5E1E  3E B4                   LD      A,0B4h
5E20  CD D4 5E                CALL    FD_CMDRW
                      FDW_SECTOR:
5E23  06 00                   LD      B,00h
                      FDW_BYTE:
5E25  DB D8                   IN      A,(FDC_CMD)
5E27  0F                      RRCA
5E28  38 1A                   JR      C,FDW_STATUS
5E2A  0F                      RRCA
5E2B  38 F8                   JR      C,FDW_BYTE
5E2D  ED A3                   OUTI
5E2F  20 F4                   JR      NZ,FDW_BYTE
5E31  DD 34 08                INC     (IX+8)
5E34  DD 7E 08                LD      A,(IX+8)
5E37  FE 11                   CP      11h
5E39  28 05                   JR      Z,FDW_LAST
5E3B  15                      DEC     D
5E3C  20 E5                   JR      NZ,FDW_SECTOR
5E3E  18 01                   JR      FDW_STOP
                      FDW_LAST:
5E40  15                      DEC     D
                      FDW_STOP:
5E41  CD E3 5E                CALL    FD_FORCEINT
                      FDW_STATUS:
5E44  FB                      EI
5E45  DB D8                   IN      A,(FDC_CMD)
5E47  2F                      CPL
5E48  32 72 5F                LD      (FD_STATUS),A
5E4B  E6 FF                   AND     0FFh
5E4D  20 0A                   JR      NZ,FDW_ERR
5E4F  CD C2 5E                CALL    FD_NEXTSEC
5E52  20 0B                   JR      NZ,FDW_NEXTTRK
5E54  CD F1 5E                CALL    FD_VERIFY
5E57  30 0C                   JR      NC,FD_DONE
                      ; <- aufgerufen von 5E17h
                      FDW_ERR:
5E59  CD B4 5E                CALL    FD_RETRY
5E5C  C3 0E 5E                JP      FDW_RETRY
                      FDW_NEXTTRK:
5E5F  DD 7E 07                LD      A,(IX+7)
5E62  C3 11 5E                JP      FDW_TRACK
                      ; <- aufgerufen von 5DFEh
                      FD_DONE:
5E65  3E 80                   LD      A,80h
5E67  D3 DC                   OUT     (FDD_SEL),A
5E69  C9                      RET
                      ;  FD_PREP – Startspur/-sektor berechnen, 10 Versuche einstellen.
                      ;  FD_SETUP – Laufwerk wählen, D = Anzahl Sektoren, HL = Speicheradresse.
                      ; <- aufgerufen von 5DB8h, 5E0Bh
                      FD_PREP:
5E6A  CD AA 5F                CALL    FD_LOG2PHYS
5E6D  3E 0A                   LD      A,0Ah
5E6F  32 E6 5F                LD      (FD_RETRIES),A
5E72  C9                      RET
                      ; <- aufgerufen von 5DBBh, 5E0Eh
                      FD_SETUP:
5E73  CD 09 5D                CALL    FD_SELECT
5E76  DD 56 04                LD      D,(IX+4)
5E79  DD 7E 03                LD      A,(IX+3)
5E7C  B7                      OR      A
5E7D  28 01                   JR      Z,FD_SETUP2
5E7F  14                      INC     D
                      FD_SETUP2:
5E80  DD 7E 0A                LD      A,(IX+10)
5E83  DD 77 08                LD      (IX+8),A
5E86  DD 7E 09                LD      A,(IX+9)
5E89  DD 77 07                LD      (IX+7),A
5E8C  DD 6E 05                LD      L,(IX+5)
5E8F  DD 66 06                LD      H,(IX+6)
5E92  C9                      RET
                      ;  FD_SIDE – A = logische Spur: A/2 ins Datenregister (für SEEK), Bit 0
                      ;  als Seite an Port DDh.
                      ; <- aufgerufen von 5DBEh, 5E11h, 5F0Eh
                      FD_SIDE:
5E93  CB 3F                   SRL     A
5E95  2F                      CPL
5E96  D3 DB                   OUT     (FDC_DAT),A
5E98  30 04                   JR      NC,FD_SIDE0
5E9A  3E 01                   LD      A,01h
5E9C  18 01                   JR      FD_SIDE_OUT
                      FD_SIDE0:
5E9E  AF                      XOR     A
                      FD_SIDE_OUT:
5E9F  2F                      CPL
5EA0  D3 DD                   OUT     (FDD_SID),A
5EA2  C9                      RET
                      ; <- aufgerufen von 5DC6h, 5E1Ah
                      FD_SETTS:
5EA3  0E DB                   LD      C,0DBh
5EA5  DD 7E 07                LD      A,(IX+7)
5EA8  CB 3F                   SRL     A
5EAA  2F                      CPL
5EAB  D3 D9                   OUT     (FDC_TRK),A
5EAD  DD 7E 08                LD      A,(IX+8)
5EB0  2F                      CPL
5EB1  D3 DA                   OUT     (FDC_SEC),A
5EB3  C9                      RET
                      ; <- aufgerufen von 5E06h, 5E59h
                      FD_RETRY:
5EB4  3A E6 5F                LD      A,(FD_RETRIES)
5EB7  3D                      DEC     A
5EB8  32 E6 5F                LD      (FD_RETRIES),A
5EBB  CA 73 5F                JP      Z,FD_ERROR
5EBE  CD 73 5D                CALL    FD_RESTORE
5EC1  C9                      RET
                      ;  FD_NEXTSEC – nach Sektor 16 auf Sektor 1 der nächsten Spur; NZ, wenn
                      ;  noch Sektoren fehlen (D).
                      ; <- aufgerufen von 5DFBh, 5E4Fh
                      FD_NEXTSEC:
5EC2  DD 7E 08                LD      A,(IX+8)
5EC5  FE 11                   CP      11h
5EC7  20 08                   JR      NZ,FD_NS_RET
5EC9  3E 01                   LD      A,01h
5ECB  DD 77 08                LD      (IX+8),A
5ECE  DD 34 07                INC     (IX+7)
                      FD_NS_RET:
5ED1  7A                      LD      A,D
5ED2  B7                      OR      A
5ED3  C9                      RET
                      ; <- aufgerufen von 5DCCh, 5E20h, 5F25h
                      FD_CMDRW:
5ED4  32 E0 5F                LD      (FD_LASTCMD),A
5ED7  2F                      CPL
5ED8  D3 D8                   OUT     (FDC_CMD),A
5EDA  3E 30                   LD      A,30h                   ; '0'
5EDC  32 AB 5D                LD      (FD_WB_JR),A
5EDF  CD 98 5D                CALL    FD_WAITBUSY
5EE2  C9                      RET
                      ;  FD_FORCEINT – FORCE INTERRUPT (D8h) und auf Ende warten.
                      ; <- aufgerufen von 5DEDh, 5E41h, 5F42h
                      FD_FORCEINT:
5EE3  3E D8                   LD      A,0D8h
5EE5  2F                      CPL
5EE6  D3 D8                   OUT     (FDC_CMD),A
5EE8  3E 38                   LD      A,38h                   ; '8'
5EEA  32 AB 5D                LD      (FD_WB_JR),A
5EED  CD 98 5D                CALL    FD_WAITBUSY
5EF0  C9                      RET
                      ;  FD_VERIFY – geschriebene Sektoren zur Kontrolle lesen (Daten werden
                      ;  verworfen), 2 Versuche; C bei Fehler.
                      ; <- aufgerufen von 5E54h
                      FD_VERIFY:
5EF1  CD AA 5F                CALL    FD_LOG2PHYS
5EF4  3E 02                   LD      A,02h
5EF6  32 E7 5F                LD      (FD_VRETRIES),A
                      ; <- aufgerufen von 5F6Fh
                      FDV_RETRY:
5EF9  CD 09 5D                CALL    FD_SELECT
5EFC  DD 56 04                LD      D,(IX+4)
5EFF  DD 7E 03                LD      A,(IX+3)
5F02  B7                      OR      A
5F03  28 01                   JR      Z,FDV_SETUP
5F05  14                      INC     D
                      FDV_SETUP:
5F06  DD 7E 0A                LD      A,(IX+10)
5F09  6F                      LD      L,A
5F0A  DD 7E 09                LD      A,(IX+9)
5F0D  67                      LD      H,A
                      ; <- aufgerufen von 5F5Eh
                      FDV_TRACK:
5F0E  CD 93 5E                CALL    FD_SIDE
5F11  CD 55 5D                CALL    FD_SEEK
5F14  20 4B                   JR      NZ,FDV_ERR
5F16  0E DB                   LD      C,0DBh
5F18  7C                      LD      A,H
5F19  CB 3F                   SRL     A
5F1B  2F                      CPL
5F1C  D3 D9                   OUT     (FDC_TRK),A
5F1E  7D                      LD      A,L
5F1F  2F                      CPL
5F20  D3 DA                   OUT     (FDC_SEC),A
5F22  F3                      DI
5F23  3E 94                   LD      A,94h
5F25  CD D4 5E                CALL    FD_CMDRW
                      FDV_SECTOR:
5F28  06 00                   LD      B,00h
                      FDV_BYTE:
5F2A  DB D8                   IN      A,(FDC_CMD)
5F2C  0F                      RRCA
5F2D  38 16                   JR      C,FDV_STATUS
5F2F  0F                      RRCA
5F30  38 F8                   JR      C,FDV_BYTE
5F32  ED 78                   IN      A,(C)
5F34  10 F4                   DJNZ    FDV_BYTE
5F36  2C                      INC     L
5F37  7D                      LD      A,L
5F38  FE 11                   CP      11h
5F3A  28 05                   JR      Z,FDV_LAST
5F3C  15                      DEC     D
5F3D  20 E9                   JR      NZ,FDV_SECTOR
5F3F  18 01                   JR      FDV_STOP
                      FDV_LAST:
5F41  15                      DEC     D
                      FDV_STOP:
5F42  CD E3 5E                CALL    FD_FORCEINT
                      FDV_STATUS:
5F45  FB                      EI
5F46  DB D8                   IN      A,(FDC_CMD)
5F48  2F                      CPL
5F49  32 72 5F                LD      (FD_STATUS),A
5F4C  E6 FF                   AND     0FFh
5F4E  20 11                   JR      NZ,FDV_ERR
5F50  7D                      LD      A,L
5F51  FE 11                   CP      11h
5F53  20 03                   JR      NZ,FDV_CHKEND
5F55  2E 01                   LD      L,01h
5F57  24                      INC     H
                      FDV_CHKEND:
5F58  7A                      LD      A,D
5F59  B7                      OR      A
5F5A  20 01                   JR      NZ,FDV_NEXTTRK
5F5C  C9                      RET
                      FDV_NEXTTRK:
5F5D  7C                      LD      A,H
5F5E  C3 0E 5F                JP      FDV_TRACK
                      FDV_ERR:
5F61  3A E7 5F                LD      A,(FD_VRETRIES)
5F64  3D                      DEC     A
5F65  32 E7 5F                LD      (FD_VRETRIES),A
5F68  20 02                   JR      NZ,FDV_AGAIN
5F6A  37                      SCF
5F6B  C9                      RET
                      FDV_AGAIN:
5F6C  CD 73 5D                CALL    FD_RESTORE
5F6F  C3 F9 5E                JP      FDV_RETRY
                      FD_STATUS:
5F72  00                      DEFB    00h                     ; ?? |.|
                      ;  FD_ERROR – Fehlernummer aus dem Status: nicht bereit (Bit 7) 50,
                      ;  Satz nicht gefunden (Bit 4) 54, sonst (auch Schreibschutz, Bit 6) 41.
                      ;  Nummer nach (IY-1) schreiben, Laufwerke abschalten, JP (IY).
                      ; <- aufgerufen von 5D7Dh, 5EBBh
                      FD_ERROR:
5F73  3A E0 5F                LD      A,(FD_LASTCMD)
5F76  FE 0B                   CP      0Bh
5F78  28 1B                   JR      Z,FD_ERR_SEEK
5F7A  FE 1B                   CP      1Bh
5F7C  28 17                   JR      Z,FD_ERR_SEEK
5F7E  FE F4                   CP      0F4h
5F80  28 13                   JR      Z,FD_ERR_SEEK
5F82  3A 72 5F                LD      A,(FD_STATUS)
5F85  CB 7F                   BIT     7,A
5F87  20 17                   JR      NZ,FD_ERR50
5F89  CB 77                   BIT     6,A
5F8B  20 0F                   JR      NZ,FD_ERR41
5F8D  CB 67                   BIT     4,A
5F8F  3E 36                   LD      A,36h                   ; '6'
5F91  20 0F                   JR      NZ,FD_ERRA
5F93  18 07                   JR      FD_ERR41
                      FD_ERR_SEEK:
5F95  3A 72 5F                LD      A,(FD_STATUS)
5F98  CB 7F                   BIT     7,A
5F9A  20 04                   JR      NZ,FD_ERR50
                      FD_ERR41:
5F9C  3E 29                   LD      A,29h                   ; ')'
5F9E  18 02                   JR      FD_ERRA
                      FD_ERR50:
5FA0  3E 32                   LD      A,32h                   ; '2'
                      ; <- aufgerufen von 5D41h, 5DB5h
                      FD_ERRA:
5FA2  FD 77 FF                LD      (IY-1),A
5FA5  CD 5D 5D                CALL    FD_RESET
5FA8  FD E9                   JP      (IY)
                      ;  FD_LOG2PHYS – logischen Sektor (IX+1/+2) in Spur (= Sektor / 16) und
                      ;  Sektor (= Rest + 1) zerlegen (IX+9/+10).
                      ; <- aufgerufen von 5E6Ah, 5EF1h
                      FD_LOG2PHYS:
5FAA  06 00                   LD      B,00h
5FAC  11 10 00                LD      DE,0010h
5FAF  DD 6E 01                LD      L,(IX+1)
5FB2  DD 66 02                LD      H,(IX+2)
5FB5  AF                      XOR     A
                      FD_L2P_LP:
5FB6  ED 52                   SBC     HL,DE
5FB8  38 03                   JR      C,FD_L2P_DONE
5FBA  04                      INC     B
5FBB  18 F9                   JR      FD_L2P_LP
                      FD_L2P_DONE:
5FBD  19                      ADD     HL,DE
5FBE  60                      LD      H,B
5FBF  2C                      INC     L
5FC0  DD 74 09                LD      (IX+9),H
5FC3  DD 75 0A                LD      (IX+10),L
5FC6  C9                      RET
                      ;  FD_DLY_S / FD_DLY_M / FD_DLY_L – Warteschleifen (Zähler 000Fh, 00A0h,
                      ;  1FE1h).
                      ; <- aufgerufen von 5D9Ah
                      FD_DLY_S:
5FC7  D5                      PUSH    DE
5FC8  11 0F 00                LD      DE,000Fh
5FCB  C3 D9 5F                JP      FD_DLY_LP
                      ; <- aufgerufen von 5D5Dh
                      FD_DLY_M:
5FCE  D5                      PUSH    DE
5FCF  11 A0 00                LD      DE,00A0h
5FD2  C3 D9 5F                JP      FD_DLY_LP
                      ; <- aufgerufen von 5D1Bh, 5D4Ah, 5D8Eh
                      FD_DLY_L:
5FD5  D5                      PUSH    DE
5FD6  11 26 20                LD      DE,2026h                ; Wartezeit (Schleifenzähler, keine Adresse)
                      ; <- aufgerufen von 5FCBh, 5FD2h
                      FD_DLY_LP:
5FD9  1B                      DEC     DE
5FDA  7B                      LD      A,E
5FDB  B2                      OR      D
5FDC  20 FB                   JR      NZ,FD_DLY_LP
5FDE  D1                      POP     DE
5FDF  C9                      RET
                      ;  FD_LASTCMD: letztes Kommando; FD_MOTOR: 1 = Motor läuft;
                      ;  FD_RESTORED..3: je Laufwerk 1 nach dem ersten RESTORE; FD_RETRIES,
                      ;  FD_VRETRIES: verbleibende Versuche.
                      FD_LASTCMD:
5FE0  00                      DEFB    00h                     ; ?? |.|
                      FD_MOTOR:
5FE1  00                      DEFB    00h                     ; ?? |.|
                      FD_RESTORED:
5FE2  00                      DEFB    00h                     ; ?? |.|
                      FD_RESTORED1:
5FE3  00                      DEFB    00h                     ; ?? |.|
                      FD_RESTORED2:
5FE4  00                      DEFB    00h                     ; ?? |.|
                      FD_RESTORED3:
5FE5  00                      DEFB    00h                     ; ?? |.|
                      FD_RETRIES:
5FE6  00                      DEFB    00h                     ; ?? |.|
                      FD_VRETRIES:
5FE7  00                      DEFB    00h                     ; ?? |.|
                      ; >>> SB-6610: ohne Gegenstück in SB-6511
5FE8  FF FF FF FF ..          DEFB    0FFh,0FFh,0FFh,0FFh,0FFh,0FFh,0FFh,0FFh
                      ;  AREA_RESIZE_CLR – Nachtrag am Ende des Codes: AREA_RESIZE, dann die zwei
                      ;  Wörter hinter dem Zeiger (6680h) auf 0 setzen. Nachträgliche Korrektur
                      ;  (ältere Fassung: CALL AREA_RESIZE direkt).
                      ; <- aufgerufen von 50DEh
                      AREA_RESIZE_CLR:
5FF0  CD B3 47                CALL    AREA_RESIZE
5FF3  2A 80 66                LD      HL,(6680h)
5FF6  23                      INC     HL
5FF7  23                      INC     HL
5FF8  36 00                   LD      (HL),00h
5FFA  23                      INC     HL
5FFB  36 00                   LD      (HL),00h
5FFD  C9                      RET
5FFE  00 00                   DEFB    00h,00h
                      
                      ; ==============================================================================
                      ;  ENDE DES CODES
                      ; ==============================================================================
                      ;  6000h-6FFFh: zur Laufzeit Arbeitsbereich des BASIC. Im Abbild stehen
                      ;  Speicherreste: RAM-Muster (16 Bytes 00h/FFh im Wechsel) und Bruchstücke
                      ;  von Assembler-Quelltext aus der Entwicklung bei Sharp.
                              IF      $ > 6000h
                              .ERROR  Code reicht über 6000h (Arbeitsbereich); mit NOJUNK übersetzen oder kürzen
                              ENDIF
                      FILL_FREE:
                              DEFS    6000h-$,00h             ; frei bis 6000h (im Original 0 Bytes)
6000  00 x 16                 DEFS    0010h,00h
6010  FF x 16                 DEFS    0010h,0FFh
6020  00 x 16                 DEFS    0010h,00h
6030  FF x 16                 DEFS    0010h,0FFh
6040  00 x 16                 DEFS    0010h,00h
6050  FF x 16                 DEFS    0010h,0FFh
6060  00 x 16                 DEFS    0010h,00h
6070  FF x 16                 DEFS    0010h,0FFh
6080  00 x 16                 DEFS    0010h,00h
6090  FF x 16                 DEFS    0010h,0FFh
60A0  00 x 16                 DEFS    0010h,00h
60B0  FF x 16                 DEFS    0010h,0FFh
60C0  00 x 16                 DEFS    0010h,00h
60D0  FF x 16                 DEFS    0010h,0FFh
60E0  00 x 16                 DEFS    0010h,00h
60F0  FF x 16                 DEFS    0010h,0FFh
6100  00 x 16                 DEFS    0010h,00h
6110  FF x 16                 DEFS    0010h,0FFh
6120  00 x 16                 DEFS    0010h,00h
6130  FF x 16                 DEFS    0010h,0FFh
6140  00 x 16                 DEFS    0010h,00h
6150  FF x 16                 DEFS    0010h,0FFh
6160  00 x 16                 DEFS    0010h,00h
6170  FF x 16                 DEFS    0010h,0FFh
6180  00 x 16                 DEFS    0010h,00h
6190  FF x 16                 DEFS    0010h,0FFh
61A0  00 x 16                 DEFS    0010h,00h
61B0  FF x 16                 DEFS    0010h,0FFh
61C0  00 x 16                 DEFS    0010h,00h
61D0  FF x 16                 DEFS    0010h,0FFh
61E0  00 x 16                 DEFS    0010h,00h
61F0  FF x 32                 DEFS    0020h,0FFh
6210  00 x 16                 DEFS    0010h,00h
6220  FF x 16                 DEFS    0010h,0FFh
6230  00 x 16                 DEFS    0010h,00h
6240  FF x 16                 DEFS    0010h,0FFh
6250  00 x 16                 DEFS    0010h,00h
6260  FF x 16                 DEFS    0010h,0FFh
6270  00 x 16                 DEFS    0010h,00h
6280  FF x 16                 DEFS    0010h,0FFh
6290  00 x 16                 DEFS    0010h,00h
62A0  FF x 16                 DEFS    0010h,0FFh
62B0  00 x 16                 DEFS    0010h,00h
62C0  FF x 16                 DEFS    0010h,0FFh
62D0  00 x 16                 DEFS    0010h,00h
62E0  FF x 16                 DEFS    0010h,0FFh
62F0  00 x 16                 DEFS    0010h,00h
6300  FF x 16                 DEFS    0010h,0FFh
6310  00 x 16                 DEFS    0010h,00h
