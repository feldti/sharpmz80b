5A33  00 CD C9 4E ..          DEFB    00h,0CDh,0C9h,4Eh,0FEh,0Dh,28h,44h
5A3B  CD 87 19 49 ..          DEFB    0CDh,87h,19h,49h,54h,5Ah,0CDh,5Ch
5A43  19 D2 83 14 ..          DEFB    19h,0D2h,83h,14h,23h,0E6h,0Fh,3Dh
5A4B  FE 02 30 F5 ..          DEFB    0FEh,02h,30h,0F5h,32h,32h,5Ah,18h
5A53  2B CD 87 19 ..          DEFB    2Bh,0CDh,87h,19h,4Fh,94h,5Ah,0CDh
