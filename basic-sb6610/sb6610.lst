2DE5  EB                      EX      DE,HL
                      CHANGE_LOW:
2DE6  CB AE                   RES     5,(HL)
2DE8  23                      INC     HL
2DE9  10 FB                   DJNZ    CHANGE_LOW
2DEB  18 D5                   JR      KLIST_DONE
                      ; ==============================================================================
                      ;  BCD-ARITHMETIK (DOUBLE PRECISION) UND MATHEMATISCHE FUNKTIONEN
                      ; ==============================================================================
                      ;  Zahlformat (9 Bytes):
                      ;    Byte 0-7  Mantisse M, 16 BCD-Ziffern, höchstwertige zuerst
                      ;    Byte 8    Exponentbyte: Bit 7 = Vorzeichen (1 = negativ),
                      ;              Bits 6-0 = E; Wert = M * 10^(E-40h)
                      ;  Ganze Zahlen bis 16 Stellen stehen unnormiert mit E = 40h (1 = 00 .. 01 40),
                      ;  sonst normiert mit führender Ziffer <> 0 (0,5 = 50 00 .. 30). Null: alle
                      ;  9 Bytes 00h. Größter Betrag FP_MAX = 9999999999999999 * 10^3Fh.
                      ;  Die Routinen bekommen meist Zeiger auf das Exponentbyte (Byte 8); die
                      ;  Mantisse liegt in den 8 Bytes darunter. Grundrechenarten: (DE) = (DE) op
                      ;  (HL). Nach jeder Rechnung bringt FP_INTFORM ganzzahlige Ergebnisse wieder
                      ;  auf E = 40h. Überlauf: FP_MAX mit Vorzeichen, Fehler 2; Unterlauf: 0.
                      ;  ^, SIN, COS, TAN, ATN, EXP, LOG und LN gibt es in SB-6610 nicht (Fehler 1);
                      ;  laut Handbuch (2.4.4) stehen BASIC-Unterprogramme dafür in der Datei
                      ;  "FUNCTION" der Systemdiskette. Zahlenbereich laut Handbuch 1E-48 bis
                      ;  9.999999999999999E+78.
                      FPA_FLAG:
2DED  00                      DEFB    00h
                      FPA_SIGN:
2DEE  00                      DEFB    00h
                      FPA_EXP:
2DEF  00                      DEFB    00h
2DF0  00 00 00 00 ..          DEFB    00h,00h,00h,00h,00h
                      ;  FP_TMP1/FP_TMP2: normierte Kopien der Operanden (FP_NORMCOPY), bei
                      ;  SQR Radikand bzw. Rest. NUMBUF: Ausgabetext von NUM2STR (Vorzeichen,
                      ;  Ziffern, Punkt, E+nn, 0Dh) überlagert beide.
                      NUMBUF:
                      FP_TMP1:
2DF5  00 00 00 00 ..          DEFB    00h,00h,00h,00h,00h,00h,00h,00h,00h
                      FP_TMP2:
2DFE  00 00 00 00 ..          DEFB    00h,00h,00h,00h,00h,00h,00h,00h,00h
                      ;  FP_DIG: Ziffernpuffer. MUL: 32-stelliges Produkt gepackt (FP_DIG+1 ..
                      ;  +16); DIV und SQR: eine Ziffer je Byte; NUM2STR: entpackte Mantisse als
                      ;  ASCII-Ziffern.
                      FP_DIG:
2E07  00 00 00 00 ..          DEFB    00h,00h,00h,00h,00h,00h,00h,00h
2E0F  00 00 00 00 ..          DEFB    00h,00h,00h,00h,00h,00h,00h,00h
2E17  00 00                   DEFB    00h,00h
                      FPR_EXP:
2E19  00                      DEFB    00h                     ; Exponent und Vorzeichen des Ergebnisses
                      FPR_PTR:
2E1A  00 00                   DEFW    0000h                   ; Zeiger in FP_DIG bzw. das Ergebnis
                      ;  Konstanten, 9 Bytes: Mantisse (16 BCD-Ziffern, höchstwertige zuerst),
                      ;  dann Exponentbyte. FP_ZERO und FP_MONE überlappen.
2E1C  00 00 00 00 ..  FP_ONE: DEFB    00h,00h,00h,00h,00h,00h,00h,01h,40h     ; 1
                      FP_ZERO:
2E25  00 00                   DEFB    00h,00h                                 ; 0 (bis FP_MONE+6)
                      FP_MONE:
2E27  00 00 00 00 ..          DEFB    00h,00h,00h,00h,00h,00h,00h,01h,0C0h    ; -1
2E30  31 41 59 26 ..  FP_PI:  DEFB    31h,41h,59h,26h,53h,58h,97h,93h,31h     ; 3.141592653589793
2E39  99 99 99 99 ..  FP_MAX: DEFB    99h,99h,99h,99h,99h,99h,99h,99h,7Fh     ; größter Betrag (bei Überlauf)
                      ;  FP_NORM – (HL) normieren (HL zeigt auf das Exponentbyte): führende
                      ;  Null-Bytes und eine führende Null-Ziffer herausschieben, E entsprechend
                      ;  verkleinern. Mantisse 0: Exponent 0, Z gesetzt. Unterlauf (E < 1):
                      ;  FP_SETZERO. Sonst NZ. Die Schiebeweite steht über selbstverändernden
                      ;  Code in FPN_MOVCNT..FPN_EXPMIN.
                      ; <- aufgerufen von 2EC7h, 2ECEh, 3004h, 30B3h, 32EEh, 3502h, 360Eh, 367Eh
                      FP_NORM:
2E42  7E                      LD      A,(HL)                  ; Exponentbyte 0: Wert ist 0
2E43  A7                      AND     A
2E44  CA D2 2F                JP      Z,FP_SETZERO
2E47  E5                      PUSH    HL
2E48  D5                      PUSH    DE
2E49  01 F8 FF        FPN_LOOP:  LD      BC,0FFF8h            ; HL -> höchstes Mantissenbyte
2E4C  09                      ADD     HL,BC
2E4D  7E                      LD      A,(HL)
2E4E  A7                      AND     A
2E4F  20 3F                   JR      NZ,FPN_NIBBLE           ; höchstes Byte <> 0: nur noch Ziffern prüfen
2E51  54                      LD      D,H
2E52  5D                      LD      E,L
2E53  0E 00                   LD      C,00h                   ; C = Zahl der Null-Bytes
2E55  06 08                   LD      B,08h
2E57  7E              FPN_CNTZERO:  LD      A,(HL)
2E58  A7                      AND     A
2E59  20 09                   JR      NZ,FPN_SHBYTES
2E5B  23                      INC     HL
2E5C  0C                      INC     C
2E5D  10 F8                   DJNZ    FPN_CNTZERO
2E5F  36 00                   LD      (HL),00h                ; Mantisse ganz 0: Exponent 0
2E61  AF                      XOR     A                       ; A = 0, Z
2E62  18 45                   JR      FPN_RET
2E64  3E 08           FPN_SHBYTES:  LD      A,08h             ; 8 - C Bytes nach oben schieben ...
2E66  91                      SUB     C
2E67  32 79 2E                LD      (FPN_MOVCNT+1),A
2E6A  79                      LD      A,C
2E6B  32 7E 2E                LD      (FPN_FILLCNT+1),A       ; ... C Bytes mit 0 auffüllen ...
2E6E  87                      ADD     A,A
2E6F  32 8C 2E                LD      (FPN_EXPSUB+1),A        ; ... Exponent um 2*C verkleinern (Grenze 2*C+1)
2E72  3C                      INC     A
2E73  32 87 2E                LD      (FPN_EXPMIN+1),A
2E76  06 00                   LD      B,00h
2E78  0E 00           FPN_MOVCNT:  LD      C,00h
2E7A  ED B0                   LDIR
2E7C  EB                      EX      DE,HL
2E7D  06 00           FPN_FILLCNT:  LD      B,00h
2E7F  71              FPN_FILL:  LD      (HL),C
2E80  23                      INC     HL
2E81  10 FC                   DJNZ    FPN_FILL
2E83  7E                      LD      A,(HL)
2E84  E6 7F                   AND     7Fh
2E86  FE 00           FPN_EXPMIN:  CP      00h                ; Exponent zu klein: Unterlauf
2E88  38 22                   JR      C,FPN_UNDER
2E8A  7E                      LD      A,(HL)
2E8B  D6 00           FPN_EXPSUB:  SUB     00h
2E8D  77                      LD      (HL),A
2E8E  18 B9                   JR      FPN_LOOP                ; erneut prüfen
2E90  E6 F0           FPN_NIBBLE:  AND     0F0h               ; führende Ziffer <> 0: fertig
2E92  20 15                   JR      NZ,FPN_RET
2E94  ED 42                   SBC     HL,BC                   ; HL wieder auf den Exponenten
2E96  7E                      LD      A,(HL)
2E97  E6 7F                   AND     7Fh
2E99  FE 02                   CP      02h
2E9B  38 0F                   JR      C,FPN_UNDER
2E9D  35                      DEC     (HL)                    ; Exponent - 1, Mantisse eine Ziffer nach links
2E9E  06 08                   LD      B,08h
2EA0  AF                      XOR     A
2EA1  2B              FPN_RLD: DEC     HL
2EA2  ED 6F                   RLD
2EA4  10 FB                   DJNZ    FPN_RLD
2EA6  3E 01                   LD      A,01h                   ; NZ: Wert <> 0
2EA8  A7                      AND     A
2EA9  D1              FPN_RET: POP     DE
2EAA  E1                      POP     HL
2EAB  C9                      RET
2EAC  D1              FPN_UNDER: POP     DE
2EAD  E1                      POP     HL
2EAE  C3 D2 2F                JP      FP_SETZERO
                      ;  FP_NORMCOPY – beide Operanden normiert kopieren: (HL) nach FP_TMP1,
                      ;  (DE) nach FP_TMP2 (Zeiger jeweils auf das Exponentbyte). Ergebnis:
                      ;  DE -> FP_TMP1+8 (Kopie von HL), HL -> FP_TMP2+8 (Kopie von DE).
                      ; <- aufgerufen von 30F4h, 346Ch
                      FP_NORMCOPY:
2EB1  D5                      PUSH    DE
2EB2  11 FD 2D                LD      DE,FP_TMP1+8            ; (HL) -> FP_TMP1
2EB5  D5                      PUSH    DE
2EB6  01 09 00                LD      BC,0009h
2EB9  ED B8                   LDDR
2EBB  D1                      POP     DE
2EBC  E1                      POP     HL
2EBD  D5                      PUSH    DE
2EBE  11 06 2E                LD      DE,FP_TMP2+8            ; (DE) -> FP_TMP2
2EC1  01 09 00                LD      BC,0009h
2EC4  ED B8                   LDDR
2EC6  E1                      POP     HL
2EC7  CD 42 2E                CALL    FP_NORM                 ; beide normieren
2ECA  EB                      EX      DE,HL
2ECB  21 06 2E                LD      HL,FP_TMP2+8
2ECE  C3 42 2E                JP      FP_NORM
                      ;  FP_SHR1 – Mantisse von (HL) um eine Ziffer nach rechts, E + 1.
                      ;  A = herausgeschobene Ziffer, CY = 1 wenn sie >= 5 ist (aufrunden).
                      ; <- aufgerufen von 2F0Ch, 2F11h, 2F93h
                      FP_SHR1:
2ED1  34                      INC     (HL)                    ; Exponent + 1
2ED2  01 F8 FF                LD      BC,0FFF8h
2ED5  09                      ADD     HL,BC
2ED6  AF                      XOR     A
2ED7  06 08                   LD      B,08h
2ED9  ED 67           FSR1_LP: RRD                            ; Ziffern von oben nach unten durchschieben, A = letzte
2EDB  23                      INC     HL
2EDC  10 FB                   DJNZ    FSR1_LP
2EDE  FE 05                   CP      05h                     ; CY = herausgeschobene Ziffer >= 5
2EE0  3F                      CCF
2EE1  C9                      RET
                      ;  FSRN_BYTES – Teil von FP_SHRN: Mantisse um ganze Bytes nach rechts
                      ;  (Weite über selbstverändernden Code), CY = 1 wenn das letzte
                      ;  herausgeschobene Byte >= 50h ist.
                      ; <- aufgerufen von 2F2Dh
                      FSRN_BYTES:
2EE2  E5                      PUSH    HL
2EE3  D5                      PUSH    DE
2EE4  7E                      LD      A,(HL)
2EE5  C6 08           FSRB_EXPADD: ADD     A,08h              ; Exponent + 2*Bytes (Operand aus FP_SHRN)
2EE7  77                      LD      (HL),A
2EE8  2B                      DEC     HL
2EE9  54                      LD      D,H
2EEA  5D                      LD      E,L
2EEB  01 FD FF        FSRB_SRCOFS: LD      BC,0FFFDh          ; Quelle = Ziel - Bytes
2EEE  09                      ADD     HL,BC
2EEF  7E                      LD      A,(HL)
2EF0  2B                      DEC     HL
2EF1  01 04 00        FSRB_MOVCNT: LD      BC,0004h           ; 8 - Bytes Bytes verschieben
2EF4  ED B8                   LDDR
2EF6  EB                      EX      DE,HL
2EF7  06 04           FSRB_FILLCNT: LD      B,04h             ; oben mit 0 füllen
2EF9  71              FSRB_FILL: LD      (HL),C
2EFA  2B                      DEC     HL
2EFB  10 FC                   DJNZ    FSRB_FILL
2EFD  D1                      POP     DE
2EFE  E1                      POP     HL
2EFF  FE 50                   CP      50h                     ; CY = letztes herausgeschobenes Byte >= 50h
2F01  3F                      CCF
2F02  C9                      RET
                      ;  FP_SHRN – Mantisse von (HL) um A Ziffern nach rechts, E + A (A >= 16:
                      ;  Wert 0). Ungerade Weite zuerst eine Ziffer mit FP_SHR1, dann ganze
                      ;  Bytes mit FSRN_BYTES. CY: aufrunden.
                      ; <- aufgerufen von 2F71h, 3028h
                      FP_SHRN:
2F03  FE 10                   CP      10h                     ; 16 Ziffern oder mehr: Ergebnis 0
2F05  D2 D2 2F                JP      NC,FP_SETZERO
2F08  CB 2F                   SRA     A                       ; A = Bytes, CY = ungerade
2F0A  20 04                   JR      NZ,FSRN_BYTES1
2F0C  DC D1 2E                CALL    C,FP_SHR1               ; nur eine Ziffer
2F0F  C9                      RET
2F10  F5              FSRN_BYTES1: PUSH    AF
2F11  DC D1 2E                CALL    C,FP_SHR1
2F14  F1                      POP     AF
2F15  32 F8 2E                LD      (FSRB_FILLCNT+1),A      ; Schiebeweiten in FSRN_BYTES eintragen
2F18  4F                      LD      C,A
2F19  87                      ADD     A,A
2F1A  32 E6 2E                LD      (FSRB_EXPADD+1),A
2F1D  3E 08                   LD      A,08h
2F1F  91                      SUB     C
2F20  32 F2 2E                LD      (FSRB_MOVCNT+1),A
2F23  D6 08                   SUB     08h
2F25  4F                      LD      C,A
2F26  06 FF                   LD      B,0FFh
2F28  03                      INC     BC
2F29  ED 43 EC 2E             LD      (FSRB_SRCOFS+1),BC
2F2D  C3 E2 2E                JP      FSRN_BYTES
                      ;  MANT_INCNC – Mantisse unterhalb von HL um 1 - CY erhöhen (Rundung mit
