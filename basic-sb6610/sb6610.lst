0F09  20 05                   JR      NZ,MUS_NOTE
0F0B  21 AC 0F                LD      HL,NOTETAB2
0F0E  3C                      INC     A
0F0F  13                      INC     DE
                      MUS_NOTE:
0F10  32 3D 10                LD      (MUS_SHARP),A
