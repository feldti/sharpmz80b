5AB3  11 16 00 5F ..          DEFB    11h,16h,00h,5Fh,0E5h,0C3h,50h,2Ah
5ABB  CD 95 19 48 ..          DEFB    0CDh,95h,19h,48h,3Ah,0D1h,11h,18h
5AC3  F0 CD 87 19 ..          DEFB    0F0h,0CDh,87h,19h,56h,0D0h,5Ah,0EDh
