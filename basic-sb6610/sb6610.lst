2D19  44                      LD      B,H
2D1A  4D                      LD      C,L
2D1B  EB                      EX      DE,HL
2D1C  E3                      EX      (SP),HL
2D1D  E5                      PUSH    HL
2D1E  09                      ADD     HL,BC
2D1F  EB                      EX      DE,HL
