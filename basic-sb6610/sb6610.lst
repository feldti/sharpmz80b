0E5E  DB E6                   IN      A,(PIT_C2)
0E60  47                      LD      B,A
0E61  DB E5                   IN      A,(PIT_C1)
0E63  5F                      LD      E,A
0E64  DB E5                   IN      A,(PIT_C1)
0E66  57                      LD      D,A
