0F1B  3E 02                   LD      A,02h
0F1D  32 6F 11                LD      (MUS_OCTAVE),A
0F20  38 0E                   JR      C,MUS_END
0F22  18 CD                   JR      MUS_LOOP
                      MUS_LOW:
0F24  3E 03                   LD      A,03h
                      MUS_SETOCT:
