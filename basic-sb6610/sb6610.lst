15A2  D1                      POP     DE
15A3  28 F1                   JR      Z,CR_PUT1
15A5  23                      INC     HL
15A6  13                      INC     DE
15A7  C9                      RET
                      ;  KWSEARCH – Schlüsselwort ab (HL) in der Tabelle (DE) suchen, B = 80h.
                      ;  KWSEARCH_B: dasselbe mit Startnummer B. Leerzeichen in Eingabe und
                      ;  Tabelle werden überlesen. Treffer: Z, B = Nummer des Eintrags, HL hinter
                      ;  dem Wort. Kein Treffer: NZ, HL unverändert. Das letzte Zeichen eines
                      ;  Eintrags hat Bit 7 gesetzt, 00h beendet die Tabelle.
                      ; <- aufgerufen von 1573h, 158Ch, 2BBBh
                      KWSEARCH:
15A8  06 80                   LD      B,80h
                      ; <- aufgerufen von 159Fh, 42B6h, 4B1Ch, 4B88h
                      KWSEARCH_B:
15AA  E5                      PUSH    HL
                      KWS_CMP:
15AB  CD B6 18                CALL    SKIPSP
15AE  B7                      OR      A
15AF  FA D2 15                JP      M,KWS_HIBIT
15B2  EB                      EX      DE,HL
15B3  CD B6 18                CALL    SKIPSP
15B6  EB                      EX      DE,HL
15B7  96                      SUB     (HL)
15B8  23                      INC     HL
15B9  13                      INC     DE
15BA  28 EF                   JR      Z,KWS_CMP
15BC  C6 80                   ADD     A,80h
15BE  20 03                   JR      NZ,KWS_NEXT
15C0  33                      INC     SP
15C1  33                      INC     SP
15C2  C9                      RET
                      KWS_NEXT:
15C3  E1                      POP     HL
15C4  1B                      DEC     DE
                      ; <- aufgerufen von 15CAh
                      KWS_SKIP:
15C5  1A                      LD      A,(DE)
15C6  13                      INC     DE
15C7  B7                      OR      A
15C8  28 06                   JR      Z,KWS_END
15CA  F2 C5 15                JP      P,KWS_SKIP
15CD  04                      INC     B
15CE  18 DA                   JR      KWSEARCH_B
                      KWS_END:
15D0  3D                      DEC     A
15D1  C9                      RET
                      ; <- aufgerufen von 15AFh
                      KWS_HIBIT:
15D2  E1                      POP     HL
15D3  CD B6 18                CALL    SKIPSP
15D6  3D                      DEC     A
15D7  7E                      LD      A,(HL)
15D8  C9                      RET
                      ; <- aufgerufen von 1322h, 1E95h
                      LISTLINE:
15D9  2A 10 61                LD      HL,(TOKLNUM)
15DC  11 0D 60                LD      DE,INBUF
15DF  0E 62                   LD      C,62h
15E1  CD 76 19                CALL    NUM2DEC_C
15E4  3E 20                   LD      A,20h                   ; ' '
15E6  12                      LD      (DE),A
