0EE4  7A                      LD      A,D
0EE5  B3                      OR      E
0EE6  20 FB                   JR      NZ,SPK_DELAY
0EE8  C9                      RET
                      ;  MUSIC_PLAY – Text (DE) spielen, bis 0Dh oder "*". Je Note: Buchstabe
                      ;  C D E F G A B oder R (Pause), "#" davor für den Halbton, "-"/"+" davor
                      ;  für die tiefe/hohe Oktave (sonst mittlere), danach optional die Länge
                      ;  0-9 (gilt auch für folgende Noten, MV_NOTELEN). Unbekannte Zeichen
                      ;  werden übergangen, BREAK bricht ab (C gesetzt).
                      ; <- aufgerufen von 24FAh
                      MUSIC_PLAY:
0EE9  C5                      PUSH    BC
0EEA  D5                      PUSH    DE
0EEB  E5                      PUSH    HL
0EEC  3E 02                   LD      A,02h
0EEE  32 6F 11                LD      (MUS_OCTAVE),A
                      MUS_LOOP:
0EF1  1A                      LD      A,(DE)
0EF2  FE 0D                   CP      0Dh
0EF4  28 3A                   JR      Z,MUS_END
0EF6  FE 2A                   CP      2Ah                     ; '*'
0EF8  28 36                   JR      Z,MUS_END
0EFA  FE 2D                   CP      2Dh                     ; '-'
0EFC  28 26                   JR      Z,MUS_LOW
0EFE  FE 2B                   CP      2Bh                     ; '+'
