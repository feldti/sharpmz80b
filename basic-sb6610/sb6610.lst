                      CONS_NORM:
58AF  CD 1B 19                CALL    SYNCHK
58B2  4E              D58B2:  DEFB    4Eh                     ; Inline-Parameter 'N'
58B3  3A 50 11                LD      A,(PPI_A_COPY)
58B6  CB E7                   SET     4,A
58B8  18 ED                   JR      CONS_SETPPI
                      PAT_NEXT:
58BA  E1                      POP     HL                      ; Rücksprung nach PAT_DRAW: Textzeiger, nächstes Muster
                      ;  PATTERN [-]n, muster$ [, ...] – Bitmuster an der Grafikposition zeichnen
                      ;  (PAT_DRAW), n = 1-24 Zeilen; mit "-" in der Gegenrichtung (Schrittweite
                      ;  und ADD/SBC werden in PAT_STRIDE/PAT_STEP eingesetzt).
                      ST_PATTERN:
58BB  CD B3 1A                CALL    CHRGET
58BE  CA 02 1D                JP      Z,NEXTSTMT_HL
58C1  CD 7C 4B                CALL    SKIPCOMMA
58C4  CD 0D 19                CALL    CHK_CHR_ALT
58C7  2D              D58C7:  DEFB    2Dh                     ; Inline-Parameter '-'
58C8  D2 58           D58C8:  DEFW    PAT_UP
58CA  E5                      PUSH    HL
58CB  21 09 00                LD      HL,0009h                ; Befehlsbytes 09h,00h = ADD HL,BC / NOP
58CE  3E 27                   LD      A,27h                   ; Schrittweite 39 statt 41 (PAT_STRIDE)
58D0  18 06                   JR      PAT_PATCH
58D2  E5              PAT_UP: PUSH    HL
58D3  21 ED 42                LD      HL,42EDh                ; Befehlsbytes EDh,42h = SBC HL,BC (Original bei PAT_STEP/PAT_STEP2)
58D6  3E 29                   LD      A,29h                   ; ')'
                      PAT_PATCH:
58D8  32 30 57                LD      (PAT_STRIDE+1),A
58DB  22 33 57                LD      (PAT_STEP),HL
58DE  22 69 57                LD      (PAT_STEP2),HL
