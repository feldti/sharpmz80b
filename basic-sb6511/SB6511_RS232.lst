5A58  CD 6E 5A                CALL    CHK_ROW
5A5B  F1                      POP     AF
5A5C  BB                      CP      E
5A5D  30 15                   JR      NC,CONS_ERR
5A5F  32 0B 00                LD      (000Bh),A
5A62  7B                      LD      A,E
5A63  32 0C 00                LD      (000Ch),A
