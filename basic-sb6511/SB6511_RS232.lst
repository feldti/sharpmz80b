63DA  28 0D                   JR      Z,RDS_SERPOLL
63DC  DB C1                   IN      A,(GP_C1)
63DE  E6 60                   AND     60h
63E0  FE 60                   CP      60h                     ; '`'
63E2  CA 76 14                JP      Z,ERR_38
                      RDS_RET:
63E5  7E                      LD      A,(HL)
63E6  C3 3A 62                JP      GP_RETVAL
                      RDS_SERPOLL:
63E9  3A FB 63                LD      A,(RQS_BYTE)
63EC  CD 99 64                CALL    GP_SENDBYTE
63EF  DB C1                   IN      A,(GP_C1)
63F1  CB 97                   RES     2,A
63F3  D3 C1                   OUT     (GP_C1),A
63F5  AF                      XOR     A
63F6  D3 C4                   OUT     (GP_C4),A
63F8  C3 07 63                JP      RDS_WAIT
                      RQS_BYTE:
63FB  00                      DEFB    00h                     ; ?? |.|
                      ;  RQSMSG= n – Statusbyte für den Serial Poll (RQS_BYTE).
                      ;  SSRQ – Service Request auslösen (Port C1 Bit 2).
                      ST_RQSMSG:
63FC  CD B7 20                CALL    EVAL_BYTE
63FF  7B                      LD      A,E
6400  32 FB 63                LD      (RQS_BYTE),A
6403  C3 00 1D                JP      NEXTSTMT_HL
                      ;  EOI R n[,m] / EOI W n[,m] – Endezeichen für RED bzw. WRT (zweites
                      ;  Zeichen optional; FFh = keins). Vorgabe: WRT 0Dh,0Ah; RED 0Ah.
6406  CD 5D 19        ST_EOI: CALL    CHK_CHR_ALT
6409  52              D6409:  DEFB    52h                     ; Inline-Parameter 'R'
640A  2F 64           D640A:  DEFW    EOI_WRITE
640C  E5                      PUSH    HL
640D  21 4B 65                LD      HL,EOI_RCHR1
                      EOI_SET:
6410  22 1D 64                LD      (EOI_SET1+1),HL
6413  23                      INC     HL
6414  22 2A 64                LD      (EOI_SET2+1),HL
6417  E1                      POP     HL
6418  CD B7 20                CALL    EVAL_BYTE
641B  7B                      LD      A,E
                      EOI_SET1:
641C  32 4B 65                LD      (EOI_RCHR1),A
641F  CD 5D 19                CALL    CHK_CHR_ALT
6422  2C              D6422:  DEFB    2Ch                     ; Inline-Parameter ','
6423  00 1D           D6423:  DEFW    NEXTSTMT_HL
6425  CD B7 20                CALL    EVAL_BYTE
6428  7B                      LD      A,E
                      EOI_SET2:
6429  32 4C 65                LD      (EOI_RCHR2),A
642C  C3 00 1D                JP      NEXTSTMT_HL
                      ; <- aufgerufen von 6406h
                      EOI_WRITE:
642F  CD 6B 19                CALL    SYNCHK
6432  57              D6432:  DEFB    57h                     ; Inline-Parameter 'W'
6433  E5                      PUSH    HL
6434  21 49 65                LD      HL,EOI_WCHR1
6437  18 D7                   JR      EOI_SET
                      ST_SSRQ:
6439  DB C1                   IN      A,(GP_C1)
643B  CB D7                   SET     2,A
643D  D3 C1                   OUT     (GP_C1),A
643F  C3 00 1D                JP      NEXTSTMT_HL
                      ; <- aufgerufen von 6285h, 644Bh
                      GP_DELAY:
6442  3D                      DEC     A
6443  00                      NOP
6444  C2 42 64                JP      NZ,GP_DELAY
6447  C9                      RET
                      ; <- aufgerufen von 5F83h, 5F97h
                      GP_DELAY22:
6448  F5                      PUSH    AF
6449  3E 16                   LD      A,16h
644B  CD 42 64                CALL    GP_DELAY
644E  F1                      POP     AF
644F  C9                      RET
                      ; <- aufgerufen von 6470h
                      GPIB_WAIT:
6450  3A 4F 65                LD      A,(GP_MODE)
6453  CB 77                   BIT     6,A
6455  28 16                   JR      Z,GP_ERR34
6457  18 07                   JR      CHK_IFREADY
                      ;  CHK_SYSCTRL / CHK_IFREADY / CHK_NOTCTRL – Betriebsart prüfen: nur als
                      ;  Controller bzw. nur als Gerät (sonst Fehler 34); Port C1 Bit 7 gesetzt:
                      ;  Fehler 35.
                      ; <- aufgerufen von 5F4Eh, 5F80h, 5F8Ch
                      CHK_SYSCTRL:
6459  3A 4F 65                LD      A,(GP_MODE)
645C  CB 7F                   BIT     7,A
645E  28 0D                   JR      Z,GP_ERR34
                      ; <- aufgerufen von 5FA8h, 6097h
                      CHK_IFREADY:
6460  DB C1                   IN      A,(GP_C1)
6462  07                      RLCA
6463  D0                      RET     NC
6464  C3 6D 14                JP      ERR_35
                      ; <- aufgerufen von 62F0h
                      CHK_NOTCTRL:
6467  3A 4F 65                LD      A,(GP_MODE)
646A  CB 77                   BIT     6,A
646C  C8                      RET     Z
                      GP_ERR34:
646D  C3 6A 14                JP      ERR_34
                      ;  ATN_ON / ATN_OFF – ATN setzen bzw. löschen (Port C1 Bit 3): die
                      ;  folgenden Bytes sind Befehle/Adressen.
                      ; <- aufgerufen von 5F09h, 5F25h, 5F32h, 5F41h, 5F57h, 5F5Eh, 5FB6h, 60A2h (+5 weitere)
6470  CD 50 64        ATN_ON: CALL    GPIB_WAIT
                      ; <- aufgerufen von 620Fh
