5B30  E6 0F                   AND     0Fh
5B32  3D                      DEC     A
5B33  FE 02                   CP      02h
5B35  30 F5                   JR      NC,GRAPH_ERR
5B37  32 1A 5B                LD      (GRPH_IN),A
5B3A  18 2B                   JR      GRAPH_SET
                      ; <- aufgerufen von 5B23h
                      GRAPH_OUTARG:
5B3C  CD 5D 19                CALL    CHK_CHR_ALT
5B3F  4F              D5B3F:  DEFB    4Fh                     ; Inline-Parameter 'O'
5B40  7C 5B           D5B40:  DEFW    GRAPH_C
5B42  CD 32 19                CALL    ISDIGIT
5B45  38 03                   JR      C,GRAPH_O1
5B47  3E 00                   LD      A,00h
5B49  2B                      DEC     HL
                      GRAPH_O1:
5B4A  23                      INC     HL
5B4B  E6 0F                   AND     0Fh
5B4D  FE 03                   CP      03h
5B4F  30 DB                   JR      NC,GRAPH_ERR
5B51  47                      LD      B,A
5B52  CD 32 19                CALL    ISDIGIT
5B55  38 03                   JR      C,GRAPH_O2
5B57  3E 00                   LD      A,00h
5B59  2B                      DEC     HL
                      GRAPH_O2:
5B5A  23                      INC     HL
5B5B  E6 0F                   AND     0Fh
5B5D  FE 03                   CP      03h
5B5F  30 CB                   JR      NC,GRAPH_ERR
5B61  B0                      OR      B
5B62  CB 27                   SLA     A
5B64  32 1B 5B                LD      (GRPH_OUT),A
                      GRAPH_SET:
5B67  3A 1A 5B                LD      A,(GRPH_IN)
5B6A  47                      LD      B,A
5B6B  3A 1B 5B                LD      A,(GRPH_OUT)
5B6E  B0                      OR      B
5B6F  32 19 5B                LD      (GRPH_PORT),A
5B72  D3 F4                   OUT     (GRPH),A
5B74  CD 03 1B                CALL    CHRGET
5B77  20 A3                   JR      NZ,ST_GRAPH
5B79  C3 00 1D                JP      NEXTSTMT_HL
                      ; <- aufgerufen von 5B3Ch
                      GRAPH_C:
5B7C  CD 5D 19                CALL    CHK_CHR_ALT
5B7F  43              D5B7F:  DEFB    43h                     ; Inline-Parameter 'C'
5B80  89 5B           D5B80:  DEFW    GRAPH_F
5B82  E5                      PUSH    HL
5B83  CD 82 58                CALL    GR_CLEAR
                      GRAPH_CF_RET:
5B86  E1                      POP     HL
5B87  18 DE                   JR      GRAPH_SET
                      ; <- aufgerufen von 5B7Ch
                      GRAPH_F:
5B89  CD 6B 19                CALL    SYNCHK
5B8C  46              D5B8C:  DEFB    46h                     ; Inline-Parameter 'F'
5B8D  E5                      PUSH    HL
5B8E  CD 7B 58                CALL    GR_FILL
5B91  18 F3                   JR      GRAPH_CF_RET
                      ;  CSRV / CSRH – Cursorzeile bzw. -spalte des Textbildschirms.
                      ;  POSV / POSH – Grafikposition y bzw. x.
5B93  CD 5D 19        FN_CSR: CALL    CHK_CHR_ALT
5B96  56              D5B96:  DEFB    56h                     ; Inline-Parameter 'V'
5B97  A3 5B           D5B97:  DEFW    CSR_H
5B99  3A 52 11                LD      A,(CSR_Y)
                      CSR_RET:
5B9C  16 00                   LD      D,00h
5B9E  5F                      LD      E,A
                      POS_RET:
5B9F  E5                      PUSH    HL
5BA0  C3 7F 2A                JP      RET_DE
                      ; <- aufgerufen von 5B93h
5BA3  CD 6B 19        CSR_H:  CALL    SYNCHK
5BA6  48              D5BA6:  DEFB    48h                     ; Inline-Parameter 'H'
5BA7  3A 51 11                LD      A,(CSR_XY)
5BAA  18 F0                   JR      CSR_RET
5BAC  CD 5D 19        FN_POS: CALL    CHK_CHR_ALT
5BAF  56              D5BAF:  DEFB    56h                     ; Inline-Parameter 'V'
5BB0  B8 5B           D5BB0:  DEFW    POS_H
5BB2  ED 5B 97 59             LD      DE,(GR_Y)
5BB6  18 E7                   JR      POS_RET
                      ; <- aufgerufen von 5BACh
5BB8  CD 6B 19        POS_H:  CALL    SYNCHK
5BBB  48              D5BBB:  DEFB    48h                     ; Inline-Parameter 'H'
5BBC  ED 5B 95 59             LD      DE,(GR_X)
5BC0  18 DD                   JR      POS_RET
                      ;  CHARACTER$(x,y) – Zeichen an Textposition x (kleiner als die
                      ;  Zeilenbreite), y (0-24) als String; sonst Fehler 3.
                      FN_CHARACTER:
5BC2  CD 98 20                CALL    EVAL_INT
5BC5  3A B5 07                LD      A,(ADD_WIDTH+1)
5BC8  32 D0 5B                LD      (CHARS_MAXX+1),A
5BCB  32 F0 5B                LD      (CHARS_WIDTH+1),A
5BCE  7B                      LD      A,E
                      CHARS_MAXX:
5BCF  FE FF                   CP      0FFh
                      CHARS_ERR:
5BD1  D2 0D 14                JP      NC,ERR_03
5BD4  F5                      PUSH    AF
5BD5  CD 6B 19                CALL    SYNCHK
5BD8  2C              D5BD8:  DEFB    2Ch                     ; Inline-Parameter ','
5BD9  CD B7 20                CALL    EVAL_BYTE
5BDC  CD 6B 19                CALL    SYNCHK
5BDF  29              D5BDF:  DEFB    29h                     ; Inline-Parameter ')'
5BE0  7B                      LD      A,E
5BE1  FE 19                   CP      19h
5BE3  30 EC                   JR      NC,CHARS_ERR
5BE5  F1                      POP     AF
5BE6  4F                      LD      C,A
5BE7  43                      LD      B,E
5BE8  04                      INC     B
5BE9  E5                      PUSH    HL
5BEA  21 00 D0                LD      HL,0D000h
5BED  16 00                   LD      D,00h
                      CHARS_WIDTH:
5BEF  1E FF                   LD      E,0FFh
5BF1  AF                      XOR     A
5BF2  ED 52                   SBC     HL,DE
                      CHARS_ROWLP:
5BF4  19                      ADD     HL,DE
5BF5  10 FD                   DJNZ    CHARS_ROWLP
5BF7  09                      ADD     HL,BC
5BF8  CD 68 0C                CALL    VRAM_RD
5BFB  E1                      POP     HL
5BFC  01 01 00                LD      BC,0001h
5BFF  C3 C7 2A                JP      STR_FILL
                      ;  FD_READ / FD_WRITE – Einsprünge des Floppy-Treibers für DISK_RW.
                      ;  FD_READ / FD_WRITE – Sektoren lesen/schreiben, Einsprung aus DISK_RW
                      ;  mit IX = DISK_PAR:
                      ;    +0 Laufwerk (0-3)       +1/+2 logischer Startsektor   +3/+4 Bytes
                      ;    +5/+6 Speicheradresse   +7/+8 Spur/Sektor in Arbeit   +9/+10 Startspur/-sektor
                      ;  16 Sektoren zu 256 Bytes je Spur; logische Spur / 2 = Zylinder, Bit 0 =
                      ;  Seite. Der MB8876 hat einen invertierten Datenbus: alle Werte werden
                      ;  vor OUT und nach IN mit CPL umgedreht. Fehler gehen über (IY-1)/JP (IY)
                      ;  an den mit SET_IOERR gesetzten Behandler.
                      FD_READ:
5C02  C3 BA 5C                JP      FDR_START
                      FD_WRITE:
5C05  C3 0D 5D                JP      FDW_START
                      
                      ; ==============================================================================
                      ;  FLOPPY-TREIBER (MB8876, Ports D8h-DDh)
                      ; ==============================================================================
                      ;  FD_MOTOR_OFF – Laufwerke abwählen, Motor aus, "zurückgesetzt"-Flags
                      ;  löschen (FD_RESET).
                      ; <- aufgerufen von 128Eh, 4306h, 44DBh, 4884h, 4A5Bh, 532Ah, 534Ch
                      FD_MOTOR_OFF:
5C08  C3 5F 5C                JP      FD_RESET
                      ;  FD_SELECT – Motor einschalten (beim ersten Mal mit Anlaufzeit,
                      ;  FD_MOTORON), Laufwerk (IX+0) wählen (Port DCh: Bit 7 Motor, Bit 2
                      ;  Auswahl, Bit 0-1 Laufwerk), auf "bereit" warten (sonst Fehler 50);
                      ;  beim ersten Zugriff auf das Laufwerk RESTORE (Spur 0).
                      ; <- aufgerufen von 5D7Ah, 5E00h
                      FD_SELECT:
5C0B  3A E8 5E                LD      A,(FD_MOTOR)
5C0E  0F                      RRCA
5C0F  D4 46 5C                CALL    NC,FD_MOTORON
5C12  DD 7E 00                LD      A,(IX+0)
5C15  F6 84                   OR      84h
5C17  D3 DC                   OUT     (FDD_SEL),A
5C19  AF                      XOR     A
5C1A  32 E7 5E                LD      (FD_LASTCMD),A
5C1D  CD DC 5E                CALL    FD_DLY_L
5C20  21 00 00                LD      HL,0000h
                      FD_WAITRDY:
5C23  2B                      DEC     HL
5C24  7C                      LD      A,H
5C25  B5                      OR      L
5C26  28 19                   JR      Z,FD_NOTRDY
5C28  DB D8                   IN      A,(FDC_CMD)
5C2A  2F                      CPL
5C2B  07                      RLCA
5C2C  38 F5                   JR      C,FD_WAITRDY
5C2E  DD 4E 00                LD      C,(IX+0)
5C31  21 E9 5E                LD      HL,FD_RESTORED
5C34  06 00                   LD      B,00h
5C36  09                      ADD     HL,BC
5C37  CB 46                   BIT     0,(HL)
5C39  20 05                   JR      NZ,FD_SEL_RET
5C3B  CD 75 5C                CALL    FD_RESTORE
5C3E  CB C6                   SET     0,(HL)
                      FD_SEL_RET:
5C40  C9                      RET
                      FD_NOTRDY:
5C41  3E 32                   LD      A,32h                   ; '2'
5C43  C3 A9 5E                JP      FD_ERRA
                      ; <- aufgerufen von 5C0Fh
                      FD_MOTORON:
5C46  3E 80                   LD      A,80h
5C48  D3 DC                   OUT     (FDD_SEL),A
5C4A  06 10                   LD      B,10h
                      FD_MOTOR_DLY:
5C4C  CD DC 5E                CALL    FD_DLY_L
5C4F  10 FB                   DJNZ    FD_MOTOR_DLY
5C51  3E 01                   LD      A,01h
5C53  32 E8 5E                LD      (FD_MOTOR),A
5C56  C9                      RET
                      ;  FD_SEEK – SEEK (1Bh) zur Spur im Datenregister. NZ bei Fehlerbits.
                      ; <- aufgerufen von 5CC3h, 5D16h, 5E18h
                      FD_SEEK:
5C57  3E 1B                   LD      A,1Bh
5C59  CD 82 5C                CALL    FD_CMDWAIT
5C5C  E6 99                   AND     99h
5C5E  C9                      RET
                      ; <- aufgerufen von 5EACh
                      FD_RESET:
5C5F  CD D5 5E                CALL    FD_DLY_M
5C62  AF                      XOR     A
5C63  D3 DC                   OUT     (FDD_SEL),A
5C65  32 E9 5E                LD      (FD_RESTORED),A
5C68  32 EA 5E                LD      (FD_RESTORED1),A
5C6B  32 EB 5E                LD      (FD_RESTORED2),A
5C6E  32 EC 5E                LD      (FD_RESTORED3),A
5C71  32 E8 5E                LD      (FD_MOTOR),A
5C74  C9                      RET
                      ;  FD_RESTORE – RESTORE (0Bh), Kopf auf Spur 0; Fehler: FD_ERROR.
                      ; <- aufgerufen von 5C3Bh, 5DC5h, 5E73h
                      FD_RESTORE:
5C75  3E 0B                   LD      A,0Bh
5C77  CD 82 5C                CALL    FD_CMDWAIT
5C7A  E6 85                   AND     85h
5C7C  EE 04                   XOR     04h
5C7E  C8                      RET     Z
5C7F  C3 7A 5E                JP      FD_ERROR
                      ;  FD_CMDWAIT – Kommando A ausgeben (FD_LASTCMD), auf "nicht beschäftigt"
                      ;  warten, Status nach FD_STATUS.
                      ; <- aufgerufen von 5C59h, 5C77h
                      FD_CMDWAIT:
5C82  32 E7 5E                LD      (FD_LASTCMD),A
5C85  2F                      CPL
5C86  D3 D8                   OUT     (FDC_CMD),A
5C88  3E 38                   LD      A,38h                   ; '8'
5C8A  32 AD 5C                LD      (FD_WB_JR),A
5C8D  CD 9A 5C                CALL    FD_WAITBUSY
5C90  CD DC 5E                CALL    FD_DLY_L
5C93  DB D8                   IN      A,(FDC_CMD)
5C95  2F                      CPL
5C96  32 79 5E                LD      (FD_STATUS),A
5C99  C9                      RET
                      ;  FD_WAITBUSY – warten, bis Bit 0 des Status wechselt; die Richtung (JR C
                      ;  bzw. JR NC) wird in FD_WB_JR eingesetzt. Zeitüberschreitung: Fehler 41.
                      ; <- aufgerufen von 5C8Dh, 5DE6h, 5DF4h
                      FD_WAITBUSY:
5C9A  D5                      PUSH    DE
5C9B  E5                      PUSH    HL
5C9C  CD CE 5E                CALL    FD_DLY_S
5C9F  1E 07                   LD      E,07h
                      FD_WB_OUTER:
5CA1  21 00 00                LD      HL,0000h
                      FD_WB_LP:
5CA4  2B                      DEC     HL
5CA5  7C                      LD      A,H
5CA6  B5                      OR      L
5CA7  28 09                   JR      Z,FD_WB_TIMEOUT
5CA9  DB D8                   IN      A,(FDC_CMD)
5CAB  2F                      CPL
5CAC  0F                      RRCA
                      FD_WB_JR:
5CAD  38 F5                   JR      C,FD_WB_LP
5CAF  E1                      POP     HL
5CB0  D1                      POP     DE
5CB1  C9                      RET
                      FD_WB_TIMEOUT:
5CB2  1D                      DEC     E
5CB3  20 EC                   JR      NZ,FD_WB_OUTER
5CB5  3E 29                   LD      A,29h                   ; ')'
5CB7  C3 A9 5E                JP      FD_ERRA
                      ;  FDR_START – Lesen: Spur/Sektor aus dem logischen Sektor (FD_PREP),
                      ;  je Spur SEEK, Spur- und Sektorregister setzen, READ SECTOR mit
                      ;  Mehrfachsektoren (94h) und die Bytes mit INI holen (Datenport DBh).
                      ;  Nach Sektor 16 Abbruch mit FORCE INTERRUPT und weiter auf der nächsten
                      ;  Spur. Fehler: bis zu 10 Versuche (FD_RETRY) mit RESTORE dazwischen.
                      FDR_START:
5CBA  CD 71 5D                CALL    FD_PREP
                      FDR_RETRY:
5CBD  CD 7A 5D                CALL    FD_SETUP
                      FDR_TRACK:
5CC0  CD 9A 5D                CALL    FD_SIDE
5CC3  CD 57 5C                CALL    FD_SEEK
5CC6  20 40                   JR      NZ,FDR_ERR
5CC8  CD AA 5D                CALL    FD_SETTS
5CCB  F3                      DI
5CCC  3E 94                   LD      A,94h
5CCE  CD DB 5D                CALL    FD_CMDRW
                      FDR_SECTOR:
5CD1  06 00                   LD      B,00h
                      FDR_BYTE:
5CD3  DB D8                   IN      A,(FDC_CMD)
5CD5  0F                      RRCA
5CD6  38 1A                   JR      C,FDR_STATUS
5CD8  0F                      RRCA
5CD9  38 F8                   JR      C,FDR_BYTE
5CDB  ED A2                   INI
5CDD  20 F4                   JR      NZ,FDR_BYTE
5CDF  DD 34 08                INC     (IX+8)
5CE2  DD 7E 08                LD      A,(IX+8)
5CE5  FE 11                   CP      11h
5CE7  28 05                   JR      Z,FDR_LAST
5CE9  15                      DEC     D
5CEA  20 E5                   JR      NZ,FDR_SECTOR
5CEC  18 01                   JR      FDR_STOP
                      FDR_LAST:
5CEE  15                      DEC     D
                      FDR_STOP:
5CEF  CD EA 5D                CALL    FD_FORCEINT
                      FDR_STATUS:
5CF2  FB                      EI
5CF3  DB D8                   IN      A,(FDC_CMD)
5CF5  2F                      CPL
5CF6  32 79 5E                LD      (FD_STATUS),A
5CF9  E6 FF                   AND     0FFh
5CFB  20 0B                   JR      NZ,FDR_ERR
5CFD  CD C9 5D                CALL    FD_NEXTSEC
5D00  CA 6C 5D                JP      Z,FD_DONE
5D03  DD 7E 07                LD      A,(IX+7)
5D06  18 B8                   JR      FDR_TRACK
                      FDR_ERR:
5D08  CD BB 5D                CALL    FD_RETRY
5D0B  18 B0                   JR      FDR_RETRY
                      ;  FDW_START – Schreiben wie FDR_START mit WRITE SECTOR (B4h) und OUTI;
                      ;  danach Kontrolllesen (FD_VERIFY). Schreibschutz: Fehler 41.
                      FDW_START:
5D0D  CD 71 5D                CALL    FD_PREP
                      FDW_RETRY:
5D10  CD 7A 5D                CALL    FD_SETUP
                      FDW_TRACK:
5D13  CD 9A 5D                CALL    FD_SIDE
5D16  CD 57 5C                CALL    FD_SEEK
5D19  C2 60 5D                JP      NZ,FDW_ERR
5D1C  CD AA 5D                CALL    FD_SETTS
5D1F  F3                      DI
5D20  3E B4                   LD      A,0B4h
5D22  CD DB 5D                CALL    FD_CMDRW
                      FDW_SECTOR:
5D25  06 00                   LD      B,00h
                      FDW_BYTE:
5D27  DB D8                   IN      A,(FDC_CMD)
5D29  0F                      RRCA
5D2A  38 1A                   JR      C,FDW_STATUS
5D2C  0F                      RRCA
5D2D  38 F8                   JR      C,FDW_BYTE
5D2F  ED A3                   OUTI
5D31  20 F4                   JR      NZ,FDW_BYTE
5D33  DD 34 08                INC     (IX+8)
5D36  DD 7E 08                LD      A,(IX+8)
5D39  FE 11                   CP      11h
5D3B  28 05                   JR      Z,FDW_LAST
5D3D  15                      DEC     D
5D3E  20 E5                   JR      NZ,FDW_SECTOR
5D40  18 01                   JR      FDW_STOP
                      FDW_LAST:
5D42  15                      DEC     D
                      FDW_STOP:
5D43  CD EA 5D                CALL    FD_FORCEINT
                      FDW_STATUS:
5D46  FB                      EI
5D47  DB D8                   IN      A,(FDC_CMD)
5D49  2F                      CPL
5D4A  32 79 5E                LD      (FD_STATUS),A
5D4D  FE 40                   CP      40h                     ; '@'
5D4F  CA 7A 5E                JP      Z,FD_ERROR
5D52  E6 FF                   AND     0FFh
5D54  20 0A                   JR      NZ,FDW_ERR
5D56  CD C9 5D                CALL    FD_NEXTSEC
5D59  20 0B                   JR      NZ,FDW_NEXTTRK
5D5B  CD F8 5D                CALL    FD_VERIFY
5D5E  30 0C                   JR      NC,FD_DONE
                      FDW_ERR:
5D60  CD BB 5D                CALL    FD_RETRY
5D63  C3 10 5D                JP      FDW_RETRY
                      FDW_NEXTTRK:
5D66  DD 7E 07                LD      A,(IX+7)
5D69  C3 13 5D                JP      FDW_TRACK
                      FD_DONE:
5D6C  3E 80                   LD      A,80h
5D6E  D3 DC                   OUT     (FDD_SEL),A
5D70  C9                      RET
                      ;  FD_PREP – Startspur/-sektor berechnen, 10 Versuche einstellen.
                      ;  FD_SETUP – Laufwerk wählen, D = Anzahl Sektoren, HL = Speicheradresse.
                      ; <- aufgerufen von 5CBAh, 5D0Dh
                      FD_PREP:
5D71  CD B1 5E                CALL    FD_LOG2PHYS
5D74  3E 0A                   LD      A,0Ah
5D76  32 ED 5E                LD      (FD_RETRIES),A
5D79  C9                      RET
                      ; <- aufgerufen von 5CBDh, 5D10h
                      FD_SETUP:
5D7A  CD 0B 5C                CALL    FD_SELECT
5D7D  DD 56 04                LD      D,(IX+4)
5D80  DD 7E 03                LD      A,(IX+3)
5D83  B7                      OR      A
5D84  28 01                   JR      Z,FD_SETUP2
5D86  14                      INC     D
                      FD_SETUP2:
5D87  DD 7E 0A                LD      A,(IX+10)
5D8A  DD 77 08                LD      (IX+8),A
5D8D  DD 7E 09                LD      A,(IX+9)
5D90  DD 77 07                LD      (IX+7),A
5D93  DD 6E 05                LD      L,(IX+5)
5D96  DD 66 06                LD      H,(IX+6)
5D99  C9                      RET
                      ;  FD_SIDE – A = logische Spur: A/2 ins Datenregister (für SEEK), Bit 0
                      ;  als Seite an Port DDh.
                      ; <- aufgerufen von 5CC0h, 5D13h, 5E15h
                      FD_SIDE:
5D9A  CB 3F                   SRL     A
5D9C  2F                      CPL
5D9D  D3 DB                   OUT     (FDC_DAT),A
5D9F  30 04                   JR      NC,FD_SIDE0
5DA1  3E 01                   LD      A,01h
5DA3  18 01                   JR      FD_SIDE_OUT
                      FD_SIDE0:
5DA5  AF                      XOR     A
                      FD_SIDE_OUT:
5DA6  2F                      CPL
5DA7  D3 DD                   OUT     (FDD_SID),A
5DA9  C9                      RET
                      ; <- aufgerufen von 5CC8h, 5D1Ch
                      FD_SETTS:
5DAA  0E DB                   LD      C,0DBh
5DAC  DD 7E 07                LD      A,(IX+7)
5DAF  CB 3F                   SRL     A
5DB1  2F                      CPL
5DB2  D3 D9                   OUT     (FDC_TRK),A
5DB4  DD 7E 08                LD      A,(IX+8)
5DB7  2F                      CPL
5DB8  D3 DA                   OUT     (FDC_SEC),A
5DBA  C9                      RET
                      ; <- aufgerufen von 5D08h, 5D60h
                      FD_RETRY:
5DBB  3A ED 5E                LD      A,(FD_RETRIES)
5DBE  3D                      DEC     A
5DBF  32 ED 5E                LD      (FD_RETRIES),A
5DC2  CA 7A 5E                JP      Z,FD_ERROR
5DC5  CD 75 5C                CALL    FD_RESTORE
5DC8  C9                      RET
                      ;  FD_NEXTSEC – nach Sektor 16 auf Sektor 1 der nächsten Spur; NZ, wenn
                      ;  noch Sektoren fehlen (D).
                      ; <- aufgerufen von 5CFDh, 5D56h
                      FD_NEXTSEC:
5DC9  DD 7E 08                LD      A,(IX+8)
5DCC  FE 11                   CP      11h
5DCE  20 08                   JR      NZ,FD_NS_RET
5DD0  3E 01                   LD      A,01h
5DD2  DD 77 08                LD      (IX+8),A
5DD5  DD 34 07                INC     (IX+7)
                      FD_NS_RET:
5DD8  7A                      LD      A,D
5DD9  B7                      OR      A
5DDA  C9                      RET
                      ; <- aufgerufen von 5CCEh, 5D22h, 5E2Ch
                      FD_CMDRW:
5DDB  32 E7 5E                LD      (FD_LASTCMD),A
5DDE  2F                      CPL
5DDF  D3 D8                   OUT     (FDC_CMD),A
5DE1  3E 30                   LD      A,30h                   ; '0'
5DE3  32 AD 5C                LD      (FD_WB_JR),A
5DE6  CD 9A 5C                CALL    FD_WAITBUSY
5DE9  C9                      RET
                      ;  FD_FORCEINT – FORCE INTERRUPT (D8h) und auf Ende warten.
                      ; <- aufgerufen von 5CEFh, 5D43h, 5E49h
                      FD_FORCEINT:
5DEA  3E D8                   LD      A,0D8h
5DEC  2F                      CPL
5DED  D3 D8                   OUT     (FDC_CMD),A
5DEF  3E 38                   LD      A,38h                   ; '8'
5DF1  32 AD 5C                LD      (FD_WB_JR),A
5DF4  CD 9A 5C                CALL    FD_WAITBUSY
5DF7  C9                      RET
                      ;  FD_VERIFY – geschriebene Sektoren zur Kontrolle lesen (Daten werden
                      ;  verworfen), 2 Versuche; C bei Fehler.
                      ; <- aufgerufen von 5D5Bh
                      FD_VERIFY:
5DF8  CD B1 5E                CALL    FD_LOG2PHYS
5DFB  3E 02                   LD      A,02h
5DFD  32 EE 5E                LD      (FD_VRETRIES),A
                      FDV_RETRY:
5E00  CD 0B 5C                CALL    FD_SELECT
5E03  DD 56 04                LD      D,(IX+4)
5E06  DD 7E 03                LD      A,(IX+3)
5E09  B7                      OR      A
5E0A  28 01                   JR      Z,FDV_SETUP
5E0C  14                      INC     D
                      FDV_SETUP:
5E0D  DD 7E 0A                LD      A,(IX+10)
5E10  6F                      LD      L,A
5E11  DD 7E 09                LD      A,(IX+9)
5E14  67                      LD      H,A
                      FDV_TRACK:
5E15  CD 9A 5D                CALL    FD_SIDE
5E18  CD 57 5C                CALL    FD_SEEK
5E1B  20 4B                   JR      NZ,FDV_ERR
5E1D  0E DB                   LD      C,0DBh
5E1F  7C                      LD      A,H
5E20  CB 3F                   SRL     A
5E22  2F                      CPL
5E23  D3 D9                   OUT     (FDC_TRK),A
5E25  7D                      LD      A,L
5E26  2F                      CPL
5E27  D3 DA                   OUT     (FDC_SEC),A
5E29  F3                      DI
5E2A  3E 94                   LD      A,94h
5E2C  CD DB 5D                CALL    FD_CMDRW
                      FDV_SECTOR:
5E2F  06 00                   LD      B,00h
                      FDV_BYTE:
5E31  DB D8                   IN      A,(FDC_CMD)
5E33  0F                      RRCA
5E34  38 16                   JR      C,FDV_STATUS
5E36  0F                      RRCA
5E37  38 F8                   JR      C,FDV_BYTE
5E39  ED 78                   IN      A,(C)
5E3B  10 F4                   DJNZ    FDV_BYTE
5E3D  2C                      INC     L
5E3E  7D                      LD      A,L
5E3F  FE 11                   CP      11h
5E41  28 05                   JR      Z,FDV_LAST
5E43  15                      DEC     D
5E44  20 E9                   JR      NZ,FDV_SECTOR
5E46  18 01                   JR      FDV_STOP
                      FDV_LAST:
5E48  15                      DEC     D
                      FDV_STOP:
5E49  CD EA 5D                CALL    FD_FORCEINT
                      FDV_STATUS:
5E4C  FB                      EI
5E4D  DB D8                   IN      A,(FDC_CMD)
5E4F  2F                      CPL
5E50  32 79 5E                LD      (FD_STATUS),A
5E53  E6 FF                   AND     0FFh
5E55  20 11                   JR      NZ,FDV_ERR
5E57  7D                      LD      A,L
5E58  FE 11                   CP      11h
5E5A  20 03                   JR      NZ,FDV_CHKEND
5E5C  2E 01                   LD      L,01h
5E5E  24                      INC     H
                      FDV_CHKEND:
5E5F  7A                      LD      A,D
5E60  B7                      OR      A
5E61  20 01                   JR      NZ,FDV_NEXTTRK
5E63  C9                      RET
                      FDV_NEXTTRK:
5E64  7C                      LD      A,H
5E65  C3 15 5E                JP      FDV_TRACK
                      FDV_ERR:
5E68  3A EE 5E                LD      A,(FD_VRETRIES)
5E6B  3D                      DEC     A
5E6C  32 EE 5E                LD      (FD_VRETRIES),A
5E6F  20 02                   JR      NZ,FDV_AGAIN
5E71  37                      SCF
5E72  C9                      RET
                      FDV_AGAIN:
5E73  CD 75 5C                CALL    FD_RESTORE
5E76  C3 00 5E                JP      FDV_RETRY
                      FD_STATUS:
5E79  00                      DEFB    00h                     ; ?? |.|
                      ;  FD_ERROR – Fehlernummer aus dem Status: nicht bereit (Bit 7) 50,
                      ;  Satz nicht gefunden (Bit 4) 54, sonst (auch Schreibschutz, Bit 6) 41.
                      ;  Nummer nach (IY-1) schreiben, Laufwerke abschalten, JP (IY).
                      FD_ERROR:
5E7A  3A E7 5E                LD      A,(FD_LASTCMD)
5E7D  FE 0B                   CP      0Bh
5E7F  28 1B                   JR      Z,FD_ERR_SEEK
5E81  FE 1B                   CP      1Bh
5E83  28 17                   JR      Z,FD_ERR_SEEK
5E85  FE F4                   CP      0F4h
5E87  28 13                   JR      Z,FD_ERR_SEEK
5E89  3A 79 5E                LD      A,(FD_STATUS)
5E8C  CB 7F                   BIT     7,A
5E8E  20 17                   JR      NZ,FD_ERR50
5E90  CB 77                   BIT     6,A
5E92  20 0F                   JR      NZ,FD_ERR41
5E94  CB 67                   BIT     4,A
5E96  3E 36                   LD      A,36h                   ; '6'
5E98  20 0F                   JR      NZ,FD_ERRA
5E9A  18 07                   JR      FD_ERR41
                      FD_ERR_SEEK:
5E9C  3A 79 5E                LD      A,(FD_STATUS)
5E9F  CB 7F                   BIT     7,A
5EA1  20 04                   JR      NZ,FD_ERR50
                      FD_ERR41:
5EA3  3E 29                   LD      A,29h                   ; ')'
5EA5  18 02                   JR      FD_ERRA
                      FD_ERR50:
5EA7  3E 32                   LD      A,32h                   ; '2'
                      FD_ERRA:
5EA9  FD 77 FF                LD      (IY-1),A
5EAC  CD 5F 5C                CALL    FD_RESET
5EAF  FD E9                   JP      (IY)
                      ;  FD_LOG2PHYS – logischen Sektor (IX+1/+2) in Spur (= Sektor / 16) und
                      ;  Sektor (= Rest + 1) zerlegen (IX+9/+10).
                      ; <- aufgerufen von 5D71h, 5DF8h
                      FD_LOG2PHYS:
5EB1  06 00                   LD      B,00h
5EB3  11 10 00                LD      DE,0010h
5EB6  DD 6E 01                LD      L,(IX+1)
5EB9  DD 66 02                LD      H,(IX+2)
5EBC  AF                      XOR     A
                      FD_L2P_LP:
5EBD  ED 52                   SBC     HL,DE
5EBF  38 03                   JR      C,FD_L2P_DONE
5EC1  04                      INC     B
5EC2  18 F9                   JR      FD_L2P_LP
                      FD_L2P_DONE:
5EC4  19                      ADD     HL,DE
5EC5  60                      LD      H,B
5EC6  2C                      INC     L
5EC7  DD 74 09                LD      (IX+9),H
5ECA  DD 75 0A                LD      (IX+10),L
5ECD  C9                      RET
                      ;  FD_DLY_S / FD_DLY_M / FD_DLY_L – Warteschleifen (Zähler 000Fh, 00A0h,
                      ;  2026h).
                      ; <- aufgerufen von 5C9Ch
                      FD_DLY_S:
5ECE  D5                      PUSH    DE
5ECF  11 0F 00                LD      DE,000Fh
5ED2  C3 E0 5E                JP      FD_DLY_LP
                      ; <- aufgerufen von 5C5Fh
                      FD_DLY_M:
5ED5  D5                      PUSH    DE
5ED6  11 A0 00                LD      DE,00A0h
5ED9  C3 E0 5E                JP      FD_DLY_LP
                      ; <- aufgerufen von 5C1Dh, 5C4Ch, 5C90h
                      FD_DLY_L:
5EDC  D5                      PUSH    DE
5EDD  11 26 20                LD      DE,2026h                ; Wartezeit (Schleifenzähler, keine Adresse)
                      FD_DLY_LP:
5EE0  1B                      DEC     DE
5EE1  7B                      LD      A,E
5EE2  B2                      OR      D
5EE3  20 FB                   JR      NZ,FD_DLY_LP
5EE5  D1                      POP     DE
5EE6  C9                      RET
                      ;  FD_LASTCMD: letztes Kommando; FD_MOTOR: 1 = Motor läuft;
                      ;  FD_RESTORED..3: je Laufwerk 1 nach dem ersten RESTORE; FD_RETRIES,
                      ;  FD_VRETRIES: verbleibende Versuche.
                      FD_LASTCMD:
5EE7  00                      DEFB    00h                     ; ?? |.|
                      FD_MOTOR:
5EE8  00                      DEFB    00h                     ; ?? |.|
                      FD_RESTORED:
5EE9  00                      DEFB    00h                     ; ?? |.|
                      FD_RESTORED1:
5EEA  00                      DEFB    00h                     ; ?? |.|
                      FD_RESTORED2:
5EEB  00                      DEFB    00h                     ; ?? |.|
                      FD_RESTORED3:
5EEC  00                      DEFB    00h                     ; ?? |.|
                      FD_RETRIES:
5EED  00                      DEFB    00h                     ; ?? |.|
                      FD_VRETRIES:
5EEE  00                      DEFB    00h                     ; ?? |.|
                      
                      ; ==============================================================================
                      ;  GP-IB (IEEE-488)
                      ; ==============================================================================
                      ;  IO_INIT: PIO der GP-IB-Karte programmieren und – das ist der
                      ;  Einhängepunkt der RS-232C-Erweiterung – mit JP SIO_INIT enden.
                      ; <- aufgerufen von 1311h
                      IO_INIT:
5EEF  21 43 65                LD      HL,GPIB_PIOINIT         ; PIO-Init-Daten der GP-IB-Karte
5EF2  01 C3 03                LD      BC,03C3h                ; 3 Bytes an Port C3h
5EF5  ED B3                   OTIR
5EF7  01 C2 03                LD      BC,03C2h                ; 3 Bytes an Port C2h
5EFA  ED B3                   OTIR
5EFC  3E 10                   LD      A,10h
5EFE  D3 C1                   OUT     (GP_C1),A
5F00  AF                      XOR     A
5F01  D3 C4                   OUT     (GP_C4),A
5F03  C3 19 66                JP      SIO_INIT                ; Einhängepunkt der RS-232C-Erweiterung
                      ;  GP-IB-Befehle als Controller. Adressen: Hörer 0-30 (20h+n), Sprecher
                      ;  0-31 (40h+n), sonst Fehler 37; mehrere Geräte durch ";" getrennt
                      ;  (GET_ADDRS, bis 14). Gesendet wird mit ATN (ATN_ON ... ATN_OFF):
                      ;  TRG adr[;adr]  – UNL, Hörer, GET (08h)
                      ;  DCL [adr...]   – mit Adressen UNL, Hörer, SDC (04h), sonst DCL (14h)
                      ;  LCL [adr...]   – mit Adressen GTL (01h), sonst REN abschalten
                      ;  LLO            – LLO (11h)
                      ;  PCT adr        – UNL, Sprecher, TCT (09h): Controllerrolle abgeben
5F06  CD E2 64        ST_TRG: CALL    GET_ADDRS
5F09  CD 70 64                CALL    ATN_ON
5F0C  CD 97 64                CALL    SEND_UNL
5F0F  CD D4 64                CALL    SEND_ADDRS
5F12  3E 08                   LD      A,08h
                      GP_SENDCMD:
5F14  CD 99 64                CALL    GP_SENDBYTE
                      GP_ATNOFF_DONE:
5F17  CD 7A 64                CALL    ATN_OFF
5F1A  C3 00 1D                JP      NEXTSTMT_HL
5F1D  CD 03 1B        ST_DCL: CALL    CHRGET
5F20  28 10                   JR      Z,DCL_ALL
5F22  CD E2 64                CALL    GET_ADDRS
5F25  CD 70 64                CALL    ATN_ON
5F28  CD 97 64                CALL    SEND_UNL
5F2B  CD D4 64                CALL    SEND_ADDRS
5F2E  3E 04                   LD      A,04h
5F30  18 E2                   JR      GP_SENDCMD
                      DCL_ALL:
5F32  CD 70 64                CALL    ATN_ON
5F35  3E 14                   LD      A,14h
5F37  18 DB                   JR      GP_SENDCMD
5F39  CD 03 1B        ST_LCL: CALL    CHRGET
5F3C  28 10                   JR      Z,LCL_ALL
5F3E  CD E2 64                CALL    GET_ADDRS
5F41  CD 70 64                CALL    ATN_ON
5F44  CD 97 64                CALL    SEND_UNL
5F47  CD D4 64                CALL    SEND_ADDRS
5F4A  3E 01                   LD      A,01h
5F4C  18 C6                   JR      GP_SENDCMD
                      LCL_ALL:
5F4E  CD 59 64                CALL    CHK_SYSCTRL
5F51  CD 8C 64                CALL    REN_OFF
5F54  C3 00 1D                JP      NEXTSTMT_HL
5F57  CD 70 64        ST_LLO: CALL    ATN_ON
5F5A  3E 11                   LD      A,11h
5F5C  18 B6                   JR      GP_SENDCMD
5F5E  CD 70 64        ST_PCT: CALL    ATN_ON
5F61  CD 97 64                CALL    SEND_UNL
5F64  CD 1F 65                CALL    GET_TLKADDR
5F67  CD 99 64                CALL    GP_SENDBYTE
5F6A  3E 10                   LD      A,10h
5F6C  CD 2F 65                CALL    GP_OUTC5
5F6F  E5                      PUSH    HL
5F70  21 4F 65                LD      HL,GP_MODE
5F73  CB B6                   RES     6,(HL)
5F75  E1                      POP     HL
5F76  3E 09                   LD      A,09h
5F78  CD 99 64                CALL    GP_SENDBYTE
5F7B  AF                      XOR     A
5F7C  D3 C4                   OUT     (GP_C4),A
5F7E  18 97                   JR      GP_ATNOFF_DONE
                      ;  REN – REN setzen (Port C1 Bit 0). ICL – IFC kurz setzen (Bit 1),
                      ;  Schnittstelle zurücksetzen; nur als Systemcontroller (CHK_SYSCTRL).
5F80  CD 59 64        ST_REN: CALL    CHK_SYSCTRL
5F83  CD 48 64                CALL    GP_DELAY22
5F86  DB C1                   IN      A,(GP_C1)
5F88  CB C7                   SET     0,A
5F8A  18 17                   JR      GP_SETCTL
5F8C  CD 59 64        ST_ICL: CALL    CHK_SYSCTRL
5F8F  DB C1                   IN      A,(GP_C1)
5F91  E6 13                   AND     13h
5F93  F6 12                   OR      12h
5F95  D3 C1                   OUT     (GP_C1),A
5F97  CD 48 64                CALL    GP_DELAY22
5F9A  E5                      PUSH    HL
5F9B  21 4F 65                LD      HL,GP_MODE
5F9E  CB F6                   SET     6,(HL)
5FA0  E1                      POP     HL
5FA1  CB 8F                   RES     1,A
                      GP_SETCTL:
5FA3  D3 C1                   OUT     (GP_C1),A
5FA5  C3 00 1D                JP      NEXTSTMT_HL
                      ;  WRT [/adr[;adr...],] ausdruck[;...] – Daten senden. Mit "/" erst UNT,
                      ;  UNL, eigene Sprecheradresse und die Hörer adressieren, sonst muss die
                      ;  Karte schon Sprecher sein (Fehler 39). Die Texte werden im Puffer 7074h
                      ;  gesammelt (höchstens 500 Bytes, Fehler 3) und mit den Endezeichen
                      ;  EOI_WCHR1/2 gesendet; ";" am Ende unterdrückt sie.
5FA8  CD 60 64        ST_WRT: CALL    CHK_IFREADY
5FAB  CD 5D 19                CALL    CHK_CHR_ALT
5FAE  2F              D5FAE:  DEFB    2Fh                     ; Inline-Parameter '/'
5FAF  B3 5F           D5FAF:  DEFW    WRT_ADDR
5FB1  18 1A                   JR      WRT_CHKTALK
                      ; <- aufgerufen von 5FABh
                      WRT_ADDR:
5FB3  CD E2 64                CALL    GET_ADDRS
5FB6  CD 70 64                CALL    ATN_ON
5FB9  3E 80                   LD      A,80h
5FBB  CD 2F 65                CALL    GP_OUTC5
5FBE  CD 92 64                CALL    SEND_UNT_UNL
5FC1  3A 4E 65                LD      A,(GP_MYTLK)
5FC4  CD 99 64                CALL    GP_SENDBYTE
5FC7  CD D4 64                CALL    SEND_ADDRS
5FCA  CD 7A 64                CALL    ATN_OFF
                      WRT_CHKTALK:
5FCD  DB C1                   IN      A,(GP_C1)
5FCF  CB 77                   BIT     6,A
5FD1  CA 79 14                JP      Z,ERR_39
5FD4  CD 92 4F                CALL    SKIPCOMMA
5FD7  CD 03 1B                CALL    CHRGET
5FDA  22 51 72                LD      (TXTPTR),HL
5FDD  CA 07 14                JP      Z,ERR_01
5FE0  E5                      PUSH    HL
5FE1  CD 91 60                CALL    WRT_FREEBUF
5FE4  01 04 03                LD      BC,0304h
5FE7  CD CC 4B                CALL    AREA_RESIZE
5FEA  E1                      POP     HL
                      WRT_LOOP:
5FEB  CD 03 1B                CALL    CHRGET
5FEE  22 51 72                LD      (TXTPTR),HL
5FF1  28 5A                   JR      Z,WRT_SEND
5FF3  CD 92 4F                CALL    SKIPCOMMA
5FF6  CD 5D 19                CALL    CHK_CHR_ALT
5FF9  3B              D5FF9:  DEFB    3Bh                     ; Inline-Parameter ';'
5FFA  04 60           D5FFA:  DEFW    WRT_ITEM
5FFC  CD 03 1B                CALL    CHRGET
5FFF  22 51 72                LD      (TXTPTR),HL
6002  28 47                   JR      Z,WRT_SEMI
                      ; <- aufgerufen von 5FF6h
                      WRT_ITEM:
6004  CD 4B 25                CALL    EVAL_EXPR
6007  E5                      PUSH    HL
6008  2A 74 70                LD      HL,(7074h)
600B  C5                      PUSH    BC
600C  01 FC 01                LD      BC,01FCh
600F  09                      ADD     HL,BC
6010  C1                      POP     BC
6011  CD 38 65                CALL    VAL2TEXT_HL
6014  28 23                   JR      Z,WRT_NEXT
6016  D5                      PUSH    DE
6017  2A 74 70                LD      HL,(7074h)
601A  23                      INC     HL
601B  23                      INC     HL
601C  5E                      LD      E,(HL)
601D  23                      INC     HL
601E  56                      LD      D,(HL)
601F  2B                      DEC     HL
6020  D5                      PUSH    DE
6021  E5                      PUSH    HL
6022  EB                      EX      DE,HL
6023  09                      ADD     HL,BC
6024  AF                      XOR     A
6025  EB                      EX      DE,HL
6026  21 F4 01                LD      HL,01F4h
6029  ED 52                   SBC     HL,DE
602B  DA 0D 14                JP      C,ERR_03
602E  E1                      POP     HL
602F  73                      LD      (HL),E
6030  23                      INC     HL
6031  72                      LD      (HL),D
6032  23                      INC     HL
6033  D1                      POP     DE
6034  19                      ADD     HL,DE
6035  D1                      POP     DE
