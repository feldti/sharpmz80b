5B0D  ED 53 97 59             LD      (GR_Y),DE
5B11  D1                      POP     DE
5B12  ED 53 95 59             LD      (GR_X),DE
5B16  C3 00 1D                JP      NEXTSTMT_HL
                      ;  GRPH_PORT: an Port F4h ausgegebener Wert = GRPH_IN (Leseebene, GRAPH I)
                      ;  + GRPH_OUT (Schreibebenen, GRAPH O).
                      GRPH_PORT:
5B19  00                      DEFB    00h                     ; ?? |.|
                      GRPH_IN:
5B1A  00                      DEFB    00h                     ; ?? |.|
                      GRPH_OUT:
5B1B  00                      DEFB    00h                     ; ?? |.|
                      ;  GRAPH [I n] [O ab] [C] [F] – Leseebene n (1-2), Schreibebenen (Ziffern
                      ;  0-2), gewählte Ebenen löschen (C) oder füllen (F); setzt Port F4h.
                      ST_GRAPH:
5B1C  CD 92 4F                CALL    SKIPCOMMA
5B1F  FE 0D                   CP      0Dh
5B21  28 44                   JR      Z,GRAPH_SET
5B23  CD 5D 19                CALL    CHK_CHR_ALT
