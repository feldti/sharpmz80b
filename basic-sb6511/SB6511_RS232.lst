                      ;  Ablauf von LISTLINE: Zeilennummer + " " nach INBUF, dann Zeichen
                      ;  kopieren (Strings unverändert). Token 83h-FFh: Eintrag Token-83h aus
                      ;  KWTAB_OPS ff.; 80h/81h/82h + n: Eintrag n-80h aus KWTAB_STMT/1835h/1837h.
                      ;  Nach REM/DATA/DEF KEY( folgt der Rest bis ":" unverändert.
                      LL_LOOP:
15F4  CD 4B 16                CALL    COPYCHR
15F7  C8                      RET     Z
15F8  D6 80                   SUB     80h
15FA  38 F8                   JR      C,LL_LOOP
15FC  1B                      DEC     DE
15FD  0D                      DEC     C
15FE  FE 03                   CP      03h
1600  38 0D                   JR      C,LL_PREFIX
1602  D6 02                   SUB     02h
1604  47                      LD      B,A
1605  E5                      PUSH    HL
1606  21 39 18                LD      HL,KWTAB_OPS
                      LL_SINGLE:
1609  CD 3E 16                CALL    KWNTH
160C  E1                      POP     HL
