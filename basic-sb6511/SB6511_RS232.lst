1298  CD B6 05                CALL    MSGX
129B  3E FA                   LD      A,0FAh
129D  32 A2 06                LD      (GL_MAXLEN),A
                      BAS_MAIN:
12A0  21 2C 13                LD      HL,BAS_DIRECT
12A3  E5                      PUSH    HL
                      ;  INLINE – Eingabezeile nach INBUF holen (DE = INBUF beim Rücksprung).
                      ;  Löscht CURLINE/CURLNUM (Direktmodus). Bei Autostart wird AUTORUN_CMD
                      ;  kopiert; bei AUTO wird die nächste Zeilennummer (AUTO_LINE, danach um
                      ;  AUTO_STEP erhöht) als Vorgabe ausgegeben. Erstes Zeichen 0Bh beendet AUTO.
                      ;  Überlauf der Zeilennummer bei AUTO -> AUTO aus, Fehler 1.
                      ; <- aufgerufen von 131Eh
12A4  21 4D 72        INLINE: LD      HL,CURLINE
12A7  CD 82 1B                CALL    CLRWORD
12AA  CD 82 1B                CALL    CLRWORD
12AD  CD AB 08                CALL    CRLF_IF
12B0  11 0D 6B                LD      DE,INBUF
12B3  3A DE 13                LD      A,(AUTORUN_FLAG)
12B6  B7                      OR      A
12B7  20 38                   JR      NZ,INL_AUTORUN
12B9  3A 10 2D                LD      A,(AUTO_FLAG)
12BC  B7                      OR      A
12BD  28 1E                   JR      Z,INL_GET
12BF  2A 11 2D                LD      HL,(AUTO_LINE)
12C2  E5                      PUSH    HL
12C3  ED 4B 13 2D             LD      BC,(AUTO_STEP)
12C7  09                      ADD     HL,BC
12C8  38 20                   JR      C,INL_AUTOERR
12CA  22 11 2D                LD      (AUTO_LINE),HL
12CD  E1                      POP     HL
12CE  D5                      PUSH    DE
12CF  CD C4 19                CALL    NUM2DEC
12D2  EB                      EX      DE,HL
12D3  36 20                   LD      (HL),20h
12D5  23                      INC     HL
12D6  36 0D                   LD      (HL),0Dh
12D8  EB                      EX      DE,HL
12D9  D1                      POP     DE
12DA  CD CD 08                CALL    PRTSTR
                      INL_GET:
12DD  CD A4 06                CALL    GETLINE
12E0  1A                      LD      A,(DE)
12E1  FE 0B                   CP      0Bh
12E3  C0                      RET     NZ
12E4  AF                      XOR     A
12E5  32 10 2D                LD      (AUTO_FLAG),A
12E8  18 F3                   JR      INL_GET
                      INL_AUTOERR:
12EA  AF                      XOR     A
12EB  32 10 2D                LD      (AUTO_FLAG),A
12EE  C3 07 14                JP      ERR_01
                      INL_AUTORUN:
12F1  D5                      PUSH    DE                      ; Autostart: Befehl in den Eingabepuffer kopieren
12F2  21 FC 12                LD      HL,AUTORUN_CMD
12F5  01 12 00                LD      BC,0012h
12F8  ED B0                   LDIR
12FA  D1                      POP     DE
12FB  C9                      RET
                      AUTORUN_CMD:
12FC  52 55 4E 20 ..          DEFB    "RUN FD2",22h,"AUTO RUN",22h,0Dh  ; Laufwerksziffer (1302h) wird bei 122Fh eingesetzt
                      BAS_START2:
130E  CD CD 08                CALL    PRTSTR
1311  CD EF 5E                CALL    IO_INIT                 ; I/O-Init: GP-IB und RS-232C (SIO)
1314  3A DE 13                LD      A,(AUTORUN_FLAG)
1317  B7                      OR      A
1318  C2 A0 12                JP      NZ,BAS_MAIN
131B  C3 80 12                JP      BAS_READY
                      INLINE_CHK:
131E  CD A4 12                CALL    INLINE
1321  1A                      LD      A,(DE)
1322  FE 0D                   CP      0Dh
1324  C8                      RET     Z
1325  2A 0A 6B                LD      HL,(STKTOP)
1328  F9                      LD      SP,HL
1329  CD 95 4A                CALL    CLOSE_ALL
                      ;  BAS_DIRECT – Zeile tokenisieren (CRUNCH) und wieder nach INBUF listen
                      ;  (LISTLINE, normalisiert die Anzeige). Ohne Zeilennummer wird sie ab
                      ;  TOKTEXT sofort ausgeführt, mit Nummer über EDITLINE ins Programm übernommen.
                      BAS_DIRECT:
132C  CD 54 15                CALL    CRUNCH
132F  CD E2 15                CALL    LISTLINE
1332  2A 10 6C                LD      HL,(TOKLNUM)
1335  7D                      LD      A,L
1336  B4                      OR      H
1337  20 0F                   JR      NZ,BD_EDIT
1339  21 12 6C                LD      HL,TOKTEXT
133C  22 51 72                LD      (TXTPTR),HL
133F  CD 5D 19                CALL    CHK_CHR_ALT
1342  0D              D1342:  DEFB    0Dh                     ; Inline-Parameter
1343  3A 1D           D1343:  DEFW    EXECSTMT2
1345  C3 A0 12                JP      BAS_MAIN
                      BD_EDIT:
1348  CD 4E 13                CALL    EDITLINE
134B  C3 A0 12                JP      BAS_MAIN
                      ;  EDITLINE – Zeile TOKLNUM/TOKTEXT ins Programm einfügen.
                      ;  Setzt READ/DATA und CONT zurück, sucht die Zeilennummer (FINDLINE).
                      ;  Existiert sie, wird sie zuerst entfernt (EDIT_DELETE). Ist der Text leer
                      ;  (nur 0Dh), bleibt es beim Löschen. Sonst wird an der Fundstelle Platz
                      ;  geschaffen und TOKLINE (Link, Nummer, Text) eingefügt (EDIT_INSERT);
                      ;  danach werden Bereichszeiger und Links korrigiert (EDIT_FIXUP).
                      ;  FINDLINE2 hat als Inline-Adresse die Stelle direkt dahinter (D1365):
                      ;  gefunden oder Programmende, beide Wege laufen bei EDIT_LINK weiter.
                      ; <- aufgerufen von 1348h, 42F3h
                      EDITLINE:
134E  CD 48 15                CALL    DATA_RESET
1351  CD 43 15                CALL    CONT_CLR
1354  CD 78 1A                CALL    FINDLINE
1357  5C 13           D1357:  DEFW    EDIT_INSERT
1359  CC 76 13                CALL    Z,EDIT_DELETE
                      ; <- aufgerufen von 1354h
                      EDIT_INSERT:
135C  3A 12 6C                LD      A,(TOKTEXT)
135F  FE 0D                   CP      0Dh
1361  C8                      RET     Z
1362  CD 7B 1A                CALL    FINDLINE2
1365  67 13           D1365:  DEFW    EDIT_LINK               ; Inline-Parameter: zeigt direkt dahinter
                      EDIT_LINK:
1367  22 0E 6C                LD      (TOKLINE),HL
136A  EB                      EX      DE,HL
136B  21 0E 6C                LD      HL,TOKLINE
136E  CD BA 1A                CALL    LINESIZE
1371  CD 6A 1A                CALL    MOVEUP
1374  18 0A                   JR      EDIT_FIXUP
                      ; <- aufgerufen von 1359h
                      EDIT_DELETE:
1376  CD BA 1A                CALL    LINESIZE
1379  EB                      EX      DE,HL
137A  CD 3B 1A                CALL    MEMDEL
137D  CD 2A 19                CALL    NEGBC
                      EDIT_FIXUP:
1380  CD 8B 1B                CALL    ADJ_PTRS
1383  EB                      EX      DE,HL
1384  C3 B2 1A                JP      LINKS_ADD
                      ;  PRT_RULE – 33 Mal Zeichen 90h ausgeben, dann zwei Zeilenvorschübe.
                      ; <- aufgerufen von 1259h, 1268h
                      PRT_RULE:
1387  06 21                   LD      B,21h
