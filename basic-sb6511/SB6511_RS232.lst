5AA5  CD 6B 19                CALL    SYNCHK
5AA8  4E              D5AA8:  DEFB    4Eh                     ; Inline-Parameter 'N'
5AA9  3A 50 11                LD      A,(PPI_A_COPY)
5AAC  CB E7                   SET     4,A
5AAE  18 ED                   JR      CONS_SETPPI
                      PAT_NEXT:
5AB0  E1                      POP     HL                      ; Rücksprung nach PAT_DRAW: Textzeiger, nächstes Muster
                      ;  PATTERN [-]n, muster$ [, ...] – Bitmuster an der Grafikposition zeichnen
                      ;  (PAT_DRAW), n = 1-24 Zeilen; mit "-" in der Gegenrichtung (Schrittweite
                      ;  und ADD/SBC werden in PAT_STRIDE/PAT_STEP eingesetzt).
                      ST_PATTERN:
5AB1  CD 03 1B                CALL    CHRGET
5AB4  CA 00 1D                JP      Z,NEXTSTMT_HL
5AB7  CD 92 4F                CALL    SKIPCOMMA
5ABA  CD 5D 19                CALL    CHK_CHR_ALT
5ABD  2D              D5ABD:  DEFB    2Dh                     ; Inline-Parameter '-'
5ABE  C8 5A           D5ABE:  DEFW    PAT_UP
5AC0  E5                      PUSH    HL
5AC1  21 09 00                LD      HL,0009h                ; Befehlsbytes 09h,00h = ADD HL,BC / NOP
5AC4  3E 27                   LD      A,27h                   ; Schrittweite 39 statt 41 (PAT_STRIDE)
5AC6  18 06                   JR      PAT_PATCH
                      ; <- aufgerufen von 5ABAh
5AC8  E5              PAT_UP: PUSH    HL
5AC9  21 ED 42                LD      HL,42EDh                ; Befehlsbytes EDh,42h = SBC HL,BC (Original bei PAT_STEP/PAT_STEP2)
5ACC  3E 29                   LD      A,29h                   ; ')'
                      PAT_PATCH:
5ACE  32 26 59                LD      (PAT_STRIDE+1),A
5AD1  22 29 59                LD      (PAT_STEP),HL
5AD4  22 5F 59                LD      (PAT_STEP2),HL
