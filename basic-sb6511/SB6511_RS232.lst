648E  CB 87                   RES     0,A
6490  18 E5                   JR      GP_OUTC1
                      ; <- aufgerufen von 5FBEh, 60AAh
                      SEND_UNT_UNL:
6492  3E 5F                   LD      A,5Fh                   ; '_'
6494  CD 99 64                CALL    GP_SENDBYTE
                      ; <- aufgerufen von 5F0Ch, 5F28h, 5F44h, 5F61h, 61EEh, 6243h, 6262h
                      SEND_UNL:
6497  3E 3F                   LD      A,3Fh                   ; '?'
                      ;  GP_SENDBYTE – Byte A auf den Bus (Port C4) mit Handshake; GP_WAITRDY
                      ;  wartet, bis gesendet werden kann (fehlt die Bestätigung: Fehler 36).
                      ;  BREAK bricht jedes Warten ab (GP_BRKCHK).
                      ; <- aufgerufen von 5F14h, 5F67h, 5F78h, 5FC4h, 606Eh, 6088h, 60B0h, 60B6h (+11 weitere)
                      GP_SENDBYTE:
6499  CD A7 64                CALL    GP_WAITRDY
649C  D3 C4                   OUT     (GP_C4),A
                      ; <- aufgerufen von 614Dh, 620Ch
                      GP_WAITDAV:
649E  CD 27 65                CALL    GP_BRKCHK
64A1  DB C0                   IN      A,(GP_C0)
64A3  07                      RLCA
64A4  38 F8                   JR      C,GP_WAITDAV
64A6  C9                      RET
                      ; <- aufgerufen von 6499h
                      GP_WAITRDY:
64A7  F5                      PUSH    AF
                      GP_WAITRDY_LP:
64A8  CD 27 65                CALL    GP_BRKCHK
64AB  DB C0                   IN      A,(GP_C0)
64AD  07                      RLCA
64AE  07                      RLCA
64AF  38 F7                   JR      C,GP_WAITRDY_LP
64B1  07                      RLCA
64B2  D2 70 14                JP      NC,ERR_36
64B5  F1                      POP     AF
64B6  C9                      RET
                      ;  GP_RECVBYTE – ein Byte empfangen (A), GP_RECVACK quittiert es.
                      ; <- aufgerufen von 6150h, 617Bh, 6191h, 6205h
                      GP_RECVBYTE:
64B7  3A 2E 65                LD      A,(GP_C5COPY)
64BA  CB C7                   SET     0,A
64BC  D3 C5                   OUT     (GP_C5),A
                      ; <- aufgerufen von 6310h
                      GP_RECV_WAIT:
64BE  CD 27 65                CALL    GP_BRKCHK
64C1  DB C0                   IN      A,(GP_C0)
64C3  07                      RLCA
64C4  30 F8                   JR      NC,GP_RECV_WAIT
64C6  DB C4                   IN      A,(GP_C4)
64C8  C9                      RET
                      ; <- aufgerufen von 6164h, 6178h, 618Eh, 6209h
                      GP_RECVACK:
64C9  AF                      XOR     A
64CA  D3 C4                   OUT     (GP_C4),A
64CC  3A 2E 65                LD      A,(GP_C5COPY)
64CF  CB 87                   RES     0,A
64D1  D3 C5                   OUT     (GP_C5),A
64D3  C9                      RET
                      ;  SEND_ADDRS – die mit GET_ADDRS gesammelten Adressen (GP_ADDRBUF, BC
                      ;  Stück) senden. SEND_BUF: BC Bytes ab DE.
                      ; <- aufgerufen von 5F0Fh, 5F2Bh, 5F47h, 5FC7h
                      SEND_ADDRS:
64D4  11 50 65                LD      DE,GP_ADDRBUF
                      ; <- aufgerufen von 6067h, 607Ah, 61C4h
                      SEND_BUF:
64D7  1A                      LD      A,(DE)
64D8  CD 99 64                CALL    GP_SENDBYTE
64DB  13                      INC     DE
64DC  0B                      DEC     BC
64DD  78                      LD      A,B
64DE  B1                      OR      C
64DF  20 F6                   JR      NZ,SEND_BUF
64E1  C9                      RET
                      ; <- aufgerufen von 5F06h, 5F22h, 5F3Eh, 5FB3h
                      GET_ADDRS:
64E2  11 50 65                LD      DE,GP_ADDRBUF
64E5  01 00 00                LD      BC,0000h
                      GET_ADDRS_LP:
64E8  CD FE 64                CALL    GET_LSNADDR
64EB  12                      LD      (DE),A
64EC  13                      INC     DE
64ED  03                      INC     BC
64EE  79                      LD      A,C
64EF  FE 0F                   CP      0Fh
64F1  D2 0D 14                JP      NC,ERR_03
64F4  CD 07 19                CALL    SKIPSP
64F7  23                      INC     HL
64F8  FE 3B                   CP      3Bh                     ; ';'
64FA  28 EC                   JR      Z,GET_ADDRS_LP
64FC  2B                      DEC     HL
64FD  C9                      RET
                      ; <- aufgerufen von 6246h, 64E8h
                      GET_LSNADDR:
64FE  C5                      PUSH    BC
64FF  D5                      PUSH    DE
6500  CD B7 20                CALL    EVAL_BYTE
6503  7B                      LD      A,E
6504  C6 20                   ADD     A,20h
6506  CD 0C 65                CALL    CHK_LSNADDR
6509  D1                      POP     DE
650A  C1                      POP     BC
650B  C9                      RET
                      ; <- aufgerufen von 62C2h, 6506h
                      CHK_LSNADDR:
650C  FE 40                   CP      40h                     ; '@'
650E  30 03                   JR      NC,GP_ERR37
6510  FE 20                   CP      20h                     ; ' '
6512  D0                      RET     NC
                      GP_ERR37:
6513  C3 73 14                JP      ERR_37
                      ; <- aufgerufen von 62D6h
                      CHK_TLKADDR:
6516  FE 60                   CP      60h                     ; '`'
6518  30 F9                   JR      NC,GP_ERR37
651A  FE 40                   CP      40h                     ; '@'
651C  D0                      RET     NC
651D  18 F4                   JR      GP_ERR37
                      ; <- aufgerufen von 5F64h, 60ADh, 61F6h
                      GET_TLKADDR:
651F  CD B7 20                CALL    EVAL_BYTE
6522  7B                      LD      A,E
6523  C6 40                   ADD     A,40h
6525  18 EF                   JR      CHK_TLKADDR
                      ; <- aufgerufen von 6307h, 63C5h, 649Eh, 64A8h, 64BEh
                      GP_BRKCHK:
6527  CD 62 05                CALL    BRKCHK
652A  CA 22 15                JP      Z,BREAK
652D  C9                      RET
                      GP_C5COPY:
652E  00                      DEFB    00h                     ; ?? |.|
                      ; <- aufgerufen von 5F6Ch, 5FBBh, 60A7h, 61C1h, 61EBh, 6214h, 6349h, 638Fh
                      GP_OUTC5:
652F  32 2E 65                LD      (GP_C5COPY),A
6532  D3 C5                   OUT     (GP_C5),A
6534  C9                      RET
                      ; <- aufgerufen von 61AEh, 6738h
                      VAL2STRBUF:
6535  21 0D 6B                LD      HL,INBUF
                      ; <- aufgerufen von 6011h
                      VAL2TEXT_HL:
6538  7A                      LD      A,D
6539  B7                      OR      A
653A  CC E9 3C                CALL    Z,VAL2TEXT
653D  C4 F9 3C                CALL    NZ,STR2TEXT
6540  78                      LD      A,B
6541  B1                      OR      C
6542  C9                      RET
                      GPIB_PIOINIT:
6543  CF 60 07 CF ..          DEFB    0CFh,60h,07h,0CFh,0FFh,07h  ; ?? |.`....|
                      EOI_WCHR1:
6549  0D                      DEFB    0Dh                     ; ?? |.|
                      EOI_WCHR2:
654A  0A                      DEFB    0Ah                     ; ?? |.|
                      EOI_RCHR1:
654B  0A                      DEFB    0Ah                     ; ?? |.|
                      EOI_RCHR2:
654C  FF                      DEFB    0FFh                    ; ?? |.|
                      GP_MYLSN:
654D  21                      DEFB    21h                     ; ?? |!|
                      GP_MYTLK:
654E  41                      DEFB    41h                     ; ?? |A|
                      ;  GP_MODE: Bit 7 Systemcontroller, Bit 6 Controller aktiv (ICL/PCT).
                      ;  GP_MYLSN/GP_MYTLK: eigene Hörer-/Sprecheradresse (20h+n/40h+n).
                      ;  EOI_*: Endezeichen (EOI W/R). GP_ADDRBUF: Adressen für TRG/DCL/LCL/WRT.
                      GP_MODE:
654F  C0                      DEFB    0C0h                    ; ?? |.|
                      GP_ADDRBUF:
6550  00 00 00 00 ..          DEFB    00h,00h,00h,00h,00h,00h,00h,00h  ; ?? |........|
6558  00 00 00 00 ..          DEFB    00h,00h,00h,00h,00h,00h,00h,00h  ; ?? |........|
6560  00                      DEFB    00h                     ; ?? |.|
                      
                      ; ------------------------------------------------------------------------------
                      ;  OLD_COPY – unbenutzt
                      ;  Bytegleiche Kopie von 560Bh-56A9h; übrig geblieben, als der
                      ;  Bereich ab 6600h für die RS-232C-Routinen genutzt wurde.
                      ; ------------------------------------------------------------------------------
                      OLD_COPY:
6561  20 EC CD 13 ..          DEFB    20h,0ECh,0CDh,13h,56h,0C3h,0FDh,1Ch
6569  CD 6F 54 3A ..          DEFB    0CDh,6Fh,54h,3Ah,48h,54h,0C3h,71h
6571  54 CD 13 56 ..          DEFB    54h,0CDh,13h,56h,0C3h,22h,15h,0CDh
6579  6F 54 3E 18 ..          DEFB    6Fh,54h,3Eh,18h,0CDh,71h,54h,3Eh
6581  40 CD 71 54 ..          DEFB    40h,0CDh,71h,54h,3Eh,01h,0C3h,71h
6589  54 C5 D5 E5 ..          DEFB    54h,0C5h,0D5h,0E5h,11h,95h,56h,06h
6591  08 C5 01 28 ..          DEFB    08h,0C5h,01h,28h,00h,0CDh,6Ch,56h
6599  12 13 09 C1 ..          DEFB    12h,13h,09h,0C1h,10h,0F3h,0Eh,08h
65A1  21 9C 56 06 ..          DEFB    21h,9Ch,56h,06h,08h,0AFh,0CBh,0Eh
65A9  17 2B 10 FA ..          DEFB    17h,2Bh,10h,0FAh,0CDh,71h,54h,0Dh
65B1  20 EE E1 D1 ..          DEFB    20h,0EEh,0E1h,0D1h,0C1h,0C9h,0AFh,01h
65B9  3E 2F 32 7F ..          DEFB    3Eh,2Fh,32h,7Fh,56h,32h,89h,56h
65C1  C9 F3 D9 DB ..          DEFB    0C9h,0F3h,0D9h,0DBh,0E8h,0CBh,0FFh,0D3h
65C9  E8 08 3A 19 ..          DEFB    0E8h,08h,3Ah,19h,5Bh,4Fh,0CBh,87h
65D1  D3 F4 D9 7E ..          DEFB    0D3h,0F4h,0D9h,7Eh,2Fh,0D9h,47h,79h
65D9  CB C7 D3 F4 ..          DEFB    0CBh,0C7h,0D3h,0F4h,0D9h,7Eh,2Fh,0D9h
65E1  B0 08 CB BF ..          DEFB    0B0h,08h,0CBh,0BFh,0D3h,0E8h,0D9h,08h
65E9  FB C9 00 00 ..          DEFB    0FBh,0C9h,00h,00h,00h,00h,00h,00h
65F1  00 00 3A 19 ..          DEFB    00h,00h,3Ah,19h,5Bh,0F5h,0CBh,0C7h
65F9  D3 F4 CD BA ..          DEFB    0D3h,0F4h,0CDh,0BAh,56h,07h,47h
                      
                      ; ==============================================================================
                      ;  RS-232C-ERWEITERUNG  (6600h-68ABh)
                      ; ==============================================================================
                      ;  Dieser Block ist die "besondere Anpassung" für die serielle Schnittstelle.
                      ;  Er steht hinter dem GP-IB-Teil in einem Bereich, der vorher eine Kopie
                      ;  von 560Bh-56A9h enthielt (siehe OLD_COPY bei 6561h), und wird über
                      ;  drei neue Schlüsselwörter (Token 80h,E0h-E2h) angesprochen:
                      ;
                      ;    RSMODE {A|B} [,R n] [,T n] [,M n] [,RX n]
                      ;         A/B   Kanal wählen (A = Ports B0h/B1h, B = Ports B2h/B3h)
                      ;         R n   Empfangs-Datenbits 5..8   (SIO WR3 Bit 7-6)
                      ;         T n   Sende-Datenbits 5..8      (SIO WR5 Bit 6-5)
                      ;         M n   Byte für SIO WR4 direkt (Taktteiler, Stoppbits, Parität)
                      ;         RX n  n<>0: Empfänger ein, Ringpuffer leeren, Interrupts ein;
                      ;               n=0: Empfänger aus. RX beendet die Anweisung.
                      ;    RSO {A|B}, ausdruck     Zahl/String senden, danach CR (0Dh)
                      ;    RSI {A|B}, variablen    eine Zeile bis CR aus dem Ringpuffer lesen und
                      ;                            wie bei GP-IB "RED" den Variablen zuweisen
                      ;
                      ;  Hardware: Z80-SIO an Ports B0h-B3h (A-Daten, A-Steuer., B-Daten, B-Steuer.).
                      ;  Die Baudrate wird nicht per Software eingestellt (kein Zugriff auf einen
                      ;  Baudratengenerator) – sie kommt vom Takt der Schnittstellenkarte.
                      ;
                      ;  Empfang läuft interruptgesteuert (IM 2): I-Register = 66h, Vektoren ab
                      ;  6600h. Jeder Kanal hat einen 256-Byte-Ringpuffer genau auf einer Seite
                      ;  (A: 6900h-69FFh, B: 6A00h-6AFFh); die Zeiger werden nur über L erhöht.
                      ;  Grundeinstellung (SIO_INITTAB): 8 Datenbits, gerade Parität, 2 Stoppbits,
                      ;  Takt x16, DTR und RTS aktiv, Sender ein, Empfänger aus.
                      ;
                      ;  Fehlernummern dieser Erweiterung:
                      ;    29 Framing   30 Überlauf (SIO)   31 Parität   32 Sende-Timeout
                      ;    33 Ringpuffer voll
                      ;
                      ;  Eingebunden wird der Block durch:
                      ;    - Einträge 96-98 in STMT_TAB (1E5Dh) und RSO/RSI/RSMODE in KWTAB_STMT,
                      ;    - JP SIO_INIT am Ende von IO_INIT (5F03h), d.h. beim BASIC-Start und
                      ;      nach Fehlern wird die SIO neu initialisiert.
                      ;  Viele Befehle hier ändern Operanden anderer Befehle (selbstmodifizierender
                      ;  Code), um denselben Code für beide Kanäle zu nutzen.
                      SIO_VECTORS:
6600  00 00                   DEFW    MON_RESET               ; SIO Kanal B: Sendepuffer leer (nicht benutzt)
6602  00 00                   DEFW    MON_RESET               ; SIO Kanal B: Ext./Status (nicht benutzt)
6604  2E 68                   DEFW    SIO_RXB_INT             ; SIO Kanal B: Zeichen empfangen
6606  46 68                   DEFW    SIO_SPB_INT             ; SIO Kanal B: Sonderempfangsbedingung
6608  00 00                   DEFW    MON_RESET               ; SIO Kanal A: Sendepuffer leer (nicht benutzt)
660A  00 00                   DEFW    MON_RESET               ; SIO Kanal A: Ext./Status (nicht benutzt)
660C  0E 68                   DEFW    SIO_RXA_INT             ; SIO Kanal A: Zeichen empfangen
660E  42 68                   DEFW    SIO_SPA_INT             ; SIO Kanal A: Sonderempfangsbedingung
                      
                      ; ------------------------------------------------------------------------------
                      ;  Ringpuffer-Zeiger (je 16 Bit, High-Byte = Pufferseite)
                      ; ------------------------------------------------------------------------------
6610  00 00           RXA_WR: DEFB    00h,00h                 ; Schreibzeiger Ringpuffer Kanal A (Seite 69xxh)
6612  00 00           RXA_RD: DEFB    00h,00h                 ; Lesezeiger  Ringpuffer Kanal A
6614  00 00           RXB_WR: DEFB    00h,00h                 ; Schreibzeiger Ringpuffer Kanal B (Seite 6Axxh)
6616  00 00           RXB_RD: DEFB    00h,00h                 ; Lesezeiger  Ringpuffer Kanal B
                      RS_FLAG:
6618  00                      DEFB    00h                     ; wird bei RSMODE RX gelöscht, sonst nirgends benutzt
                      
                      ; ------------------------------------------------------------------------------
                      ;  SIO_INIT – beide SIO-Kanäle mit SIO_INITTAB programmieren, Vektor setzen.
                      ;  Aufruf: am Ende von IO_INIT (BASIC-Start), nach BREAK in RSI und nach
                      ;  Empfangsfehlern.  Hinterlässt DI – die Interrupts werden erst durch
                      ;  RSMODE ...,RX n (oder anderen Code mit EI) wieder freigegeben.
                      ; ------------------------------------------------------------------------------
                      ; <- aufgerufen von 67C4h, 6823h, 6857h
                      SIO_INIT:
6619  F3                      DI                              ; keine Unterbrechungen während der SIO-Programmierung
661A  21 00 66                LD      HL,SIO_VECTORS          ; HL = Basis der Vektortabelle
661D  7C                      LD      A,H                     ; High-Byte -> I-Register (IM 2 ist seit 00A7h aktiv)
661E  ED 47                   LD      I,A
6620  7D                      LD      A,L                     ; Low-Byte (00h) ...
6621  32 05 68                LD      (SIO_INITTAB+4),A       ; ... als Interruptvektor in den WR2-Eintrag der Tabelle
6624  01 B1 0D                LD      BC,0DB1h                ; B = 13 Bytes, C = SIO_AC (Kanal A Steuerung)
6627  21 01 68                LD      HL,SIO_INITTAB
662A  ED B3                   OTIR                            ; Kanal A initialisieren
662C  01 B3 0D                LD      BC,0DB3h                ; B = 13 Bytes, C = SIO_BC (Kanal B Steuerung)
662F  21 01 68                LD      HL,SIO_INITTAB
6632  ED B3                   OTIR                            ; Kanal B initialisieren (WR2 = Vektor gilt für beide Kanäle)
6634  C9                      RET
                      
                      ; ------------------------------------------------------------------------------
                      ;  SIO_SETMODE – WR4, WR1, WR3, WR5 aus der Tabelle an den gewählten Kanal
                      ;  schicken und die Datenbit-Maske in den passenden Empfangs-Interrupt
                      ;  eintragen.  Der Kanal steht im Operanden von "LD C,..." (6636h).
                      ; ------------------------------------------------------------------------------
                      ; <- aufgerufen von 6651h, 66B0h
                      SIO_SETMODE:
6635  0E B3                   LD      C,0B3h                  ; C = Steuerport; Operand 6636h wird von RSMODE A/B gesetzt (B1h/B3h)
6637  06 08                   LD      B,08h                   ; 8 Bytes: WR4, WR1, WR3, WR5 (jeweils Register + Wert)
6639  F5                      PUSH    AF
663A  79                      LD      A,C
663B  FE B3                   CP      0B3h                    ; Kanal B?
663D  3A A7 68                LD      A,(RX_MASK)             ; aktuelle Datenbit-Maske (1Fh/3Fh/7Fh/FFh)
6640  20 05                   JR      NZ,SSM_MASKA
6642  32 33 68                LD      (RXB_MASK+1),A          ; -> AND-Maske im Empfangs-Interrupt Kanal B
6645  18 03                   JR      SSM_OUT
                      SSM_MASKA:
6647  32 13 68                LD      (RXA_MASK+1),A          ; -> AND-Maske im Empfangs-Interrupt Kanal A
                      SSM_OUT:
664A  F1                      POP     AF
664B  21 06 68                LD      HL,SIO_INITTAB+5        ; Zeiger auf "04h,WR4,01h,WR1,03h,WR3,05h,WR5" in SIO_INITTAB
664E  ED B3                   OTIR                            ; Register an die SIO ausgeben
6650  C9                      RET
                      RSM_DONE:
6651  CD 35 66                CALL    SIO_SETMODE             ; Statement-Ende: Einstellungen übernehmen ...
6654  C3 FD 1C                JP      NEXTSTMT                ; ... und mit der nächsten Anweisung weitermachen
                      
                      ; ------------------------------------------------------------------------------
                      ;  ST_RSMODE – Anweisung RSMODE (Token 80h,E2h)
                      ;  Schleife über die Optionen A, B, R n, T n, M n, RX n (durch Kommas
                      ;  getrennt).  Die Werte landen in SIO_INITTAB und werden am Ende (oder bei
                      ;  RX) an die SIO übertragen.
                      ; ------------------------------------------------------------------------------
                      ST_RSMODE:
6657  F3                      DI                              ; Interrupts aus (Achtung: nur der RX-Zweig schaltet sie wieder ein)
6658  CD 92 4F                CALL    SKIPCOMMA               ; optionales Komma überlesen
665B  CD 03 1B                CALL    CHRGET                  ; nächstes Zeichen; Z = Anweisungsende
665E  22 51 72                LD      (TXTPTR),HL             ; Textzeiger merken
6661  28 EE                   JR      Z,RSM_DONE
6663  23                      INC     HL
6664  FE 41                   CP      41h                     ; RSMODE A ...
6666  06 B1                   LD      B,0B1h                  ; ... Kanal A = Steuerport B1h
6668  28 06                   JR      Z,RSM_CHAN
666A  FE 42                   CP      42h                     ; RSMODE B ...
666C  06 B3                   LD      B,0B3h                  ; ... Kanal B = Steuerport B3h
666E  20 06                   JR      NZ,RSM_R
                      RSM_CHAN:
6670  78                      LD      A,B
6671  32 36 66                LD      (SIO_SETMODE+1),A       ; Port in SIO_SETMODE eintragen (selbstmodifizierend)
6674  18 E1                   JR      ST_RSMODE
6676  FE 52           RSM_R:  CP      52h                     ; R (Empfang) ?
6678  20 57                   JR      NZ,RSM_T
667A  CD 07 19                CALL    SKIPSP                  ; nächstes Zeichen ansehen
667D  FE 58                   CP      58h                     ; RX n: Empfänger ein/aus
667F  20 41                   JR      NZ,RSM_RBITS
6681  23                      INC     HL
6682  CD B7 20                CALL    EVAL_BYTE               ; n auswerten (0..255) -> E
6685  E5                      PUSH    HL
6686  7B                      LD      A,E
6687  B7                      OR      A
6688  3A 0B 68                LD      A,(SIO_INITTAB+10)      ; WR3-Wert aus der Tabelle
668B  CB 87                   RES     0,A                     ; Rx Enable aus
668D  28 20                   JR      Z,RSM_RXSET             ; n = 0 -> Empfänger aus
668F  CB C7                   SET     0,A                     ; n <> 0 -> Rx Enable ein
6691  21 18 66                LD      HL,RS_FLAG
6694  36 00                   LD      (HL),00h
6696  21 36 66                LD      HL,SIO_SETMODE+1        ; Adresse des Port-Operanden in SIO_SETMODE
6699  CB 4E                   BIT     1,(HL)                  ; Bit 1 des Ports: 0 = B1h (Kanal A), 1 = B3h (Kanal B)
669B  21 00 69                LD      HL,6900h                ; Ringpuffer Kanal A = 6900h-69FFh
669E  22 10 66                LD      (RXA_WR),HL             ; Schreib- und Lesezeiger zurücksetzen (Puffer leer)
66A1  22 12 66                LD      (RXA_RD),HL
66A4  28 09                   JR      Z,RSM_RXSET             ; Kanal A -> fertig
66A6  21 00 6A                LD      HL,6A00h                ; Ringpuffer Kanal B = 6A00h-6AFFh (A wurde oben mit zurückgesetzt)
66A9  22 14 66                LD      (RXB_WR),HL
66AC  22 16 66                LD      (RXB_RD),HL
                      RSM_RXSET:
66AF  57                      LD      D,A                     ; D = neuer WR3-Wert
66B0  CD 35 66                CALL    SIO_SETMODE             ; WR4/WR1/WR3/WR5 schreiben, Maske setzen
66B3  21 36 66                LD      HL,SIO_SETMODE+1        ; C = Steuerport des gewählten Kanals
66B6  4E                      LD      C,(HL)
66B7  3E 03                   LD      A,03h                   ; WR0: Zeiger auf WR3
66B9  ED 79                   OUT     (C),A
66BB  ED 51                   OUT     (C),D                   ; WR3 mit/ohne Rx Enable
66BD  E1                      POP     HL
66BE  FB                      EI                              ; Interrupts wieder zulassen (Empfang läuft ab jetzt)
66BF  C3 00 1D                JP      NEXTSTMT_HL             ; RX beendet die Anweisung
                      RSM_RBITS:
66C2  CD F3 66                CALL    GET_BITS                ; R n: Empfangs-Datenbits (5..8)
66C5  5F                      LD      E,A
66C6  3A 0B 68                LD      A,(SIO_INITTAB+10)      ; WR3: Bits 7-6 = Rx Bits/Zeichen
66C9  E6 3F                   AND     3Fh
66CB  B3                      OR      E
66CC  32 0B 68                LD      (SIO_INITTAB+10),A
                      RSM_NEXT:
66CF  18 86                   JR      ST_RSMODE
66D1  FE 54           RSM_T:  CP      54h                     ; T n: Sende-Datenbits?
66D3  20 10                   JR      NZ,RSM_M
66D5  CD F3 66                CALL    GET_BITS                ; Bitcode in Bits 7-6 ...
66D8  0F                      RRCA                            ; ... nach Bits 6-5 schieben
66D9  5F                      LD      E,A
66DA  3A 0D 68                LD      A,(SIO_INITTAB+12)      ; WR5: Bits 6-5 = Tx Bits/Zeichen
66DD  E6 9F                   AND     9Fh
66DF  B3                      OR      E
66E0  32 0D 68                LD      (SIO_INITTAB+12),A
66E3  18 EA                   JR      RSM_NEXT
66E5  FE 4D           RSM_M:  CP      4Dh                     ; M n: WR4 (Takt, Stoppbits, Parität) direkt setzen
66E7  C2 07 14                JP      NZ,ERR_01
66EA  CD B7 20                CALL    EVAL_BYTE
66ED  7B                      LD      A,E
66EE  32 07 68                LD      (SIO_INITTAB+6),A       ; neuer WR4-Wert in die Tabelle
66F1  18 DC                   JR      RSM_NEXT
                      
                      ; ------------------------------------------------------------------------------
                      ;  GET_BITS – Datenbitanzahl n (5..8) lesen.
                      ;  Ausgang: A = SIO-Bitcode in Bit 7-6, RX_MASK = passende AND-Maske.
                      ; ------------------------------------------------------------------------------
                      ; <- aufgerufen von 66C2h, 66D5h
                      GET_BITS:
66F3  CD B7 20                CALL    EVAL_BYTE               ; n = Anzahl Datenbits 5..8
66F6  7B                      LD      A,E
66F7  D6 05                   SUB     05h                     ; -> 0..3
66F9  FE 04                   CP      04h
66FB  D2 0D 14                JP      NC,ERR_03               ; sonst Fehler 3
66FE  F5                      PUSH    AF
66FF  E5                      PUSH    HL
6700  21 A8 68                LD      HL,MASKTAB              ; Maskentabelle 1Fh,3Fh,7Fh,FFh
6703  85                      ADD     A,L
6704  6F                      LD      L,A
6705  7E                      LD      A,(HL)
6706  32 A7 68                LD      (RX_MASK),A             ; Maske für empfangene Zeichen merken
6709  E1                      POP     HL
670A  F1                      POP     AF
670B  FE 01                   CP      01h                     ; SIO-Code: 5 Bit=00, 6 Bit=10, 7 Bit=01, 8 Bit=11
670D  28 04                   JR      Z,GB_SWAP
670F  FE 02                   CP      02h
6711  20 02                   JR      NZ,GB_SHIFT
                      GB_SWAP:
6713  EE 03                   XOR     03h                     ; 6 <-> 7 Bit vertauschen
                      GB_SHIFT:
6715  0F                      RRCA                            ; Code nach Bits 7-6 bringen
6716  0F                      RRCA
6717  C9                      RET
                      
                      ; ------------------------------------------------------------------------------
                      ;  ST_RSO – Anweisung RSO {A|B}, ausdruck   (Token 80h,E0h)
                      ;  Wandelt den Ausdruck in einen String und sendet ihn zeichenweise,
                      ;  abgeschlossen mit CR.  Kein Hardware-Handshake (siehe SP_CTSWAIT).
                      ; ------------------------------------------------------------------------------
6718  CD 07 19        ST_RSO: CALL    SKIPSP                  ; Kanalbuchstabe A/B lesen
671B  23                      INC     HL
671C  FE 41                   CP      41h                     ; 'A'
671E  06 B1                   LD      B,0B1h                  ; Kanal A: Steuerport B1h
6720  28 07                   JR      Z,RSO_CHAN
6722  FE 42                   CP      42h                     ; 'B'
6724  06 B3                   LD      B,0B3h                  ; Kanal B: Steuerport B3h
6726  C2 07 14                JP      NZ,ERR_01
                      RSO_CHAN:
6729  78                      LD      A,B
672A  32 6A 67                LD      (SP_WR0+1),A            ; Port für WR0-Ausgabe in SIO_PUT eintragen
672D  32 6D 67                LD      (SP_RR0+1),A            ; Port für RR0-Abfrage
6730  3D                      DEC     A                       ; Datenport = Steuerport - 1 (B0h/B2h)
6731  32 8E 67                LD      (SP_OUT+1),A            ; ... für die Zeichenausgabe
6734  CD 4B 25                CALL    EVAL_EXPR               ; Ausdruck auswerten (Zahl oder String)
6737  E5                      PUSH    HL
6738  CD 35 65                CALL    VAL2STRBUF              ; als String nach 6B0Dh; DE = Adresse, BC = Länge, Z = leer
673B  28 0E                   JR      Z,RSO_END
673D  03                      INC     BC                      ; ein Zeichen mehr senden: das abschließende 0Dh (CR)
                      RSO_LOOP:
673E  1A                      LD      A,(DE)                  ; nächstes Zeichen
673F  CD 62 67                CALL    SIO_PUT                 ; senden (mit Timeout)
6742  DA 64 14                JP      C,ERR_32                ; Timeout -> Fehler 32
6745  13                      INC     DE
6746  0B                      DEC     BC
6747  78                      LD      A,B
6748  B1                      OR      C
6749  20 F3                   JR      NZ,RSO_LOOP
                      RSO_END:
674B  E1                      POP     HL
674C  C3 00 1D                JP      NEXTSTMT_HL
                      
                      ; ------------------------------------------------------------------------------
                      ;  SIO_PUTx / SIO_PUT – ein Zeichen senden (Polling von RR0 Bit 2).
                      ;  Eingang A = Zeichen.  Ausgang CY = 1 bei Timeout, sonst CY = 0.
                      ;  Die Portnummern stehen als Operanden in SP_WR0, SP_RR0 und SP_OUT.
                      ; ------------------------------------------------------------------------------
                      SIO_PUTB:
674F  F5                      PUSH    AF                      ; Zeichen in A über Kanal B senden (nicht referenziert)
6750  3E B3                   LD      A,0B3h
6752  18 03                   JR      SIO_PUTSEL
                      ; <- aufgerufen von 6894h
                      SIO_PUTA:
6754  F5                      PUSH    AF                      ; Zeichen in A über Kanal A senden (von RS_CONIN benutzt)
6755  3E B1                   LD      A,0B1h
                      SIO_PUTSEL:
6757  32 6A 67                LD      (SP_WR0+1),A            ; Ports in SIO_PUT eintragen
675A  32 6D 67                LD      (SP_RR0+1),A
675D  3D                      DEC     A
675E  32 8E 67                LD      (SP_OUT+1),A
6761  F1                      POP     AF
                      ; <- aufgerufen von 673Fh
                      SIO_PUT:
6762  F5                      PUSH    AF                      ; Zeichen in A senden; CY = 1 bei Timeout
6763  D5                      PUSH    DE
6764  11 00 00                LD      DE,0000h                ; Timeout-Zähler 65536 Durchläufe
                      SP_POLL:
6767  3E 10                   LD      A,10h                   ; WR0-Kommando 2: Reset Ext/Status-Interrupts ...
6769  D3 B1           SP_WR0: OUT     (SIO_AC),A              ; ... (aktualisiert die Statusbits in RR0)
676B  00                      NOP
676C  DB B1           SP_RR0: IN      A,(SIO_AC)              ; RR0 lesen
676E  CB 57                   BIT     2,A                     ; Bit 2 = Sendepuffer leer?
6770  20 19                   JR      NZ,SP_SEND              ; ja -> senden
6772  1B                      DEC     DE
6773  7A                      LD      A,D
6774  B3                      OR      E
6775  20 F0                   JR      NZ,SP_POLL
6777  D1                      POP     DE
6778  F1                      POP     AF
6779  37                      SCF                             ; Timeout: CY = 1
677A  C9                      RET
                      SP_CTSWAIT:
677B  C5                      PUSH    BC                      ; unerreichbar: Variante mit CTS-Abfrage (RR0 Bit 5) und Verzögerung
677C  F5                      PUSH    AF
677D  01 00 08                LD      BC,0800h
                      SPCTS_DLY:
6780  0B                      DEC     BC
6781  78                      LD      A,B
6782  B1                      OR      C
6783  20 FB                   JR      NZ,SPCTS_DLY
6785  F1                      POP     AF
6786  C1                      POP     BC
6787  CB 6F                   BIT     5,A                     ; CTS aktiv?
6789  28 DC                   JR      Z,SP_POLL
                      SP_SEND:
678B  D1                      POP     DE
678C  F1                      POP     AF
678D  D3 B0           SP_OUT: OUT     (SIO_AD),A              ; Zeichen an den Datenport (Operand selbstmodifizierend)
678F  B7                      OR      A                       ; CY = 0: OK
6790  C9                      RET
                      
                      ; ------------------------------------------------------------------------------
                      ;  ST_RSI – Anweisung RSI {A|B}, variablenliste   (Token 80h,E1h)
                      ;  Wartet (BREAK-abfragend), bis im Ringpuffer eine komplette Zeile mit CR
                      ;  steht, kopiert sie nach 6B0Dh und übergibt an den Zuweisungscode der
                      ;  GP-IB-Anweisung RED (60CCh).
                      ; ------------------------------------------------------------------------------
6791  CD 07 19        ST_RSI: CALL    SKIPSP                  ; Kanalbuchstabe A/B lesen
6794  23                      INC     HL
6795  22 51 72                LD      (TXTPTR),HL
6798  FE 41                   CP      41h                     ; 'A'
679A  21 10 66                LD      HL,RXA_WR               ; Kanal A: Schreibzeiger ...
679D  22 CF 67                LD      (RSI_CHK+2),HL          ; ... für den Vergleich in RSI_CHK
67A0  21 12 66                LD      HL,RXA_RD               ; Lesezeiger Kanal A
67A3  28 0E                   JR      Z,RSI_SETPTR
67A5  FE 42                   CP      42h                     ; 'B'
67A7  C2 07 14                JP      NZ,ERR_01
67AA  21 14 66                LD      HL,RXB_WR               ; Kanal B: Schreibzeiger
67AD  22 CF 67                LD      (RSI_CHK+2),HL
67B0  21 16 66                LD      HL,RXB_RD               ; Lesezeiger Kanal B
                      RSI_SETPTR:
67B3  22 BD 67                LD      (RSI_WAIT+1),HL         ; Adresse des Lesezeigers in drei Befehle eintragen
67B6  22 E7 67                LD      (RSI_COPY+1),HL
67B9  22 FA 67                LD      (RSI_DONE+1),HL
                      RSI_WAIT:
67BC  2A 12 66                LD      HL,(RXA_RD)             ; HL = Lesezeiger (Operand selbstmodifizierend)
                      RSI_WAIT2:
67BF  CD 62 05                CALL    BRKCHK                  ; BREAK gedrückt?
67C2  20 09                   JR      NZ,RSI_CHK
                      RSI_BREAK:
67C4  CD 19 66                CALL    SIO_INIT                ; BREAK: SIO neu initialisieren ...
67C7  CD 43 15                CALL    CONT_CLR
67CA  C3 22 15                JP      BREAK                   ; ... und "*Break" melden
                      RSI_CHK:
67CD  ED 4B 10 66             LD      BC,(RXA_WR)             ; BC = Schreibzeiger (Operand selbstmodifizierend)
67D1  7D                      LD      A,L
67D2  B9                      CP      C                       ; Puffer leer -> weiter warten
67D3  28 EA                   JR      Z,RSI_WAIT2
                      RSI_SCAN:
67D5  3E 0D                   LD      A,0Dh                   ; nach CR (Zeilenende) suchen
67D7  BE                      CP      (HL)
67D8  28 0C                   JR      Z,RSI_COPY
67DA  2C                      INC     L                       ; nächstes Byte (Wrap innerhalb der 256-Byte-Seite)
67DB  7D                      LD      A,L
67DC  B9                      CP      C                       ; Schreibzeiger erreicht, noch kein CR -> warten
67DD  28 DD                   JR      Z,RSI_WAIT
67DF  CD 62 05                CALL    BRKCHK
67E2  28 E0                   JR      Z,RSI_BREAK
67E4  18 EF                   JR      RSI_SCAN
                      RSI_COPY:
67E6  2A 12 66                LD      HL,(RXA_RD)             ; vollständige Zeile: HL = Lesezeiger
67E9  11 0D 6B                LD      DE,INBUF                ; Ziel: Eingabepuffer 6B0Dh
67EC  D5                      PUSH    DE
67ED  01 00 00                LD      BC,0000h
                      RSI_CLOOP:
67F0  7E                      LD      A,(HL)                  ; Zeile bis einschließlich CR kopieren
67F1  12                      LD      (DE),A
67F2  2C                      INC     L                       ; Ringpuffer: nur L erhöhen
67F3  13                      INC     DE
67F4  03                      INC     BC
67F5  FE 0D                   CP      0Dh
67F7  20 F7                   JR      NZ,RSI_CLOOP
                      RSI_DONE:
67F9  22 12 66                LD      (RXA_RD),HL             ; neuen Lesezeiger speichern
67FC  0B                      DEC     BC                      ; BC = Länge ohne CR
67FD  D1                      POP     DE
67FE  C3 CC 60                JP      RED_PARSE                   ; Variablen zuweisen wie bei GP-IB "RED" (gemeinsamer Code)
                      
                      ; ------------------------------------------------------------------------------
                      ;  SIO_INITTAB – 13 Bytes, per OTIR an den Steuerport (Register, Wert):
                      ;    18h          WR0: Kanal-Reset
                      ;    10h,10h      WR0: Reset Ext/Status-Interrupts (2x)
                      ;    02h,00h      WR2: Interruptvektor (Low-Byte, von SIO_INIT eingetragen)
                      ;    04h,4Fh      WR4: Takt x16, 2 Stoppbits, Parität gerade+aktiv  (RSMODE M)
                      ;    01h,14h      WR1: Rx-Interrupt bei jedem Zeichen, "Status affects vector"
                      ;    03h,C0h      WR3: Rx 8 Bit, Empfänger aus                       (RSMODE R/RX)
                      ;    05h,EAh      WR5: DTR, Tx 8 Bit, Sender ein, RTS                 (RSMODE T)
                      ; ------------------------------------------------------------------------------
                      SIO_INITTAB:
6801  18 10 10 02 ..          DEFB    18h,10h,10h,02h,00h,04h,4Fh,01h  ; WR0: Kanal-Reset
6809  14 03 C0 05 ..          DEFB    14h,03h,0C0h,05h,0EAh
                      
                      ; ------------------------------------------------------------------------------
                      ;  Interrupt-Routinen (IM 2, Vektoren in SIO_VECTORS)
                      ;  Empfang: Zeichen maskieren, in den Ringpuffer schreiben, Schreibzeiger
                      ;  erhöhen.  Holt der Schreibzeiger den Lesezeiger ein, ist der Puffer voll:
                      ;  SIO zurücksetzen und Fehler 33 – direkt aus der Interrupt-Routine
                      ;  heraus (der BASIC-Fehlerhandler setzt den Stack zurück).
                      ; ------------------------------------------------------------------------------
                      SIO_RXA_INT:
680E  F5                      PUSH    AF                      ; Empfangs-Interrupt Kanal A
680F  E5                      PUSH    HL
6810  DB B0                   IN      A,(SIO_AD)              ; empfangenes Zeichen
                      RXA_MASK:
6812  E6 FF                   AND     0FFh                    ; auf Datenbits maskieren (Operand von SIO_SETMODE gesetzt)
6814  2A 10 66                LD      HL,(RXA_WR)             ; in den Ringpuffer schreiben
6817  77                      LD      (HL),A
6818  2C                      INC     L                       ; nur L erhöhen: Puffer = genau eine 256-Byte-Seite
6819  22 10 66                LD      (RXA_WR),HL
681C  7D                      LD      A,L                     ; neuer Schreibzeiger (Low) mit ...
681D  2A 12 66                LD      HL,(RXA_RD)             ; ... dem Lesezeiger vergleichen
                      RX_CHKFULL:
6820  BD                      CP      L
6821  20 06                   JR      NZ,RX_EXIT              ; nicht gleich -> OK
6823  CD 19 66                CALL    SIO_INIT                ; Puffer übergelaufen: SIO zurücksetzen
6826  C3 67 14                JP      ERR_33                  ; Fehler 33 (direkt aus dem Interrupt heraus)
                      RX_EXIT:
6829  E1                      POP     HL
682A  F1                      POP     AF
682B  FB                      EI
682C  ED 4D                   RETI                            ; Interrupt beenden
                      SIO_RXB_INT:
682E  F5                      PUSH    AF                      ; Empfangs-Interrupt Kanal B (wie oben)
682F  E5                      PUSH    HL
6830  DB B2                   IN      A,(SIO_BD)
                      RXB_MASK:
6832  E6 FF                   AND     0FFh
6834  2A 14 66                LD      HL,(RXB_WR)
6837  77                      LD      (HL),A
6838  2C                      INC     L
6839  22 14 66                LD      (RXB_WR),HL
683C  7D                      LD      A,L
683D  2A 16 66                LD      HL,(RXB_RD)
6840  18 DE                   JR      RX_CHKFULL
                      
                      ; ------------------------------------------------------------------------------
                      ;  Sonderempfangsbedingung: RR1 lesen und als BASIC-Fehler 29/30/31 melden.
                      ; ------------------------------------------------------------------------------
                      SIO_SPA_INT:
6842  3E B1                   LD      A,0B1h                  ; Sonderempfangsbedingung Kanal A
6844  18 02                   JR      SP_INT
                      SIO_SPB_INT:
6846  3E B3                   LD      A,0B3h                  ; Sonderempfangsbedingung Kanal B
6848  32 51 68        SP_INT: LD      (SPI_WR0+1),A           ; Steuerport in die beiden folgenden Befehle eintragen
684B  32 53 68                LD      (SPI_RR1+1),A
684E  3E 01                   LD      A,01h                   ; WR0: Zeiger auf RR1
                      SPI_WR0:
6850  D3 B1                   OUT     (SIO_AC),A
                      SPI_RR1:
6852  DB B1                   IN      A,(SIO_AC)              ; RR1 lesen
6854  E6 70                   AND     70h                     ; Bit 6 Framing, Bit 5 Überlauf, Bit 4 Parität
6856  F5                      PUSH    AF
6857  CD 19 66                CALL    SIO_INIT                ; SIO zurücksetzen
685A  F1                      POP     AF
685B  CB 77                   BIT     6,A
685D  C2 5B 14                JP      NZ,ERR_29               ; Fehler 29: Framing
6860  CB 6F                   BIT     5,A
6862  C2 5E 14                JP      NZ,ERR_30               ; Fehler 30: Überlauf
6865  C3 61 14                JP      ERR_31                  ; sonst Fehler 31: Parität
                      
                      ; ------------------------------------------------------------------------------
                      ;  RXA_GET – Zeichen aus dem Ringpuffer von Kanal A holen.
                      ;  Ausgang: CY = 1 und A = Zeichen, oder CY = 0 wenn der Puffer leer ist.
                      ; ------------------------------------------------------------------------------
                      ; <- aufgerufen von 688Ah
                      RXA_GET:
6868  C5                      PUSH    BC                      ; Zeichen aus Ringpuffer A holen (nicht blockierend)
6869  E5                      PUSH    HL
686A  2A 12 66                LD      HL,(RXA_RD)
686D  ED 4B 10 66             LD      BC,(RXA_WR)
6871  7D                      LD      A,L
6872  B9                      CP      C                       ; Puffer leer -> CY = 0 (aus CP)
6873  28 06                   JR      Z,RXG_EXIT
6875  7E                      LD      A,(HL)                  ; Zeichen holen
6876  2C                      INC     L
6877  22 12 66                LD      (RXA_RD),HL
687A  37                      SCF                             ; CY = 1: Zeichen in A
                      RXG_EXIT:
687B  E1                      POP     HL
687C  C1                      POP     BC
687D  C9                      RET
                      
                      ; ------------------------------------------------------------------------------
                      ;  RS_TERM – NICHT REFERENZIERT (vermutlich für USR gedacht)
                      ;  Leitet die Tastatureingabe um: RS_CONIN liefert Zeichen von der
                      ;  RS-232C (Kanal A) oder von der Tastatur und schickt Tastendrücke über
                      ;  Kanal A hinaus ("Terminal").  Der Patch zielt auf 06E0h; in diesem
                      ;  Monitor steht dort aber der Opcode von "CALL KEYSCAN" (06E0h = CDh,
                      ;  Operand ab 06E1h).  Die Routine passt also offenbar zu einer anderen
                      ;  Monitor-Version und würde hier den Code zerstören.
                      ; ------------------------------------------------------------------------------
                      RS_TERM:
687E  CD B7 20                CALL    EVAL_BYTE               ; Parameter: 0 = aus, sonst ein
6881  7B                      LD      A,E
6882  B7                      OR      A
6883  28 16                   JR      Z,RST_KBD
6885  21 8A 68                LD      HL,RS_CONIN             ; neue Eingaberoutine: RS_CONIN
6888  18 14                   JR      RST_PATCH
                      RS_CONIN:
688A  CD 68 68                CALL    RXA_GET                 ; Zeichen von der RS-232C da?
688D  D8                      RET     C                       ; ja -> zurückgeben
688E  CD 50 09                CALL    GETKEY                  ; sonst Tastatur abfragen
6891  FE 1E                   CP      1Eh                     ; 1Eh = keine Taste
6893  C8                      RET     Z
6894  CD 54 67                CALL    SIO_PUTA                ; Taste über Kanal A senden
6897  DA 64 14                JP      C,ERR_32                ; Timeout -> Fehler 32
689A  C9                      RET
                      RST_KBD:
689B  21 50 09                LD      HL,GETKEY               ; normale Tastaturroutine
                      RST_PATCH:
689E  22 E0 06                LD      (GL_KEYCALL),HL              ; ACHTUNG: Patch-Adresse passt nicht zu diesem Monitor (siehe oben)
68A1  C3 80 12                JP      BAS_READY               ; BASIC-Warmstart ("Ready")
                      RS_STUB:
68A4  C3 00 1D                JP      NEXTSTMT_HL             ; nicht referenziert
                      
                      ; ------------------------------------------------------------------------------
                      ;  Datenbit-Maske und Maskentabelle (5/6/7/8 Bit)
                      ; ------------------------------------------------------------------------------
                      RX_MASK:
68A7  FF                      DEFB    0FFh                    ; aktuelle Datenbit-Maske (Vorgabe FFh = 8 Bit)
                      MASKTAB:
68A8  1F 3F 7F FF             DEFB    1Fh,3Fh,7Fh,0FFh        ; Masken für 5, 6, 7, 8 Datenbits
                      
                      ; ==============================================================================
                      ;  ENDE DES CODES – Füllbereiche
                      ; ==============================================================================
                              IF      $ > 6900h
                              .ERROR  Code reicht über 6900h (RS-232C-Puffer); OLD_COPY entfernen oder kürzen
                              ENDIF
                      FILL_FREE:
68AC  FF x 84                 DEFS    6900h-$,0FFh            ; frei bis 6900h (wächst/schrumpft mit dem Code)
                      FILL_RTAREA:
6900  FF x 1792               DEFS    7000h-6900h,0FFh        ; zur Laufzeit RS-232C-Puffer und BASIC-Arbeitsbereich
                      FILL_END:
7000  BF x 3584               DEFS    7E00h-7000h,0BFh        ; Füllung bis zum Ende des Abbilds (7E00h Bytes)
                      
                              END
                      
