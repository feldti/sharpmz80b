1578  D5                      PUSH    DE
1579  11 92 16                LD      DE,KWTAB_STMT
157C  CD B1 15                CALL    KWSEARCH
157F  20 11                   JR      NZ,CR_EXT81
1581  D1                      POP     DE
                      CR_STMT:
1582  3E 80                   LD      A,80h
1584  CD 9D 15                CALL    CR_PUT2
1587  FE 84                   CP      84h
1589  D0                      RET     NC
                      CR_LITERAL:
158A  CD 7F 16                CALL    COPY_TO_COLON
158D  FE 3A                   CP      3Ah                     ; ':'
158F  C8                      RET     Z
1590  F1                      POP     AF
1591  C9                      RET
                      CR_EXT81:
1592  11 35 18                LD      DE,KWTAB_EXT81
1595  CD B1 15                CALL    KWSEARCH
1598  20 09                   JR      NZ,CR_SINGLE
159A  D1                      POP     DE
159B  3E 81                   LD      A,81h
                      ; <- aufgerufen von 1584h
                      CR_PUT2:
159D  12                      LD      (DE),A
159E  13                      INC     DE
                      CR_PUT1:
159F  78                      LD      A,B
15A0  12                      LD      (DE),A
