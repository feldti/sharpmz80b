1403  00 00                   DEFB    00h,00h                 ; ?? |..|
                      ERRCTX_TXT:
1405  00 00                   DEFB    00h,00h                 ; ?? |..|
                      
                      ; ------------------------------------------------------------------------------
                      ;  Fehlereinsprünge ERR_01..ERR_70
                      ;  Jeder Einsprung lädt seine Nummer in A; das folgende DEFB 01h
                      ;  verschluckt die restlichen LD A,n bis zum Sprung nach ERROR.
                      ; ------------------------------------------------------------------------------
                      ; <- aufgerufen von 19BEh, 2CD8h, 4791h
1407  3E 01           ERR_01: LD      A,01h                   ; Fehler 1: Syntax-Fehler
1409  01                      DEFB    01h                     ; DEFB 01h = LD BC,nn: überspringt das folgende LD A,n
140A  3E 02           ERR_02: LD      A,02h                   ; Fehler 2: Überlauf (auch Division durch 0, LN negativ)
140C  01                      DEFB    01h                     ; DEFB 01h = LD BC,nn: überspringt das folgende LD A,n
                      ; <- aufgerufen von 1997h, 204Fh, 20A5h
140D  3E 03           ERR_03: LD      A,03h                   ; Fehler 3: Wert außerhalb des Bereichs / Überlauf
140F  01                      DEFB    01h                     ; DEFB 01h = LD BC,nn: überspringt das folgende LD A,n
                      ; <- aufgerufen von 1FBCh, 2BB3h, 416Bh, 6136h
1410  3E 04           ERR_04: LD      A,04h                   ; Fehler 4: Typfehler (Zahl/String verwechselt)
