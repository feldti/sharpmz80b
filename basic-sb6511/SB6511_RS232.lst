                      ; ==============================================================================
                      ;  BASIC-INTERPRETER SB-6511
                      ; ==============================================================================
                      ;  BAS_COLD: Laufwerksnummer des IPL in den Autostart-Befehl
                      ;  "RUN FDn"AUTO RUN"" eintragen, RAM-Ende suchen, Bildschirm,
                      ;  Uhr, Einschaltmeldung, I/O-Init (inkl. SIO), Autostart.
                      BAS_COLD:
1222  3E 01                   LD      A,01h                   ; JP BAS_COLD bei 00AEh zu LD BC,nn entschärfen ...
1224  32 AE 00                LD      (MON_GOBASIC),A
1227  32 DE 13                LD      (AUTORUN_FLAG),A        ; ... und Autostart-Flag setzen
122A  3A EC 7F                LD      A,(IPL_DRIVE)           ; Laufwerksnummer vom IPL (0-3)
122D  C6 31                   ADD     A,31h                   ; -> "1".."4"
122F  32 02 13                LD      (AUTORUN_CMD+6),A       ; in "RUN FDn"AUTO RUN"" eintragen
1232  21 FF 6A                LD      HL,6AFFh                ; RAM-Test ab 6B00h
1235  16 FF                   LD      D,0FFh
                      BC_RAMTEST:
1237  23                      INC     HL
1238  7C                      LD      A,H
1239  BA                      CP      D
123A  28 0A                   JR      Z,BC_RAMEND
123C  3E FF                   LD      A,0FFh                  ; FFh schreiben und prüfen ...
123E  77                      LD      (HL),A
123F  96                      SUB     (HL)
1240  20 04                   JR      NZ,BC_RAMEND
1242  77                      LD      (HL),A                  ; ... 00h schreiben und prüfen
1243  BE                      CP      (HL)
1244  28 F1                   JR      Z,BC_RAMTEST
                      BC_RAMEND:
1246  22 08 6B                LD      (MEMTOP),HL             ; erstes nicht beschreibbares Byte (bzw. FF00h)
1249  22 0A 6B                LD      (STKTOP),HL
124C  F9                      LD      SP,HL                   ; Stack ans RAM-Ende
124D  CD BE 0E                CALL    BEEP
1250  AF                      XOR     A
1251  57                      LD      D,A
1252  5F                      LD      E,A
1253  CD 06 0E                CALL    TIMER_SET
1256  CD 95 13                CALL    CRLF2
1259  CD 87 13                CALL    PRT_RULE
125C  11 9B 13                LD      DE,MSG_BASIC            ; "  BASIC interpreter  SB-6511"
125F  CD 92 13                CALL    PRTMSG_CR
1262  11 B8 13                LD      DE,MSG_COPYR            ; "  Copyright 1981 by SHARP Corp."
1265  CD 92 13                CALL    PRTMSG_CR
1268  CD 87 13                CALL    PRT_RULE
126B  CD 0C 1B                CALL    CLEARALL
126E  01 0A 00                LD      BC,000Ah
1271  CD 15 1A                CALL    CHKMEM
1274  CD 09 1A                CALL    PRTNUM                  ; freien Speicher ausgeben
1277  CD B6 05                CALL    MSGX
127A  11 F8 13                LD      DE,MSG_BYTES
127D  C3 0E 13                JP      BAS_START2              ; " Bytes"
                      
                      ; ------------------------------------------------------------------------------
                      ;  BAS_READY – Warmstart: "Ready", Zeile einlesen, ausführen
                      ;  (Die 10 NOPs sind ein Patch-Platz.)
                      ; ------------------------------------------------------------------------------
                      BAS_READY:
1280  00                      NOP
1281  00                      NOP
1282  00                      NOP
1283  00                      NOP
1284  00                      NOP
1285  00                      NOP
1286  00                      NOP
1287  00                      NOP
1288  00                      NOP
