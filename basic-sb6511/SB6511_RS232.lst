5AE6  CD D3 1A                CALL    GETSTR
5AE9  F1                      POP     AF
5AEA  E5                      PUSH    HL
5AEB  21 B0 5A                LD      HL,PAT_NEXT
5AEE  E5                      PUSH    HL
5AEF  21 0D 6B                LD      HL,INBUF
5AF2  E5                      PUSH    HL
5AF3  03                      INC     BC
5AF4  2B                      DEC     HL
5AF5  1B                      DEC     DE
5AF6  EB                      EX      DE,HL
5AF7  ED B0                   LDIR
5AF9  D1                      POP     DE
5AFA  C3 A2 58                JP      PAT_DRAW
                      ;  POSITION x,y – Grafikposition setzen (x 0-319, y 0-199, sonst Fehler 3).
                      ST_POSITION:
