                      CR_SINGLE:
15A3  11 39 18                LD      DE,KWTAB_OPS
15A6  06 83                   LD      B,83h
15A8  CD B3 15                CALL    KWSEARCH_B
15AB  D1                      POP     DE
15AC  28 F1                   JR      Z,CR_PUT1
15AE  23                      INC     HL
15AF  13                      INC     DE
15B0  C9                      RET
                      ;  KWSEARCH – Schlüsselwort ab (HL) in der Tabelle (DE) suchen, B = 80h.
                      ;  KWSEARCH_B: dasselbe mit Startnummer B. Leerzeichen in Eingabe und
                      ;  Tabelle werden überlesen. Treffer: Z, B = Nummer des Eintrags, HL hinter
                      ;  dem Wort. Kein Treffer: NZ, HL unverändert. Das letzte Zeichen eines
                      ;  Eintrags hat Bit 7 gesetzt, 00h beendet die Tabelle.
                      ; <- aufgerufen von 157Ch, 1595h, 2BF7h
                      KWSEARCH:
15B1  06 80                   LD      B,80h
                      ; <- aufgerufen von 15A8h, 4761h, 4F32h, 4F9Eh
                      KWSEARCH_B:
15B3  E5                      PUSH    HL
                      KWS_CMP:
15B4  CD 07 19                CALL    SKIPSP
15B7  B7                      OR      A
15B8  FA DB 15                JP      M,KWS_HIBIT
15BB  EB                      EX      DE,HL
15BC  CD 07 19                CALL    SKIPSP
15BF  EB                      EX      DE,HL
15C0  96                      SUB     (HL)
15C1  23                      INC     HL
15C2  13                      INC     DE
15C3  28 EF                   JR      Z,KWS_CMP
15C5  C6 80                   ADD     A,80h
15C7  20 03                   JR      NZ,KWS_NEXT
15C9  33                      INC     SP
15CA  33                      INC     SP
15CB  C9                      RET
                      KWS_NEXT:
15CC  E1                      POP     HL
15CD  1B                      DEC     DE
                      KWS_SKIP:
15CE  1A                      LD      A,(DE)
15CF  13                      INC     DE
15D0  B7                      OR      A
15D1  28 06                   JR      Z,KWS_END
15D3  F2 CE 15                JP      P,KWS_SKIP
15D6  04                      INC     B
15D7  18 DA                   JR      KWSEARCH_B
                      KWS_END:
15D9  3D                      DEC     A
15DA  C9                      RET
                      KWS_HIBIT:
15DB  E1                      POP     HL
15DC  CD 07 19                CALL    SKIPSP
15DF  3D                      DEC     A
15E0  7E                      LD      A,(HL)
15E1  C9                      RET
                      ; <- aufgerufen von 132Fh, 1EDAh
                      LISTLINE:
15E2  2A 10 6C                LD      HL,(TOKLNUM)
15E5  11 0D 6B                LD      DE,INBUF
15E8  0E 62                   LD      C,62h
