                      ; ------------------------------------------------------------------------------
                      ;  Fehlerbehandlung
                      ;  ERROR: Nummer merken, ON ERROR prüfen, sonst "*Error n [in z]".
                      ;  BREAK: "*Break [in z]". SET_IOERR setzt IY auf IOERR (JP (IY)).
                      ; ------------------------------------------------------------------------------
                      ; <- aufgerufen von 2BECh, 3F32h, 4C72h
                      SET_IOERR:
14DA  FD 21 E0 14             LD      IY,IOERR
14DE  C9                      RET
                      IOERR_NUM:
14DF  00                      DEFB    00h                     ; ?? |.|
14E0  3A DF 14        IOERR:  LD      A,(IOERR_NUM)
14E3  32 FF 13        ERROR:  LD      (ERRNUM),A              ; Fehlernummer merken
14E6  3A DE 13                LD      A,(AUTORUN_FLAG)
14E9  B7                      OR      A
14EA  01 80 12                LD      BC,BAS_READY
14ED  CD 95 4A                CALL    CLOSE_ALL               ; Dateien/Geräte aufräumen
14F0  CD 87 1C                CALL    RELINK
14F3  CD 80 1C                CALL    IS_DIRECT               ; Direktmodus?
14F6  28 1C                   JR      Z,ERR_PRINT
14F8  21 56 72                LD      HL,ONERR_FLAG                ; ON ERROR GOTO aktiv?
14FB  7E                      LD      A,(HL)
14FC  FE 01                   CP      01h
14FE  20 0B                   JR      NZ,ERR_NOTRAP
1500  34                      INC     (HL)
1501  2A 0A 6B                LD      HL,(STKTOP)
1504  F9                      LD      SP,HL
1505  2A 57 72                LD      HL,(ONERR_LINE)
1508  C3 E2 20                JP      GOTO_LNUM2
                      ERR_NOTRAP:
150B  CD 59 1B                CALL    CLR_ONERR
150E  CD 40 1B                CALL    INITVARPTR
1511  CD 66 1B                CALL    CLEARVARS
                      ERR_PRINT:
1514  11 E6 13                LD      DE,MSG_ERROR            ; "*Error"
1517  CD B6 05                CALL    MSGX
151A  2A FF 13                LD      HL,(ERRNUM)
151D  CD 3D 15                CALL    PRTLINENUM
1520  18 06                   JR      ERR_TAIL
1522  11 F1 13        BREAK:  LD      DE,MSG_BREAK            ; "*Break"
1525  CD B6 05                CALL    MSGX
                      ERR_TAIL:
1528  01 80 12                LD      BC,BAS_READY
152B  C5                      PUSH    BC
152C  AF                      XOR     A
152D  32 10 2D                LD      (AUTO_FLAG),A
1530  CD BE 0E                CALL    BEEP
1533  CD 80 1C                CALL    IS_DIRECT
1536  C8                      RET     Z
1537  11 ED 13                LD      DE,MSG_IN
153A  CD CD 08                CALL    PRTSTR
                      ; <- aufgerufen von 151Dh
                      PRTLINENUM:
153D  CD 09 1A                CALL    PRTNUM
1540  C3 CD 08                JP      PRTSTR
                      ;  CONT_CLR – CONT sperren (CONT_FLAG = 0).
                      ; <- aufgerufen von 1351h, 1B1Bh, 20D6h, 5116h, 5183h, 51B4h, 52ADh, 67C7h
                      CONT_CLR:
1543  AF                      XOR     A
1544  32 4D 15                LD      (CONT_FLAG),A
1547  C9                      RET
                      ;  DATA_RESET – READ beginnt wieder beim ersten DATA (DATA_FLAG = 0).
                      ; <- aufgerufen von 134Eh, 20D3h
                      DATA_RESET:
1548  AF                      XOR     A
1549  32 59 72                LD      (DATA_FLAG),A
154C  C9                      RET
                      CONT_FLAG:
154D  00                      DEFB    00h                     ; ?? |.|
                      CONT_SAVE:
154E  00 00 00 00 ..          DEFB    00h,00h,00h,00h,00h,00h ; ?? |......|
                      
                      ; ------------------------------------------------------------------------------
                      ;  CRUNCH – Eingabezeile in Token umsetzen (INBUF -> TOKTEXT)
                      ;  LISTLINE – Token-Zeile wieder in Klartext wandeln.
                      ; ------------------------------------------------------------------------------
                      ; <- aufgerufen von 132Ch
1554  21 0D 6B        CRUNCH: LD      HL,INBUF
1557  CD BE 19                CALL    GETLNUM_SN
155A  ED 53 10 6C             LD      (TOKLNUM),DE
155E  11 12 6C                LD      DE,TOKTEXT
1561  0E 00                   LD      C,00h
                      ;  Ablauf von CRUNCH: COPYCHR kopiert Leerzeichen, FFh, Klammern und
                      ;  Strings unverändert. Am ersten anderen Zeichen wird nacheinander gesucht:
                      ;  "?" (= PRINT), KWTAB_STMT (-> 80h,80h+n), Tabelle 1835h (-> 81h,80h+n),
                      ;  KWTAB_OPS/FUNC/MATH (-> 83h+n). Nach REM/DATA/DEF KEY( (n < 4) wird der
                      ;  Rest bis ":" unverändert kopiert (CR_LITERAL). Zeichen >= 80h außerhalb
                      ;  von Strings: Fehler 1, mehr als 255 Zeichen: Fehler 8.
                      CR_LOOP:
1563  CD 4B 16                CALL    COPYCHR
1566  C8                      RET     Z
1567  B7                      OR      A
1568  FA 07 14                JP      M,ERR_01
156B  1B                      DEC     DE
156C  E5                      PUSH    HL
156D  21 63 15                LD      HL,CR_LOOP
1570  E3                      EX      (SP),HL
1571  FE 3F                   CP      3Fh                     ; '?'
1573  06 88                   LD      B,88h
1575  28 0B                   JR      Z,CR_STMT
