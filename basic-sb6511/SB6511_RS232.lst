6473  DB C1                   IN      A,(GP_C1)
6475  CB DF                   SET     3,A
                      GP_OUTC1:
6477  D3 C1                   OUT     (GP_C1),A
6479  C9                      RET
                      ; <- aufgerufen von 5F17h, 5FCAh, 60B9h, 61C8h, 61FCh, 6221h, 6265h, 628Bh (+2 weitere)
                      ATN_OFF:
647A  DB C1                   IN      A,(GP_C1)
647C  CB 9F                   RES     3,A
647E  18 F7                   JR      GP_OUTC1
                      ; <- aufgerufen von 6071h, 628Eh, 6398h
