                      ;  GL_MAXLEN: höchste Eingabelänge (BASIC setzt FAh), GL_LEFT: noch erlaubte
                      ;  Zeichen der laufenden Eingabe.
                      GL_MAXLEN:
06A2  00                      DEFB    00h                     ; ?? |.|
                      GL_LEFT:
06A3  00                      DEFB    00h                     ; ?? |.|
                      
                      ; ==============================================================================
                      ;  BILDSCHIRMEDITOR UND ZEICHENAUSGABE
                      ; ==============================================================================
                      ;  GETLINE: Zeile mit Cursor-Editor einlesen (Ergebnis ab DE, Ende 0Dh)
                      ; <- aufgerufen von 00C8h, 05C5h, 12DDh, 3FD1h
                      GETLINE:
06A4  F5                      PUSH    AF
06A5  C5                      PUSH    BC
06A6  E5                      PUSH    HL
06A7  D5                      PUSH    DE
06A8  3A A2 06                LD      A,(GL_MAXLEN)
06AB  32 A3 06                LD      (GL_LEFT),A
                      ;  Ablauf von GETLINE: Zeichen unter dem Cursor merken, Cursor (1Fh)
                      ;  blinken lassen, bis eine Taste kommt (KEYSCAN). Tasten 01h-04h
                      ;  (Cursor) wiederholen sich bei langem Drücken (Zähler 0035h).
                      ;  Druckbare Zeichen werden geschrieben (im Grafikmodus bzw. bei PPI_A_COPY
                      ;  Bit 7 mit Bit 7 = invers), Steuerzeichen über DISPCTRL ausgeführt.
                      ;  CR: logische Zeile ab dem Bildschirm einsammeln (GL_ENTER), 0Bh (BREAK):
                      ;  0Bh, 0Dh zurückgeben. 10h-19h: Funktionstaste (Text aus FKEY_TAB, 7Fh
                      ;  im Text = CR), 1Bh: Tabulator (TABSTOPS).
                      GL_NEWPOS:
06AE  CD 53 0C                CALL    CSR2VRAM
06B1  22 03 00                LD      (0003h),HL
06B4  CD 68 0C                CALL    VRAM_RD
06B7  32 0D 00                LD      (000Dh),A
06BA  32 0E 00                LD      (000Eh),A
06BD  ED 73 2E 00             LD      (002Eh),SP
06C1  2A 03 00                LD      HL,(0003h)
                      GL_BLINK:
06C4  3A 0E 00                LD      A,(000Eh)
06C7  FE 1F                   CP      1Fh
06C9  20 0B                   JR      NZ,GL_CURSORCH
06CB  3A 0D 00                LD      A,(000Dh)
                      GL_BLINKSET:
06CE  32 0E 00                LD      (000Eh),A
06D1  CD 7A 0C                CALL    VRAM_WR
06D4  18 04                   JR      GL_WAITKEY
                      GL_CURSORCH:
06D6  3E 1F                   LD      A,1Fh
06D8  18 F4                   JR      GL_BLINKSET
                      GL_WAITKEY:
06DA  F5                      PUSH    AF
06DB  E5                      PUSH    HL
06DC  01 40 00                LD      BC,0040h
                      GL_WAITLP:
06DF  C5                      PUSH    BC
                      ;  GL_KEYCALL: "CALL KEYSCAN"; RS_TERM (RS-232C) patcht hier fälschlich das
                      ;  Opcode-Byte (06E0h) statt des Operanden.
                      GL_KEYCALL:
06E0  CD 53 0A                CALL    KEYSCAN
06E3  FE 1E                   CP      1Eh
06E5  20 0A                   JR      NZ,GL_KEY
06E7  C1                      POP     BC
06E8  0B                      DEC     BC
06E9  79                      LD      A,C
06EA  B0                      OR      B
06EB  20 F2                   JR      NZ,GL_WAITLP
06ED  E1                      POP     HL
06EE  F1                      POP     AF
06EF  18 D3                   JR      GL_BLINK
06F1  F5              GL_KEY: PUSH    AF
06F2  FE 01                   CP      01h
06F4  38 33                   JR      C,GL_PRESS
06F6  FE 05                   CP      05h
06F8  30 2F                   JR      NC,GL_PRESS
06FA  CB 50                   BIT     2,B
06FC  28 2B                   JR      Z,GL_PRESS
06FE  AF                      XOR     A
06FF  32 06 00                LD      (0006h),A
0702  32 07 00                LD      (0007h),A
0705  3E 78                   LD      A,78h                   ; 'x'
0707  32 77 11                LD      (KEY_STATE3),A
070A  3A 35 00                LD      A,(0035h)
070D  3D                      DEC     A
070E  32 35 00                LD      (0035h),A
0711  28 11                   JR      Z,GL_REPRESET
0713  F1                      POP     AF
0714  CD 50 09                CALL    GETKEY
0717  FE 01                   CP      01h
0719  38 04                   JR      C,GL_REPEAT
071B  FE 05                   CP      05h
071D  38 D2                   JR      C,GL_KEY
                      GL_REPEAT:
071F  CD 5D 08                CALL    GL_RESTCH
0722  18 3E                   JR      GL_CONT
                      GL_REPRESET:
0724  3E 40                   LD      A,40h                   ; '@'
0726  32 35 00                LD      (0035h),A
                      GL_PRESS:
0729  CD 5D 08                CALL    GL_RESTCH
072C  F1                      POP     AF
072D  4F                      LD      C,A
072E  3A 15 00                LD      A,(0015h)
0731  B7                      OR      A
0732  CC BE 0E                CALL    Z,BEEP
0735  79                      LD      A,C
0736  E6 F0                   AND     0F0h
0738  FE 20                   CP      20h                     ; ' '
073A  38 2F                   JR      C,GL_CTRL
073C  79                      LD      A,C
073D  CB 58                   BIT     3,B
073F  20 07                   JR      NZ,GL_GRAPHCHK
0741  21 50 11                LD      HL,PPI_A_COPY
0744  CB 7E                   BIT     7,(HL)
0746  28 0C                   JR      Z,GL_PUTCH
                      GL_GRAPHCHK:
0748  3A 07 00                LD      A,(0007h)
074B  E6 0F                   AND     0Fh
074D  FE 03                   CP      03h
074F  79                      LD      A,C
0750  38 02                   JR      C,GL_PUTCH
0752  F6 80                   OR      80h
                      GL_PUTCH:
0754  4F                      LD      C,A
0755  3A A3 06                LD      A,(GL_LEFT)
0758  3D                      DEC     A
0759  32 A3 06                LD      (GL_LEFT),A
