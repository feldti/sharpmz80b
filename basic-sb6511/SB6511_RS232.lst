0443  0B                      DEC     BC
0444  18 E3                   JR      CKSUM_LP
                      
                      ; ------------------------------------------------------------------------------
                      ;  EDGE – auf steigende Flanke des Bandsignals warten, CY = BREAK
                      ; ------------------------------------------------------------------------------
                      ;  EDGE – auf eine Flanke des Lesesignals (PPI Port B Bit 6) warten;
                      ;  C = BREAK gedrückt.
                      ; <- aufgerufen von 030Fh, 035Ch, 03A4h, 03C1h, 03FBh, 040Dh, 041Eh
0446  DB E1           EDGE:   IN      A,(PPI_B)
0448  2F                      CPL
0449  07                      RLCA
044A  D8                      RET     C
044B  07                      RLCA
044C  30 F8                   JR      NC,EDGE
                      EDGE_LOW:
044E  DB E1                   IN      A,(PPI_B)
0450  2F                      CPL
0451  07                      RLCA
0452  D8                      RET     C
0453  07                      RLCA
0454  38 F8                   JR      C,EDGE_LOW
0456  C9                      RET
                      
                      ; ------------------------------------------------------------------------------
                      ;  CMT_READY – Kassette bereit? Sonst "SET TAPE" und Fach öffnen;
                      ;  beim Schreiben Schreibschutz prüfen ("WRITE PROTECT"), dann PLAY.
                      ; ------------------------------------------------------------------------------
                      ;  Laufwerk: PPI Port A Bit 0 REW, 1 FF, 2 PLAY, 3 STOP (Flanke 0->1 über
                      ;  PPIA_OUT mit PPI_A_COPY), Port C über Bit-Set/Reset: Bit 4 Fach
                      ;  öffnen (CMT_EJECT), Bit 5 wird vor PLAY/REW gepulst (CMT_PREPULSE),
                      ;  Bit 6 Aufnahme. Port B Bit 4: Schreibschutz, Bit 5: keine Kassette.
                      ; <- aufgerufen von 025Dh, 0297h, 02CBh
                      CMT_READY:
0457  CD 71 05                CALL    KEYROW3
045A  DB E1                   IN      A,(PPI_B)
045C  E6 20                   AND     20h
045E  28 18                   JR      Z,CMTR_WPCHK
0460  D5                      PUSH    DE
0461  11 72 06                LD      DE,MSG_SETTAPE
0464  CD B6 05                CALL    MSGX
0467  D1                      POP     DE
0468  CD 8C 04                CALL    CMT_EJECT
                      CMTR_WAIT:
046B  CD 6C 05                CALL    BRKKEY
046E  D8                      RET     C
046F  DB E1                   IN      A,(PPI_B)
0471  E6 20                   AND     20h
0473  20 F6                   JR      NZ,CMTR_WAIT
0475  CD 17 05                CALL    DLY_MID
                      CMTR_WPCHK:
0478  3E 03                   LD      A,03h
047A  A2                      AND     D
047B  28 1E                   JR      Z,CMTR_PLAY
047D  DB E1                   IN      A,(PPI_B)
047F  E6 10                   AND     10h
0481  28 14                   JR      Z,CMTR_REC
0483  D5                      PUSH    DE
0484  11 84 06                LD      DE,MSG_WPROT
0487  CD B6 05                CALL    MSGX
048A  D1                      POP     DE
048B  37                      SCF
                      ; <- aufgerufen von 0468h, 4FD8h
                      CMT_EJECT:
048C  3E 08                   LD      A,08h
048E  D3 E3                   OUT     (PPI_CTL),A
0490  CD 17 05                CALL    DLY_MID
0493  3C                      INC     A
0494  D3 E3                   OUT     (PPI_CTL),A
0496  C9                      RET
                      CMTR_REC:
0497  3E 0C                   LD      A,0Ch
0499  D3 E3                   OUT     (PPI_CTL),A
                      CMTR_PLAY:
049B  7A                      LD      A,D
049C  E6 05                   AND     05h
049E  C4 D2 04                CALL    NZ,CMT_STOPCMD
04A1  CD E1 04                CALL    CMT_PREPULSE
04A4  3A 50 11                LD      A,(PPI_A_COPY)
04A7  CB D7                   SET     2,A
04A9  18 2C                   JR      CMT_SETCMD
04AB  00                      DEFB    00h                     ; ?? |.|
                      ; <- aufgerufen von 04E3h
                      PPC_PULSE:
04AC  D3 E3                   OUT     (PPI_CTL),A
04AE  C3 11 05                JP      DLY_SHORT
                      ; <- aufgerufen von 0208h, 02AAh, 501Dh, 52E4h
                      CMT_REWIND:
04B1  CD CE 04                CALL    CMT_STOP
04B4  CD 11 05                CALL    DLY_SHORT
04B7  CD E9 04                CALL    CMT_REWCMD
04BA  CD 11 05                CALL    DLY_SHORT
                      REW_WAIT:
04BD  01 A6 01                LD      BC,01A6h
                      REW_WAIT_LP:
04C0  DB E1                   IN      A,(PPI_B)
04C2  2F                      CPL
04C3  07                      RLCA
04C4  D8                      RET     C
04C5  07                      RLCA
04C6  30 F5                   JR      NC,REW_WAIT
04C8  0B                      DEC     BC
04C9  78                      LD      A,B
04CA  B1                      OR      C
04CB  20 F3                   JR      NZ,REW_WAIT_LP
04CD  C9                      RET
                      ; <- aufgerufen von 020Bh, 02ADh, 04B1h, 5020h, 50F3h, 50F9h, 524Fh, 5296h (+1 weitere)
                      CMT_STOP:
04CE  3E 0D                   LD      A,0Dh
04D0  D3 E3                   OUT     (PPI_CTL),A
                      ; <- aufgerufen von 049Eh
                      CMT_STOPCMD:
04D2  3A 50 11                LD      A,(PPI_A_COPY)
04D5  CB DF                   SET     3,A
                      CMT_SETCMD:
04D7  CD DD 04                CALL    PPIA_OUT
                      ; <- aufgerufen von 04ECh, 04F2h
                      CMT_IDLE:
04DA  3A 50 11                LD      A,(PPI_A_COPY)
                      ; <- aufgerufen von 04D7h, 4FB9h
                      PPIA_OUT:
04DD  D3 E0                   OUT     (PPI_A),A
04DF  18 30                   JR      DLY_SHORT
                      ; <- aufgerufen von 04A1h, 04EFh
                      CMT_PREPULSE:
04E1  3E 0B                   LD      A,0Bh
04E3  CD AC 04                CALL    PPC_PULSE
04E6  3D                      DEC     A
04E7  18 C3                   JR      PPC_PULSE
                      ; <- aufgerufen von 04B7h, 4FC5h
                      CMT_REWCMD:
04E9  CD 71 05                CALL    KEYROW3
04EC  CD DA 04                CALL    CMT_IDLE
                      ; <- aufgerufen von 4FBCh
                      CMT_FASTCMD:
04EF  CD E1 04                CALL    CMT_PREPULSE
04F2  CD DA 04                CALL    CMT_IDLE
04F5  CB C7                   SET     0,A
04F7  18 DE                   JR      CMT_SETCMD
                      ;  DLY_LONG / DLY_SHORT / DLY_MID – Wartezeiten über DLY_BC (BC Durchläufe
                      ;  zu 256). DLY_A: A Durchläufe; WR0BIT/WR1BIT/DLY_BIT setzen den Wert
                      ;  vorher in den Operanden von DLY_A.
                      ; <- aufgerufen von 026Eh, 027Bh
                      DLY_LONG:
04F9  3E 0E                   LD      A,0Eh
04FB  D3 E3                   OUT     (PPI_CTL),A
04FD  CD 00 05                CALL    DLY_LONG2
                      ; <- aufgerufen von 04FDh
                      DLY_LONG2:
0500  C5                      PUSH    BC
0501  01 2B 0F                LD      BC,0F2Bh
0504  F5              DLY_BC: PUSH    AF
                      DLY_BC_LP:
0505  AF                      XOR     A
                      DLY_BC_IN:
0506  3D                      DEC     A
0507  20 FD                   JR      NZ,DLY_BC_IN
0509  0B                      DEC     BC
050A  78                      LD      A,B
050B  B1                      OR      C
050C  20 F7                   JR      NZ,DLY_BC_LP
050E  F1                      POP     AF
050F  C1                      POP     BC
0510  C9                      RET
                      ; <- aufgerufen von 0210h, 04B4h, 04BAh, 5025h
                      DLY_SHORT:
0511  C5                      PUSH    BC
0512  01 23 01                LD      BC,0123h
0515  18 ED                   JR      DLY_BC
                      ; <- aufgerufen von 0475h, 0490h
                      DLY_MID:
0517  C5                      PUSH    BC
0518  01 96 07                LD      BC,0796h
051B  18 E7                   JR      DLY_BC
                      ; <- aufgerufen von 0302h, 0399h, 03D7h, 03E5h
051D  F5              WR0BIT: PUSH    AF
051E  3E 0F                   LD      A,0Fh
0520  D3 E3                   OUT     (PPI_CTL),A
0522  0A                      LD      A,(BC)
0523  3E 2A                   LD      A,2Ah                   ; '*'
0525  32 5C 05                LD      (DLY_A+1),A
0528  CD 5B 05                CALL    DLY_A
052B  3E 0E                   LD      A,0Eh
052D  D3 E3                   OUT     (PPI_CTL),A
052F  3E 25                   LD      A,25h                   ; '%'
0531  32 5C 05                LD      (DLY_A+1),A
0534  CD 5B 05                CALL    DLY_A
0537  F1                      POP     AF
0538  C9                      RET
                      ; <- aufgerufen von 02F8h, 0392h, 0396h, 03DFh, 03EBh
0539  F5              WR1BIT: PUSH    AF
053A  3E 0F                   LD      A,0Fh
053C  D3 E3                   OUT     (PPI_CTL),A
053E  3E 5A                   LD      A,5Ah                   ; 'Z'
0540  32 5C 05                LD      (DLY_A+1),A
0543  CD 5B 05                CALL    DLY_A
0546  3E 0E                   LD      A,0Eh
0548  D3 E3                   OUT     (PPI_CTL),A
054A  3E 55                   LD      A,55h                   ; 'U'
054C  32 5C 05                LD      (DLY_A+1),A
054F  CD 5B 05                CALL    DLY_A
0552  F1                      POP     AF
0553  C9                      RET
                      ; <- aufgerufen von 0314h, 0361h, 03A9h, 0400h, 0412h
                      DLY_BIT:
0554  7C                      LD      A,H
0555  7D                      LD      A,L
0556  3E 41                   LD      A,41h                   ; 'A'
0558  32 5C 05                LD      (DLY_A+1),A
                      ; <- aufgerufen von 0528h, 0534h, 0543h, 054Fh
055B  3E FF           DLY_A:  LD      A,0FFh
                      DLY_A_LP:
055D  3D                      DEC     A
055E  C2 5D 05                JP      NZ,DLY_A_LP
0561  C9                      RET
                      
                      ; ------------------------------------------------------------------------------
                      ;  BRKCHK – BREAK-Taste abfragen: Z = gedrückt
                      ; ------------------------------------------------------------------------------
                      ; <- aufgerufen von 013Eh, 1D41h, 1EFDh, 55B5h, 55F9h, 6527h, 67BFh, 67DFh
0562  CD 71 05        BRKCHK: CALL    KEYROW3
0565  DB EA                   IN      A,(PIO_BD)
0567  DB EA                   IN      A,(PIO_BD)
0569  E6 80                   AND     80h
056B  C9                      RET
                      ; <- aufgerufen von 02E2h, 046Bh, 0FE0h, 4FDBh
056C  DB EA           BRKKEY: IN      A,(PIO_BD)
056E  2F                      CPL
056F  07                      RLCA
0570  C9                      RET
                      ; <- aufgerufen von 0457h, 04E9h, 0562h, 0FDDh, 4FCAh
                      KEYROW3:
0571  DB E8                   IN      A,(PIO_AD)
0573  E6 E0                   AND     0E0h
0575  F6 13                   OR      13h
0577  D3 E8                   OUT     (PIO_AD),A
0579  C9                      RET
                      ;  IN_START / IN_END – Start- bzw. Endadresse abfragen (Prompt "S"/"E",
                      ;  "-ADR.$"), nach 002Bh bzw. 0033h. IN_HEXADR: Adresse mit Prompt A.
                      ; <- aufgerufen von 0120h, 0188h
                      IN_START:
057A  3E 53                   LD      A,53h                   ; 'S'
057C  CD 8C 05                CALL    IN_HEXADR
057F  22 2B 00                LD      (002Bh),HL
0582  C9                      RET
                      ; <- aufgerufen von 0123h, 018Eh
0583  3E 45           IN_END: LD      A,45h                   ; 'E'
0585  CD 8C 05                CALL    IN_HEXADR
0588  22 33 00                LD      (0033h),HL
058B  C9                      RET
                      ; <- aufgerufen von 00FBh, 024Dh, 057Ch, 0585h
                      IN_HEXADR:
058C  32 99 05                LD      (ASK_ADR+1),A
                      ASKADR_RETRY:
058F  CD 98 05                CALL    ASK_ADR
0592  CD 14 06                CALL    HEX4
0595  38 F8                   JR      C,ASKADR_RETRY
0597  C9                      RET
                      ; <- aufgerufen von 01A8h, 058Fh
                      ASK_ADR:
0598  3E FF                   LD      A,0FFh
059A  11 3F 10                LD      DE,MON_BUF
059D  12                      LD      (DE),A
059E  D5                      PUSH    DE
059F  13                      INC     DE
05A0  21 6B 06                LD      HL,MSG_ADR
05A3  01 07 00                LD      BC,0007h
05A6  ED B0                   LDIR
05A8  D1                      POP     DE
05A9  CD B6 05                CALL    MSGX
05AC  CD C5 05                CALL    GETLINE_MON
05AF  11 46 10                LD      DE,MON_ADRIN
05B2  1A                      LD      A,(DE)
05B3  FE 0D                   CP      0Dh
05B5  C9                      RET
                      
                      ; ------------------------------------------------------------------------------
                      ;  Hex-Ein-/Ausgabe und Meldungsausgabe
                      ; ------------------------------------------------------------------------------
                      ; <- aufgerufen von 00A4h, 0168h, 0228h, 0350h, 0464h, 0487h, 05A9h, 05CFh (+8 weitere)
05B6  CD AB 08        MSGX:   CALL    CRLF_IF
05B9  C3 CD 08                JP      PRTSTR
                      ; <- aufgerufen von 0100h, 012Ah
05BC  CD AB 08        PRTADR: CALL    CRLF_IF
05BF  CD D8 05                CALL    PRTHL
05C2  C3 B9 08                JP      PRTSPC
                      ; <- aufgerufen von 010Dh, 016Bh, 05ACh
                      GETLINE_MON:
05C5  CD A4 06                CALL    GETLINE
05C8  1A                      LD      A,(DE)
05C9  FE 0B                   CP      0Bh
05CB  CA B1 00                JP      Z,MON_WARM
05CE  C9                      RET
                      ; <- aufgerufen von 01EAh, 01F9h, 021Dh, 026Ah
                      MSG_NAME:
05CF  CD B6 05                CALL    MSGX
05D2  11 C1 10                LD      DE,CMT_HNAME
05D5  C3 CD 08                JP      PRTSTR
                      ; <- aufgerufen von 05BFh, 0D38h, 0D42h
05D8  7C              PRTHL:  LD      A,H
05D9  CD DD 05                CALL    PRTHEX
05DC  7D                      LD      A,L
                      ; <- aufgerufen von 0104h, 0133h, 05D9h
05DD  F5              PRTHEX: PUSH    AF
05DE  E6 F0                   AND     0F0h
05E0  0F                      RRCA
05E1  0F                      RRCA
05E2  0F                      RRCA
05E3  0F                      RRCA
05E4  CD F3 05                CALL    NIB2ASC
05E7  CD 16 09                CALL    PRTCHR
05EA  F1                      POP     AF
05EB  E6 0F                   AND     0Fh
05ED  CD F3 05                CALL    NIB2ASC
05F0  C3 16 09                JP      PRTCHR
                      ; <- aufgerufen von 05E4h, 05EDh, 2DF6h
                      NIB2ASC:
05F3  E6 0F                   AND     0Fh
05F5  C6 30                   ADD     A,30h
05F7  FE 3A                   CP      3Ah                     ; ':'
05F9  D8                      RET     C
05FA  C6 07                   ADD     A,07h
05FC  C9                      RET
                      ; <- aufgerufen von 0626h, 0632h
                      ASC2NIB:
05FD  FE 47                   CP      47h                     ; 'G'
05FF  30 11                   JR      NC,A2N_ERR
0601  FE 41                   CP      41h                     ; 'A'
0603  30 0A                   JR      NC,A2N_LETTER
0605  FE 3A                   CP      3Ah                     ; ':'
0607  30 09                   JR      NC,A2N_ERR
0609  FE 30                   CP      30h                     ; '0'
060B  D8                      RET     C
060C  D6 30                   SUB     30h
060E  C9                      RET
                      A2N_LETTER:
060F  D6 37                   SUB     37h
0611  C9                      RET
                      A2N_ERR:
0612  37                      SCF
0613  C9                      RET
                      ;  HEX4 / HEX2 – 4 bzw. 2 Hexziffern ab (DE) nach HL bzw. A; C bei
                      ;  ungültiger Ziffer. ASC2NIB: ein Zeichen. NIB2ASC: umgekehrt.
                      ; <- aufgerufen von 01ADh, 0592h
0614  D5              HEX4:   PUSH    DE
0615  CD 23 06                CALL    HEX2
0618  38 07                   JR      C,HEX4_RET
061A  67                      LD      H,A
061B  CD 23 06                CALL    HEX2
061E  38 01                   JR      C,HEX4_RET
0620  6F                      LD      L,A
                      HEX4_RET:
0621  D1                      POP     DE
0622  C9                      RET
                      ; <- aufgerufen von 0118h, 0615h, 061Bh
0623  C5              HEX2:   PUSH    BC
0624  1A                      LD      A,(DE)
0625  13                      INC     DE
0626  CD FD 05                CALL    ASC2NIB
0629  38 0D                   JR      C,HEX2_RET
062B  07                      RLCA
062C  07                      RLCA
062D  07                      RLCA
062E  07                      RLCA
062F  4F                      LD      C,A
0630  1A                      LD      A,(DE)
0631  13                      INC     DE
0632  CD FD 05                CALL    ASC2NIB
0635  38 01                   JR      C,HEX2_RET
0637  B1                      OR      C
                      HEX2_RET:
0638  C1                      POP     BC
0639  C9                      RET
                      ;  CMPNAME – B Zeichen ab DE und HL vergleichen, bis 0Dh. Z = gleich.
