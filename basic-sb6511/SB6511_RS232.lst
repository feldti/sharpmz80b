029A  38 11                   JR      C,CMT_ABORT
029C  CD F1 03                CALL    RDTMARK
029F  38 0C                   JR      C,CMT_ABORT
02A1  CD 0B 03                CALL    RDBLK
                      CMT_RDDONE:
02A4  38 07                   JR      C,CMT_ABORT
02A6  CB 5A                   BIT     3,D
02A8  28 06                   JR      Z,CMT_EI_RET
02AA  CD B1 04                CALL    CMT_REWIND
                      CMT_ABORT:
02AD  CD CE 04                CALL    CMT_STOP
                      CMT_EI_RET:
02B0  FB                      EI
02B1  C9                      RET
                      ; <- aufgerufen von 01EDh, 5075h, 50EAh, 51D7h
