                      CHK_ROW:
5A6E  B7                      OR      A
5A6F  28 03                   JR      Z,CONS_ERR
5A71  FE 19                   CP      19h
5A73  D8                      RET     C
                      CONS_ERR:
5A74  C3 0D 14                JP      ERR_03
                      ; <- aufgerufen von 5A42h
                      CONS_COLS:
5A77  CD 5D 19                CALL    CHK_CHR_ALT
5A7A  43              D5A7A:  DEFB    43h                     ; Inline-Parameter 'C'
5A7B  92 5A           D5A7B:  DEFW    CONS_REV
5A7D  CD B7 20                CALL    EVAL_BYTE
5A80  7B                      LD      A,E
5A81  E5                      PUSH    HL
5A82  21 38 5A                LD      HL,CONS_NEXT
5A85  E5                      PUSH    HL
