02ED  2A 2B 00                LD      HL,(002Bh)
02F0  7C                      LD      A,H
02F1  CD 8F 03                CALL    WRBYTE
02F4  7D                      LD      A,L
02F5  CD 8F 03                CALL    WRBYTE
02F8  CD 39 05                CALL    WR1BIT
02FB  1D                      DEC     E
02FC  20 04                   JR      NZ,WRBLK_GAP
02FE  AF                      XOR     A
                      BLK_RET:
02FF  E1                      POP     HL
0300  C1                      POP     BC
0301  C9                      RET
                      WRBLK_GAP:
0302  CD 1D 05                CALL    WR0BIT
0305  10 FB                   DJNZ    WRBLK_GAP
0307  E1                      POP     HL
0308  C1                      POP     BC
0309  18 D1                   JR      WRBLK_COPY
                      ;  RDBLK – Block lesen, bei Prüfsummenfehler die zweite Kopie versuchen;
                      ;  beide falsch: "CHECK SUM ERROR", A = FFh, C.
                      ; <- aufgerufen von 02A1h
030B  1E 02           RDBLK:  LD      E,02h
030D  C5                      PUSH    BC
030E  E5                      PUSH    HL
                      RDBLK_SYNC:
030F  CD 46 04                CALL    EDGE
0312  38 EB                   JR      C,BLK_RET
0314  CD 54 05                CALL    DLY_BIT
0317  DB E1                   IN      A,(PPI_B)
0319  E6 40                   AND     40h
031B  28 F2                   JR      Z,RDBLK_SYNC
031D  21 00 00                LD      HL,0000h
0320  22 2B 00                LD      (002Bh),HL
0323  E1                      POP     HL
0324  C1                      POP     BC
0325  C5                      PUSH    BC
0326  E5                      PUSH    HL
                      RDBLK_BYTE:
0327  CD A0 03                CALL    RDBYTE
032A  38 D3                   JR      C,BLK_RET
032C  77                      LD      (HL),A
032D  23                      INC     HL
032E  0B                      DEC     BC
032F  78                      LD      A,B
0330  B1                      OR      C
0331  20 F4                   JR      NZ,RDBLK_BYTE
0333  2A 2B 00                LD      HL,(002Bh)
0336  CD A0 03                CALL    RDBYTE
0339  38 C4                   JR      C,BLK_RET
033B  4F                      LD      C,A
033C  CD A0 03                CALL    RDBYTE
033F  38 BE                   JR      C,BLK_RET
0341  BD                      CP      L
0342  20 06                   JR      NZ,RDBLK_RETRY
0344  79                      LD      A,C
0345  BC                      CP      H
0346  3E 00                   LD      A,00h
0348  28 B5                   JR      Z,BLK_RET
                      RDBLK_RETRY:
034A  1D                      DEC     E
034B  20 C2                   JR      NZ,RDBLK_SYNC
                      CMT_CKERR:
034D  11 92 06                LD      DE,MSG_CKSUM
0350  CD B6 05                CALL    MSGX
0353  3E FF                   LD      A,0FFh
0355  37                      SCF
0356  18 A7                   JR      BLK_RET
                      ; <- aufgerufen von 02D5h
0358  1E 02           VFBLK:  LD      E,02h
                      VFBLK_COPY:
035A  C5                      PUSH    BC
035B  E5                      PUSH    HL
                      VFBLK_SYNC:
035C  CD 46 04                CALL    EDGE
035F  38 9E                   JR      C,BLK_RET
0361  CD 54 05                CALL    DLY_BIT
0364  DB E1                   IN      A,(PPI_B)
0366  E6 40                   AND     40h
0368  28 F2                   JR      Z,VFBLK_SYNC
                      VFBLK_BYTE:
036A  CD A0 03                CALL    RDBYTE
036D  38 90                   JR      C,BLK_RET
036F  BE                      CP      (HL)
0370  20 DB                   JR      NZ,CMT_CKERR
0372  23                      INC     HL
0373  0B                      DEC     BC
0374  78                      LD      A,B
0375  B1                      OR      C
0376  20 F2                   JR      NZ,VFBLK_BYTE
0378  2A 33 00                LD      HL,(0033h)
037B  CD A0 03                CALL    RDBYTE
037E  BC                      CP      H
037F  20 CC                   JR      NZ,CMT_CKERR
0381  CD A0 03                CALL    RDBYTE
0384  BD                      CP      L
0385  20 C6                   JR      NZ,CMT_CKERR
0387  1D                      DEC     E
0388  CA FF 02                JP      Z,BLK_RET
038B  E1                      POP     HL
038C  C1                      POP     BC
038D  18 CB                   JR      VFBLK_COPY
                      ; <- aufgerufen von 02DFh, 02F1h, 02F5h
038F  C5              WRBYTE: PUSH    BC
0390  06 08                   LD      B,08h
0392  CD 39 05                CALL    WR1BIT
                      WRBYTE_BIT:
0395  07                      RLCA
0396  DC 39 05                CALL    C,WR1BIT
0399  D4 1D 05                CALL    NC,WR0BIT
039C  10 F7                   DJNZ    WRBYTE_BIT
039E  C1                      POP     BC
039F  C9                      RET
                      ;  RDBYTE – ein Byte lesen: je Bit Flanke abwarten, nach DLY_BIT den Pegel
                      ;  prüfen (1 = langer Puls), 1-Bits für die Prüfsumme zählen (002Bh).
                      ; <- aufgerufen von 0327h, 0336h, 033Ch, 036Ah, 037Bh, 0381h
03A0  E5              RDBYTE: PUSH    HL
03A1  21 00 08                LD      HL,0800h
                      RDBYTE_BIT:
03A4  CD 46 04                CALL    EDGE
03A7  38 1C                   JR      C,RDBYTE_RET
03A9  CD 54 05                CALL    DLY_BIT
03AC  DB E1                   IN      A,(PPI_B)
03AE  E6 40                   AND     40h
03B0  28 0A                   JR      Z,RDBYTE_SHIFT
03B2  E5                      PUSH    HL
03B3  2A 2B 00                LD      HL,(002Bh)
03B6  23                      INC     HL
03B7  22 2B 00                LD      (002Bh),HL
03BA  E1                      POP     HL
03BB  37                      SCF
                      RDBYTE_SHIFT:
03BC  CB 15                   RL      L
03BE  25                      DEC     H
03BF  20 E3                   JR      NZ,RDBYTE_BIT
03C1  CD 46 04                CALL    EDGE
03C4  7D                      LD      A,L
                      RDBYTE_RET:
03C5  E1                      POP     HL
03C6  C9                      RET
                      ; <- aufgerufen von 0271h
                      WRGAP_TM:
03C7  C5                      PUSH    BC
03C8  E5                      PUSH    HL
03C9  01 F8 2A                LD      BC,2AF8h
03CC  21 14 14                LD      HL,1414h
03CF  CB 4A                   BIT     1,D
03D1  20 04                   JR      NZ,GAP_ZEROS
03D3  01 10 27                LD      BC,2710h
03D6  29                      ADD     HL,HL
                      GAP_ZEROS:
03D7  CD 1D 05                CALL    WR0BIT
03DA  0B                      DEC     BC
03DB  78                      LD      A,B
03DC  B1                      OR      C
03DD  20 F8                   JR      NZ,GAP_ZEROS
                      GAP_ONES:
03DF  CD 39 05                CALL    WR1BIT
03E2  25                      DEC     H
03E3  20 FA                   JR      NZ,GAP_ONES
                      GAP_ZEROS2:
03E5  CD 1D 05                CALL    WR0BIT
                      GAP_ZEROS2N:
03E8  2D                      DEC     L
03E9  20 FA                   JR      NZ,GAP_ZEROS2
03EB  CD 39 05                CALL    WR1BIT
                      POP_HL_BC_RET:
03EE  E1                      POP     HL
03EF  C1                      POP     BC
                      GAP_RET:
03F0  C9                      RET
                      ;  RDTMARK – Bandmarke suchen: 40 (Kopf) bzw. 20 (Daten) Einsen in Folge,
                      ;  dann ebenso viele Nullen.
                      ; <- aufgerufen von 029Ch, 02D0h
                      RDTMARK:
03F1  E5                      PUSH    HL
03F2  2E 14                   LD      L,14h
03F4  CB 5A                   BIT     3,D
03F6  20 02                   JR      NZ,TMARK_ONES
03F8  CB 05                   RLC     L
                      TMARK_ONES:
03FA  65                      LD      H,L
                      TMARK_ONES_LP:
03FB  CD 46 04                CALL    EDGE
03FE  38 21                   JR      C,TMARK_RET
                      TMARK_ONESBIT:
0400  CD 54 05                CALL    DLY_BIT
0403  DB E1                   IN      A,(PPI_B)
0405  E6 40                   AND     40h
0407  28 F1                   JR      Z,TMARK_ONES
0409  25                      DEC     H
040A  20 EF                   JR      NZ,TMARK_ONES_LP
040C  65                      LD      H,L
                      TMARK_ZEROS:
040D  CD 46 04                CALL    EDGE
0410  38 0F                   JR      C,TMARK_RET
0412  CD 54 05                CALL    DLY_BIT
0415  DB E1                   IN      A,(PPI_B)
0417  E6 40                   AND     40h
0419  20 DF                   JR      NZ,TMARK_ONES
041B  25                      DEC     H
041C  20 EF                   JR      NZ,TMARK_ZEROS
041E  CD 46 04                CALL    EDGE
                      TMARK_RET:
0421  E1                      POP     HL
0422  C9                      RET
