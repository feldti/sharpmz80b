0AAC  C8                      RET     Z
0AAD  FE 2A                   CP      2Ah                     ; '*'
0AAF  C8                      RET     Z
0AB0  FE 2D                   CP      2Dh                     ; '-'
0AB2  28 25                   JR      Z,MELDY_DOWN
0AB4  FE 2B                   CP      2Bh                     ; '+'
0AB6  28 29                   JR      Z,MELDY_UP
