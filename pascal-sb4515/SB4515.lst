                      ;  ?PONT / XY2VRAM – VRAM-Adresse der Position HL (L = Spalte, H = Zeile):
                      ;  XY_BASE + (H + 1) * Breite + L; XY_BASE = D000h - Breite (CHR40/CHR80).
                      ; <- aufgerufen von 0659h, 0758h, 0843h, 08EAh, 0CDFh, 0D1Ah, 0D71h
0904  2A D1 10        ?PONT:  LD      HL,(DSPXY)
