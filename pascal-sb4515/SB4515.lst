                      ;  PR_LINENO – Zeilennummer (D19E0) vierstellig mit "." ausgeben; Operand
                      ;  00h/FFh schaltet die Nummern beim Drucken ab (Kommando "#").
                      ; <- aufgerufen von 1642h, 1DB2h
                      PR_LINENO:
18F3  3E 00                   LD      A,00h                   ; Operand wird zur Laufzeit gesetzt
18F5  A7                      AND     A
18F6  28 06                   JR      Z,L18FE
18F8  3A 1E 16                LD      A,(OUT_PRT)
18FB  FE 01                   CP      01h
18FD  C8                      RET     Z
18FE  D5              L18FE:  PUSH    DE
18FF  E5                      PUSH    HL
1900  2A E0 19                LD      HL,(CUR_LINE)
                      
                      ;  PR_DEC4 – HL dezimal vierstellig mit "." (führende Nullen als Leerzeichen);
                      ;  Aufrufer legt HL zweimal auf den Stapel.
                      PR_DEC4:
1903  3E 30                   LD      A,30h
1905  32 3E 19                LD      (SM_LEADZERO+1),A
1908  11 E8 03        L1908:  LD      DE,03E8h                ; 1000
190B  CD 2A 19                CALL    PR_DIGIT
190E  11 64 00                LD      DE,0064h
1911  CD 2A 19                CALL    PR_DIGIT
1914  1E 0A                   LD      E,0Ah
1916  CD 2A 19                CALL    PR_DIGIT
1919  AF                      XOR     A
191A  32 3E 19                LD      (SM_LEADZERO+1),A
191D  1E 01                   LD      E,01h
191F  CD 2A 19                CALL    PR_DIGIT
1922  3E 2E                   LD      A,2Eh
1924  CD 9E 19                CALL    PR_CHAR
1927  E1                      POP     HL
1928  D1                      POP     DE
1929  C9                      RET
                      
                      ;  PR_DIGIT – Eine Dezimalstelle von HL zur Basis DE ausgeben (führende Null
                      ;  als Leerzeichen, solange der Operand von L193D 30h ist).
                      ; <- aufgerufen von 16DAh, 190Bh, 1911h, 1916h, 191Fh
                      PR_DIGIT:
192A  3E 30                   LD      A,30h
192C  A7                      AND     A
192D  ED 52           L192D:  SBC     HL,DE
192F  3C                      INC     A
1930  30 FB                   JR      NC,L192D
1932  3D                      DEC     A
1933  19                      ADD     HL,DE
1934  FE 3A                   CP      3Ah
1936  D2 F9 46                JP      NC,ERR_39
1939  FE 30                   CP      30h
193B  20 09                   JR      NZ,L1946
                      
                      ;  SM_LEADZERO – Operand: 30h = führende Nullen als Leerzeichen ausgeben, 00h
                      ;  = Ziffern ausgeben.
                      SM_LEADZERO:
193D  FE 00                   CP      00h                     ; Operand wird zur Laufzeit gesetzt
193F  20 02                   JR      NZ,L1943
1941  3E 20                   LD      A,20h
