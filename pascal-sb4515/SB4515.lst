0920  CB F8                   SET     7,B
0922  ED 41                   OUT     (C),B
0924  7E                      LD      A,(HL)
                      VRAM_OFF:
0925  CB B8                   RES     7,B
0927  ED 41                   OUT     (C),B
0929  C1                      POP     BC
092A  C9                      RET
                      ; <- aufgerufen von 0847h, 085Bh
