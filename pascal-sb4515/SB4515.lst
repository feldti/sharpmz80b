                      ; ------------------------------------------------------------------------------
                      ;  Kassetten-Grundroutinen WRINF/WRDAT/RDINF/RDDAT/VERFY
                      ; ------------------------------------------------------------------------------
                      ;  Kassettenformat wie beim SB-1510 (gleicher Code): Bit 1 = langer Puls,
                      ;  Bit 0 = kurzer Puls, Byte = Startbit 1 + 8 Bits (höchstes zuerst),
                      ;  Prüfsumme = Anzahl der 1-Bits, jeder Block zweimal. Bandmarke: Kopf
                      ;  10000 Nullen, 40 Einsen, 40 Nullen, 1; Daten 11000 Nullen, 20 Einsen,
                      ;  20 Nullen, 1. Die Prüfsumme steht hier in den Operanden von WR_CKSUM
                      ;  und VF_CKSUM statt in Variablen.
                      ;  WRINF/WRDAT/RDINF/RDDAT/VERFY: D = Art (01h/02h/04h/08h), Kopf 128
                      ;  Bytes ab IBUFE, Daten nach SIZE/DTADR (GET_SIZEADR). C bei Fehler oder
                      ;  BREAK.
                      ; <- aufgerufen von 019Dh
021D  E7              WRINF:  RST     20h
021E  EF                      RST     28h
021F  16 01                   LD      D,01h
0221  21 80 11                LD      HL,IBUFE
0224  01 80 00                LD      BC,0080h
                      CMT_WRITE:
0227  CD E2 03                CALL    CKSUM
022A  CD 16 04                CALL    CMT_READY
022D  38 4B                   JR      C,CMT_STOPRET
022F  CB 42                   BIT     0,D
0231  28 0B                   JR      Z,CMT_WRBLK
0233  D5                      PUSH    DE
0234  11 E9 05                LD      DE,WRTMES
0237  CD A4 06                CALL    MSG_NAME
023A  D1                      POP     DE
023B  CD C2 04                CALL    TSPE
                      CMT_WRBLK:
023E  CD 86 03                CALL    WRGAP_TM
0241  CD 9B 02                CALL    WRBLK
0244  38 34                   JR      C,CMT_STOPRET
0246  CB 4A                   BIT     1,D
0248  C4 C2 04                CALL    NZ,TSPE
024B  20 2D                   JR      NZ,CMT_STOPRET
024D  C9                      RET
                      ; <- aufgerufen von 01A0h
024E  E7              WRDAT:  RST     20h
024F  EF                      RST     28h
0250  16 02                   LD      D,02h
0252  CD 57 02                CALL    GET_SIZEADR
0255  18 D0                   JR      CMT_WRITE
                      ; <- aufgerufen von 0252h, 0281h, 028Ah
                      GET_SIZEADR:
0257  ED 4B 92 11             LD      BC,(IBU18)
025B  2A 94 11                LD      HL,(DTADR)
025E  C9                      RET
                      ; <- aufgerufen von 01AFh
025F  E7              RDINF:  RST     20h
0260  EF                      RST     28h
0261  16 04                   LD      D,04h
0263  21 80 11                LD      HL,IBUFE
0266  01 80 00                LD      BC,0080h
                      CMT_READ:
0269  CD 16 04                CALL    CMT_READY
026C  D4 59 10                CALL    NC,CMT_SEEK
026F  D4 CC 02                CALL    NC,RDBLK
                      CMT_RDDONE:
0272  38 06                   JR      C,CMT_STOPRET
0274  CB 5A                   BIT     3,D
0276  C8                      RET     Z
0277  CD 6A 04                CALL    SERSP
                      CMT_STOPRET:
027A  C3 53 10                JP      CMT_STOPAF
                      ; <- aufgerufen von 01C9h
027D  E7              RDDAT:  RST     20h
027E  EF                      RST     28h
027F  16 08                   LD      D,08h
0281  CD 57 02                CALL    GET_SIZEADR
0284  18 E3                   JR      CMT_READ
                      ; <- aufgerufen von 01EFh
0286  E7              VERFY:  RST     20h
0287  EF                      RST     28h
0288  16 08                   LD      D,08h
028A  CD 57 02                CALL    GET_SIZEADR
028D  CD E2 03                CALL    CKSUM
0290  CD 16 04                CALL    CMT_READY
0293  D4 59 10                CALL    NC,CMT_SEEK
0296  D4 19 03                CALL    NC,VFBLK
0299  18 D7                   JR      CMT_RDDONE
                      ; <- aufgerufen von 0241h
029B  1E 02           WRBLK:  LD      E,02h
                      WRBLK_COPY:
029D  C5                      PUSH    BC
029E  E5                      PUSH    HL
                      WRBLK_BYTE:
029F  7E                      LD      A,(HL)
02A0  CD 4E 03                CALL    WRBYTE
02A3  CD 31 05                CALL    BRK
02A6  38 18                   JR      C,BLK_RET
02A8  23                      INC     HL
02A9  0B                      DEC     BC
02AA  78                      LD      A,B
02AB  B1                      OR      C
02AC  20 F1                   JR      NZ,WRBLK_BYTE
                      WR_CKSUM:
02AE  21 00 00                LD      HL,0000h
02B1  7C                      LD      A,H
02B2  CD 4E 03                CALL    WRBYTE
02B5  7D                      LD      A,L
02B6  CD 4E 03                CALL    WRBYTE
02B9  CD FE 04                CALL    WR1BIT
02BC  1D                      DEC     E
02BD  20 04                   JR      NZ,WRBLK_GAP
02BF  AF                      XOR     A
                      BLK_RET:
02C0  E1                      POP     HL
02C1  C1                      POP     BC
02C2  C9                      RET
                      WRBLK_GAP:
02C3  CD E2 04                CALL    WR0BIT
02C6  10 FB                   DJNZ    WRBLK_GAP
02C8  E1                      POP     HL
02C9  C1                      POP     BC
02CA  18 D1                   JR      WRBLK_COPY
                      ;  RDBLK – Block lesen, bei Prüfsummenfehler die zweite Kopie versuchen;
                      ;  beide falsch: "Check sum error", A = FFh, C.
                      ; <- aufgerufen von 026Fh
02CC  1E 02           RDBLK:  LD      E,02h
02CE  C5                      PUSH    BC
02CF  E5                      PUSH    HL
                      RDBLK_SYNC:
02D0  CD 05 04                CALL    EDGE
02D3  38 EB                   JR      C,BLK_RET
