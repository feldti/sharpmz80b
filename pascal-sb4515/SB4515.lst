02EB  38 D3                   JR      C,BLK_RET
02ED  77                      LD      (HL),A
02EE  23                      INC     HL
02EF  0B                      DEC     BC
02F0  78                      LD      A,B
02F1  B1                      OR      C
02F2  20 F4                   JR      NZ,RDBLK_BYTE
02F4  2A AF 02                LD      HL,(WR_CKSUM+1)
02F7  CD 5F 03                CALL    RDBYTE
02FA  38 C4                   JR      C,BLK_RET
02FC  4F                      LD      C,A
02FD  CD 5F 03                CALL    RDBYTE
0300  38 BE                   JR      C,BLK_RET
0302  BD                      CP      L
0303  20 06                   JR      NZ,RDBLK_RETRY
0305  79                      LD      A,C
0306  BC                      CP      H
0307  3E 00                   LD      A,00h
0309  28 B5                   JR      Z,BLK_RET
                      RDBLK_RETRY:
030B  1D                      DEC     E
030C  20 C2                   JR      NZ,RDBLK_SYNC
                      CMT_CKERR:
030E  11 00 06                LD      DE,CKSMES
0311  CD AC 06                CALL    NLMSG
0314  3E FF                   LD      A,0FFh
0316  37                      SCF
