                      ; <- aufgerufen von 0296h
0319  1E 02           VFBLK:  LD      E,02h
                      VFBLK_COPY:
031B  C5                      PUSH    BC
031C  E5                      PUSH    HL
                      VFBLK_SYNC:
031D  CD 05 04                CALL    EDGE
0320  38 9E                   JR      C,BLK_RET
0322  CD 19 05                CALL    DLY_BIT
0325  DB E1                   IN      A,(PPI_B)
0327  E6 40                   AND     40h
0329  28 F2                   JR      Z,VFBLK_SYNC
                      VFBLK_BYTE:
032B  CD 5F 03                CALL    RDBYTE
032E  38 90                   JR      C,BLK_RET
0330  BE                      CP      (HL)
0331  20 DB                   JR      NZ,CMT_CKERR
0333  23                      INC     HL
0334  0B                      DEC     BC
0335  78                      LD      A,B
0336  B1                      OR      C
0337  20 F2                   JR      NZ,VFBLK_BYTE
                      VF_CKSUM:
0339  21 00 00                LD      HL,0000h
033C  CD 5F 03                CALL    RDBYTE
033F  BC                      CP      H
0340  20 CC                   JR      NZ,CMT_CKERR
0342  CD 5F 03                CALL    RDBYTE
0345  BD                      CP      L
0346  20 C6                   JR      NZ,CMT_CKERR
0348  1D                      DEC     E
0349  E1                      POP     HL
034A  C1                      POP     BC
034B  C8                      RET     Z
034C  18 CD                   JR      VFBLK_COPY
                      ; <- aufgerufen von 02A0h, 02B2h, 02B6h
034E  C5              WRBYTE: PUSH    BC
034F  06 08                   LD      B,08h
0351  CD FE 04                CALL    WR1BIT
                      WRBYTE_BIT:
0354  07                      RLCA
0355  DC FE 04                CALL    C,WR1BIT
0358  D4 E2 04                CALL    NC,WR0BIT
035B  10 F7                   DJNZ    WRBYTE_BIT
035D  C1                      POP     BC
035E  C9                      RET
                      ;  RDBYTE – ein Byte lesen: je Bit Flanke abwarten, nach DLY_BIT den Pegel
                      ;  prüfen (1 = langer Puls), 1-Bits für die Prüfsumme zählen.
                      ; <- aufgerufen von 02E8h, 02F7h, 02FDh, 032Bh, 033Ch, 0342h
035F  E5              RDBYTE: PUSH    HL
0360  21 00 08                LD      HL,0800h
                      RDBYTE_BIT:
0363  CD 05 04                CALL    EDGE
0366  38 1C                   JR      C,RDBYTE_RET
0368  CD 19 05                CALL    DLY_BIT
036B  DB E1                   IN      A,(PPI_B)
036D  E6 40                   AND     40h
