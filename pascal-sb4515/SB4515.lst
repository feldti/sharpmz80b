                      ;  GETL_PATCH – GETL im Monitor umleiten: Einsprung auf ??TOL und JP in
                      ;  GETL_DONE, damit Zeilen ab Cursorposition gelesen werden (vermutlich für
                      ;  den Editor).
                      ; <- aufgerufen von 1350h, 1FBDh
                      GETL_PATCH:
1A2D  E5                      PUSH    HL
1A2E  21 C1 08                LD      HL,??TOL
1A31  22 7F 0C                LD      (GETL_ENTER+1),HL
1A34  21 B1 0C                LD      HL,GETL_DONE
1A37  36 C3                   LD      (HL),0C3h
1A39  E1                      POP     HL
1A3A  C9                      RET
1A3B  E1              L1A3B:  POP     HL
1A3C  23                      INC     HL
1A3D  23                      INC     HL
1A3E  23                      INC     HL
1A3F  E5                      PUSH    HL
1A40  2A D1 10                LD      HL,(DSPXY)
1A43  E5                      PUSH    HL
1A44  CD C1 08                CALL    ??TOL
1A47  CD E8 08                CALL    LLINE_LEN
1A4A  E3                      EX      (SP),HL
1A4B  22 D1 10                LD      (DSPXY),HL
1A4E  E1                      POP     HL
1A4F  C9                      RET
                      
