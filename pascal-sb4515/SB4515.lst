1959  06 2D                   LD      B,2Dh
195B  0D                      DEC     C
195C  11 0A 00        L195C:  LD      DE,000Ah
195F  D5                      PUSH    DE
1960  C5                      PUSH    BC
1961  42                      LD      B,D
1962  4B                      LD      C,E
