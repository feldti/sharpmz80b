1990  C3 86 19                JP      L1986
                      
                      ;  PR_NEWLINE – Zeilenende ausgeben: 0Dh auf den Bildschirm, 0Ah auf den
                      ;  Drucker.
                      PR_NEWLINE:
1993  3A 1E 16                LD      A,(OUT_PRT)
1996  B7                      OR      A
1997  20 03                   JR      NZ,L199C
1999  3E 0D                   LD      A,0Dh
199B  01                      DEFB    01h                     ; Trick: verschluckt den folgenden Befehl
199C  3E 0A           L199C:  LD      A,0Ah
                      
                      ;  PR_CHAR – Zeichen A ausgeben: OUT_PRT = 0 Bildschirm (PRNT), sonst Drucker
                      ;  (PRT_OUT).
                      ; <- aufgerufen von 1924h, 197Bh, 1982h, 198Dh, 19C2h, 1A0Ah, 1DA4h
                      PR_CHAR:
199E  08                      EX      AF,AF'
199F  3A 1E 16                LD      A,(OUT_PRT)
19A2  B7                      OR      A
19A3  20 04                   JR      NZ,L19A9
19A5  08                      EX      AF,AF'
19A6  C3 3C 06                JP      PRNT
19A9  08              L19A9:  EX      AF,AF'
19AA  C3 DF 33                JP      PRT_OUT
                      
                      ;  CHK_BREAK – BREAK gedrückt -> "*Break" und PAS_READY.
                      ; <- aufgerufen von 1796h
                      CHK_BREAK:
19AD  CD 27 05                CALL    BRKEY
19B0  C0                      RET     NZ
                      
                      ;  BREAK_STOP – "*Break" ausgeben, zurück nach PAS_READY.
                      BREAK_STOP:
19B1  11 F2 15                LD      DE,MSG_BREAK
19B4  CD C7 1F                CALL    PR_MSG_NL
19B7  C3 34 13        L19B7:  JP      PAS_READY
                      
                      ;  RUN_END – Programmende: offene Datei schließen (RUN_CLOSE), PAS_READY.
                      RUN_END:
19BA  CD F7 29                CALL    RUN_CLOSE
19BD  18 F8                   JR      L19B7
19BF  2A DC 19                LD      HL,(INBUF)
19C2  CD 9E 19                CALL    PR_CHAR
                      
                      ;  GET_LINE – Zeile nach (HL) lesen (GETL); BREAK -> BREAK_STOP. DE zeigt auf
                      ;  die Zeile.
