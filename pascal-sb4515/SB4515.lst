0E28  E6 E0                   AND     0E0h
0E2A  F6 12                   OR      12h
0E2C  D3 E8                   OUT     (PIO_AD),A
0E2E  3E 97                   LD      A,97h
0E30  D3 EB                   OUT     (PIO_BC),A
0E32  AF                      XOR     A
0E33  D3 EB                   OUT     (PIO_BC),A
                      POP_AF_RET:
