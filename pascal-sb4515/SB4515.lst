                      ; ------------------------------------------------------------------------------
                      ;  CHANGE/?SWAP – Groß-/Kleinschreibung tauschen: vertauscht die je 7
                      ;  Befehlsbytes bei KEY_CASE1 und KEY_CASE2 (ADD A,20h/CP 5Bh/RET C/
                      ;  SUB 3Ah gegen ADD A,40h/CP 7Bh/RET C/SUB 5Ah) in KEYSCAN
                      ; ------------------------------------------------------------------------------
0DDD  EF              CHANGE: RST     28h
0DDE  21 61 0F                LD      HL,KEY_CASE1
0DE1  11 73 0F                LD      DE,KEY_CASE2
0DE4  06 07                   LD      B,07h
0DE6  4E              ?SWAP:  LD      C,(HL)
0DE7  1A                      LD      A,(DE)
0DE8  77                      LD      (HL),A
0DE9  79                      LD      A,C
0DEA  12                      LD      (DE),A
0DEB  23                      INC     HL
0DEC  13                      INC     DE
0DED  10 F7                   DJNZ    ?SWAP
0DEF  AF                      XOR     A
0DF0  C9                      RET
                      
                      ; ------------------------------------------------------------------------------
                      ;  PUSHR/PUSHR2 – Register sichern (Ziel von RST 20h)
                      ; ------------------------------------------------------------------------------
                      ;  PUSHR2: wie PUSHR, aber ohne DE.
0DF1  DD E3           PUSHR:  EX      (SP),IX
0DF3  E5                      PUSH    HL
0DF4  C5                      PUSH    BC
0DF5  D5                      PUSH    DE
0DF6  E5                      PUSH    HL
0DF7  21 08 0E                LD      HL,PUSHR_POP
0DFA  E3                      EX      (SP),HL
0DFB  DD E9                   JP      (IX)
0DFD  DD E3           PUSHR2: EX      (SP),IX
0DFF  E5                      PUSH    HL
0E00  C5                      PUSH    BC
0E01  E5                      PUSH    HL
0E02  21 09 0E                LD      HL,PUSHR_POP2
0E05  E3                      EX      (SP),HL
0E06  DD E9                   JP      (IX)
                      PUSHR_POP:
0E08  D1                      POP     DE
                      PUSHR_POP2:
0E09  C1                      POP     BC
0E0A  E1                      POP     HL
0E0B  DD E1                   POP     IX
0E0D  C9                      RET
                      
                      ; ------------------------------------------------------------------------------
                      ;  DI_ – Interrupts sperren und Restroutine aufrufen (Ziel von RST 28h)
                      ; ------------------------------------------------------------------------------
0E0E  F5              DI_:    PUSH    AF
0E0F  ED 57                   LD      A,I                     ; IFF2 -> Paritätsflag (PE = Interrupts waren frei)
0E11  F3                      DI
0E12  E2 35 0E                JP      PO,POP_AF_RET
0E15  F1                      POP     AF
0E16  E3                      EX      (SP),HL
0E17  22 1C 0E                LD      (DI_CALL+1),HL            ; Rücksprungadresse = Fortsetzung der Routine
0E1A  E1                      POP     HL
                      DI_CALL:
0E1B  CD 00 00                CALL    RESET                   ; Rest der aufrufenden Routine ausführen
0E1E  FB                      EI                              ; danach Interrupts wieder frei
                      
