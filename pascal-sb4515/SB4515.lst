                      ; <- aufgerufen von 3D55h, 43FAh, 45CAh
                      GET_IDENT:
3CA5  CD FE 3C                CALL    SYN_GETTOK
3CA8  1B                      DEC     DE
3CA9  2A DE 19                LD      HL,(WORKBUF)
3CAC  E5                      PUSH    HL
3CAD  01 21 00                LD      BC,0021h
3CB0  C5                      PUSH    BC
3CB1  EB                      EX      DE,HL
3CB2  CD 23 1F                CALL    IS_LETTER
3CB5  DA 93 46                JP      C,ERR_05
3CB8  ED A0           L3CB8:  LDI
3CBA  E2 96 46                JP      PO,ERR_06
3CBD  7E                      LD      A,(HL)
3CBE  CD 23 1F                CALL    IS_LETTER
3CC1  DC 1C 1F                CALL    C,IS_DIGIT
3CC4  30 F2                   JR      NC,L3CB8
3CC6  1B                      DEC     DE
3CC7  1A                      LD      A,(DE)
3CC8  F6 80                   OR      80h
3CCA  12                      LD      (DE),A
3CCB  C5                      PUSH    BC
3CCC  23                      INC     HL
3CCD  E5                      PUSH    HL
3CCE  2A 75 46                LD      HL,(SYM_LIST1)
3CD1  E3                      EX      (SP),HL
3CD2  22 75 46                LD      (SYM_LIST1),HL
3CD5  C1                      POP     BC
3CD6  71                      LD      (HL),C
3CD7  23                      INC     HL
3CD8  70                      LD      (HL),B
3CD9  23                      INC     HL
3CDA  23                      INC     HL
3CDB  C1                      POP     BC
3CDC  EB                      EX      DE,HL
3CDD  E1                      POP     HL
3CDE  A7                      AND     A
3CDF  ED 42                   SBC     HL,BC
3CE1  44                      LD      B,H
3CE2  4D                      LD      C,L
3CE3  E1                      POP     HL
3CE4  C9                      RET
                      
                      ;  SET_LINK – Text-/Kommentartoken: Verweis hinter das schließende Zeichen in
                      ;  die beiden Operandenbytes eintragen.
                      ; <- aufgerufen von 1F16h, 3BF2h, 3CFBh
                      SET_LINK:
3CE5  D5                      PUSH    DE
3CE6  13                      INC     DE
3CE7  13                      INC     DE
3CE8  1A                      LD      A,(DE)
3CE9  FE 7B                   CP      7Bh
3CEB  20 02                   JR      NZ,L3CEF
3CED  3E 7D                   LD      A,7Dh
3CEF  13              L3CEF:  INC     DE
3CF0  EB                      EX      DE,HL
3CF1  BE              L3CF1:  CP      (HL)
3CF2  23                      INC     HL
3CF3  20 FC                   JR      NZ,L3CF1
3CF5  D1                      POP     DE
3CF6  EB                      EX      DE,HL
3CF7  73                      LD      (HL),E
3CF8  23                      INC     HL
3CF9  72                      LD      (HL),D
3CFA  C9                      RET
                      
                      ;  SYN_SKIPCMT – Kommentar überspringen (SET_LINK), weiter mit SYN_GETTOK.
                      ; <- aufgerufen von 2DCFh, 3696h, 3745h, 425Bh
                      SYN_SKIPCMT:
3CFB  CD E5 3C                CALL    SET_LINK
                      
                      ;  SYN_GETTOK – Nächstes Zeichen/Token ab DE nach A (Prüflauf). Kommentare
                      ;  werden übersprungen, bei 0Dh wird LINE_NO erhöht und die Einrückung
                      ;  übergangen; Textende -> ERR_01.
                      ; <- aufgerufen von 2DD4h, 2DE4h, 3683h, 3719h, 3733h, 373Fh, 3BB0h, 3C6Fh ... (63)
                      SYN_GETTOK:
3CFE  1A                      LD      A,(DE)
3CFF  13                      INC     DE
3D00  FE DE                   CP      0DEh
3D02  28 F7                   JR      Z,SYN_SKIPCMT
3D04  FE 0D                   CP      0Dh
3D06  C0                      RET     NZ
3D07  2A D6 19                LD      HL,(LINE_NO)
3D0A  23                      INC     HL
3D0B  22 D6 19                LD      (LINE_NO),HL
3D0E  13                      INC     DE
3D0F  2A 47 61                LD      HL,(TXT_END)
3D12  CD 50 1F                CALL    CP_HL_DE
3D15  DA 87 46                JP      C,ERR_01
3D18  18 E4                   JR      SYN_GETTOK
                      
                      ;  SYN_DECLS – Deklarationsteil: VAR-Abschnitt (SYN_VAR), dann Adressen der
                      ;  Variablen festlegen (Größen aufsummieren).
                      ; <- aufgerufen von 3BABh, 407Fh
                      SYN_DECLS:
3D1A  CD FE 3C                CALL    SYN_GETTOK
3D1D  FE 62                   CP      62h
3D1F  CC D9 3D                CALL    Z,SYN_VAR
3D22  21 00 00                LD      HL,0000h
                      
                      ;  SM_SYMTAB_IY – Operand: Zeiger auf den Anfang der aktuellen Symboltabelle
                      ;  (RT_AREA0 bzw. RT_SP).
                      SM_SYMTAB_IY:
3D25  FD 2A 00 00             LD      IY,(0000h)              ; Operand wird zur Laufzeit gesetzt
3D29  FD 7E 00        L3D29:  LD      A,(IY+0)
3D2C  B7                      OR      A
3D2D  C8                      RET     Z
3D2E  FD CB 00 7E     L3D2E:  BIT     7,(IY+0)
3D32  FD 23                   INC     IY
3D34  28 F8                   JR      Z,L3D2E
3D36  FD 23                   INC     IY
3D38  FD 23                   INC     IY
3D3A  FD 23                   INC     IY
3D3C  FD 4E 00                LD      C,(IY+0)
3D3F  FD 46 01                LD      B,(IY+1)
3D42  F6 FF                   OR      0FFh
3D44  ED 42                   SBC     HL,BC
3D46  FD 75 00                LD      (IY+0),L
3D49  FD 23                   INC     IY
3D4B  FD 74 00                LD      (IY+0),H
3D4E  FD 23                   INC     IY
3D50  18 D7                   JR      L3D29
                      
                      ;  DECLARE3 – DE um 3 weiter, dann DECLARE.
                      ; <- aufgerufen von 3C2Ah, 3C59h
                      DECLARE3:
3D52  13                      INC     DE
3D53  13                      INC     DE
3D54  13                      INC     DE
                      
                      ;  DECLARE – Bezeichner lesen und in die Symboltabelle (Zeiger bei L3D59)
                      ;  eintragen; schon vorhanden -> ERR_02. Platz über die Routine bei L3D78
                      ;  schaffen.
                      ; <- aufgerufen von 3E62h, 400Dh
                      DECLARE:
3D55  CD A5 3C                CALL    GET_IDENT
3D58  D5                      PUSH    DE
                      
                      ;  SM_SYMTAB – Operand: Zeiger auf den Anfang der aktuellen Symboltabelle.
                      SM_SYMTAB:
3D59  2A 00 00                LD      HL,(0000h)              ; Operand wird zur Laufzeit gesetzt
3D5C  C5                      PUSH    BC
3D5D  CD 7F 3D                CALL    SYM_FIND
3D60  D2 8A 46                JP      NC,ERR_02
3D63  E5                      PUSH    HL
3D64  CD BF 3D                CALL    SYM_MAKEROOM
3D67  E1                      POP     HL
3D68  ED 5B DE 19             LD      DE,(WORKBUF)
3D6C  C1                      POP     BC
3D6D  C5                      PUSH    BC
3D6E  EB                      EX      DE,HL
3D6F  ED B0                   LDIR
3D71  EB                      EX      DE,HL
3D72  C1                      POP     BC
3D73  E5                      PUSH    HL
3D74  3E 05                   LD      A,05h
3D76  81                      ADD     A,C
3D77  4F                      LD      C,A
                      
                      ;  SM_SYMGROW – Operand: SYM_GROW1/2/3 je nach Tabelle.
                      SM_SYMGROW:
3D78  CD 00 00                CALL    0000h                   ; Operand wird zur Laufzeit gesetzt
3D7B  EB                      EX      DE,HL
3D7C  E1                      POP     HL
3D7D  D1                      POP     DE
3D7E  C9                      RET
                      
                      ;  SYM_FIND – Namen aus WORKBUF in der Symboltabelle ab HL suchen. NC =
                      ;  gefunden (HL zeigt hinter den Namen), C = nicht gefunden.
                      ; <- aufgerufen von 3C61h, 3D5Dh, 4401h, 45BCh, 45D1h, 45DBh
                      SYM_FIND:
3D7F  ED 5B DE 19             LD      DE,(WORKBUF)
3D83  7E                      LD      A,(HL)
3D84  D6 01                   SUB     01h
3D86  D8                      RET     C
3D87  1A              L3D87:  LD      A,(DE)
3D88  BE                      CP      (HL)
3D89  20 07                   JR      NZ,L3D92
3D8B  13                      INC     DE
3D8C  23                      INC     HL
3D8D  17                      RLA
3D8E  30 F7                   JR      NC,L3D87
3D90  A7                      AND     A
3D91  C9                      RET
3D92  CB 7E           L3D92:  BIT     7,(HL)
3D94  23                      INC     HL
3D95  28 FB                   JR      Z,L3D92
3D97  3E 05                   LD      A,05h
3D99  CD 3C 1F                CALL    ADD_HL_A
3D9C  18 E1                   JR      SYM_FIND
                      
                      ;  SYM_GROW1 – RT_AREA1, RT_SP und RT_AREA3 um BC verschieben.
                      SYM_GROW1:
3D9E  2A 7B 46                LD      HL,(RT_AREA1)
3DA1  09                      ADD     HL,BC
3DA2  22 7B 46                LD      (RT_AREA1),HL
                      
                      ;  SYM_GROW2 – RT_SP und RT_AREA3 um BC verschieben.
                      SYM_GROW2:
