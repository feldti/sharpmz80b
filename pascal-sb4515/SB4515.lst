                      RDBYTE_SHIFT:
037B  CB 15                   RL      L
037D  25                      DEC     H
037E  20 E3                   JR      NZ,RDBYTE_BIT
0380  CD 05 04                CALL    EDGE
0383  7D                      LD      A,L
                      RDBYTE_RET:
0384  E1                      POP     HL
0385  C9                      RET
                      ; <- aufgerufen von 023Eh
