0E83  CD 65 0E                CALL    KEY_ROW
0E86  5F                      LD      E,A
0E87  2F                      CPL
0E88  A6                      AND     (HL)
0E89  73              ..KEY:  LD      (HL),E
0E8A  2B                      DEC     HL
0E8B  5F                      LD      E,A
0E8C  B7                      OR      A
0E8D  28 04                   JR      Z,KEY_ROWNEXT
0E8F  ED 53 13 00             LD      (KEYPOS),DE
                      KEY_ROWNEXT:
0E93  7A                      LD      A,D
0E94  E6 0F                   AND     0Fh
0E96  20 EA                   JR      NZ,KEY_ROWLP
0E98  ED 5B 13 00             LD      DE,(KEYPOS)
0E9C  7B                      LD      A,E
0E9D  B7                      OR      A
