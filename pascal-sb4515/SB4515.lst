093E  EF                      RST     28h
093F  D3 E8                   OUT     (PIO_AD),A
0941  ED B0                   LDIR
                      VRAM_OFFA:
0943  E6 3F                   AND     3Fh
0945  D3 E8                   OUT     (PIO_AD),A
0947  C9                      RET
                      ; <- aufgerufen von 07ADh, 0983h
